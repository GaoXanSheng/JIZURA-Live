{
  "name": "jizura-live-frontend",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/perf/run.ps1",
    "bench:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/perf/run.ps1 -SweepSec 60 -RtSec 15 -Reps 1 -Warmup 0",
    "bench:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/perf/run.ps1 -Reps 3 -Thumbs",
    "bench:lowend": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/perf/run.ps1 -SweepSec 60 -RtSec 15 -Reps 1 -Warmup 0 -Throttle 4"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.2",
    "vue-tsc": "^2.2.0",
    "ws": "^8.22.0"
  }
}
