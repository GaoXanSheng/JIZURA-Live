<Project Sdk="Microsoft.NET.Sdk">

    <!-- P0 验证程序：把 src/Render/Gpu 的呈现骨架跑起来——子窗口 + D3D11 flip 交换链 +
         垂直同步直呈一个 D2D 渐变与一行 DirectWrite 文字，并打印实测帧率。
         独立小工程（tools/ 已被主工程排除编译），用 ProjectReference 复用主程序集里的 Render Core。 -->
    <PropertyGroup>
        <!-- 控制台子系统：窗口照开，同时把实测帧率打到 stdout（无人值守验证用） -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AssemblyName>RenderProbe</AssemblyName>
        <RootNamespace>RenderProbe</RootNamespace>
        <ApplicationManifest></ApplicationManifest>
        <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\JizuraLive.csproj" />
    </ItemGroup>

</Project>
