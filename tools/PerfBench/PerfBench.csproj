<Project Sdk="Microsoft.NET.Sdk">

    <!-- M7 基准探针（短跑）：量出「出帧间隔 p50/p95/p99 + GC + 工作集 + 显存采样」，
         把测量口径写死在报告头，并用固定一行 [WARP] 标记软件光栅（不参加硬件判定）。
         独立小工程（tools/ 已被主工程排除编译，不会污染主程序集），用 ProjectReference 复用
         Render Core 的 PresentHost/D2DHost/Immediate2D——不复制第二套呈现骨架。
         控制台子系统：窗口照开，报告打到 stdout，退出码即结论（无人值守可读）。 -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AssemblyName>PerfBench</AssemblyName>
        <RootNamespace>PerfBench</RootNamespace>
        <ApplicationManifest></ApplicationManifest>
        <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\JizuraLive.csproj" />
    </ItemGroup>

</Project>
