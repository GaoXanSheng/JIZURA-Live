<Project Sdk="Microsoft.NET.Sdk">

    <!-- Spout 实测探针。两个模式：
           Q（默认，M1 路线图第 6 步「SpoutIn 可终止性」）：无人发送时 native ReceiveTexturePtr
             是否立即返回、起接收→Pump→Dispose 能否干净退出、PumpFrame 的真实耗时量级。
           S（启动参数传 "sender"，M3 路线图 §5 第 1 条「发送端原生行为」）：用生产类 SpoutOut + SpoutIn
             同进程往返，测无人接收时发送是否阻塞、像素/尺寸往返与换色延迟、两个方向的 Dispose、
             同名源重启（同尺寸/变尺寸）重连、慢消费反压与纹理借用期。见 SenderProbe/SenderReport。
         独立小工程（tools/ 已被主工程用 Compile Remove 排除编译），
         用 ProjectReference 复用主程序集里的 SpoutOut / SpoutIn / SpoutSourceProvider。 -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AssemblyName>SpoutProbe</AssemblyName>
        <RootNamespace>SpoutProbe</RootNamespace>
        <ApplicationManifest></ApplicationManifest>
        <!-- 控制台子系统：把实测数字打到 stdout，无人值守验证用 -->
    </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\JizuraLive.csproj" />
    <!-- S1b 要直接调 native SpoutSender，Q6 要直接调 native SpoutReceiver，都绕开主工程的封装；
         该包装是 C++/CLI 程序集，主工程已用 HintPath 引用，这里复用同一路径。 -->
    <Reference Include="SpoutDXWrapper">
      <HintPath>..\..\native\SpoutDXWrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
