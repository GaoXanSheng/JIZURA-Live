<Project Sdk="Microsoft.NET.Sdk">

    <!-- M1 路线图第 6 步「SpoutIn 可终止性核实」专用探针。
         回答三个问题，全部以实测数字为准：
           1) 无人发送时 native ReceiveTexturePtr 是否立即返回（不阻塞渲染线程）；
           2) 起接收 → Pump 若干次 → Dispose/Close，进程能否干净退出（退出码 0、无未处理异常）；
           3) 每帧 PumpFrame 耗时的实际量级（min/max/p50）。
         独立小工程（tools/ 已被主工程用 <Compile Remove="tools\**" /> 排除编译），
         用 ProjectReference 复用主程序集里的 SpoutIn / SpoutSourceProvider。 -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AssemblyName>SpoutProbe</AssemblyName>
        <RootNamespace>SpoutProbe</RootNamespace>
        <ApplicationManifest></ApplicationManifest>
        <!-- 控制台子系统：把实测数字打到 stdout，无人值守验证用 -->
    </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\JizuraLive.csproj" />
    <!-- Q6 要直接调 native SpoutReceiver，绕开主工程的 SpoutIn 封装；
         该包装是 C++/CLI 程序集，主工程已用 HintPath 引用，这里复用同一路径。 -->
    <Reference Include="SpoutDXWrapper">
      <HintPath>..\..\native\SpoutDXWrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
