<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- windows10.0.19041.0：引入 WinRT 投影（Microsoft.Windows.SDK.NET.Ref），SMTC 读外部播放器进度用 -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <RootNamespace>JizuraLive</RootNamespace>
        <AssemblyName>JizuraLive</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
        <Version>3.0.0</Version>
        <Product>JIZURA Live</Product>
        <Description>JIZURA-live（pure C#，无 CEF）</Description>
        <ApplicationIcon>assets\app.ico</ApplicationIcon>
        <!-- 自包含发布只带简中卫星资源：默认会把运行时全部语言目录（cs/de/es/...）打进去 -->
        <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
        <NoWarn>$(NoWarn);NU1701</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EmbedIO" Version="3.5.2"/>
        <PackageReference Include="log4net" Version="3.4.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12"/>
        <PackageReference Include="NAudio" Version="3.1.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="QRCoder" Version="1.8.0" />
        <PackageReference Include="SkiaSharp" Version="3.119.0" />
        <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.0" />
        <PackageReference Include="SharpDX" Version="4.2.0" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="SharpDX">
            <HintPath>$(NuGetPackageRoot)sharpdx\4.2.0\lib\net45\SharpDX.dll</HintPath>
        </Reference>
        <Reference Include="SharpDX.Direct3D11">
            <HintPath>$(NuGetPackageRoot)sharpdx.direct3d11\4.2.0\lib\net45\SharpDX.Direct3D11.dll</HintPath>
        </Reference>
        <Reference Include="SharpDX.DXGI">
            <HintPath>$(NuGetPackageRoot)sharpdx.dxgi\4.2.0\lib\net45\SharpDX.DXGI.dll</HintPath>
        </Reference>
        <Reference Include="SpoutDXWrapper">
            <HintPath>native\SpoutDXWrapper.dll</HintPath>
        </Reference>
        <None Remove="native\SpoutDX.dll"/>
        <Content Include="native\SpoutDX.dll" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Target Name="CopySpoutDx" AfterTargets="Build;Publish" Condition="Exists('native\SpoutDX.dll')">
        <Copy SourceFiles="native\SpoutDX.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
        <!-- publish 时 OutDir 指向构建目录，发布目录需要单独补一份，
             否则 SpoutDXWrapper.dll 找不到原生依赖，Spout 输出启动失败 -->
        <Copy SourceFiles="native\SpoutDX.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' And !Exists('$(PublishDir)SpoutDX.dll')"/>
    </Target>

    <!-- 发布产物不携带引用程序的 pdb/xml -->
    <PropertyGroup>
        <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>


    <ItemGroup>
      <Resource Include="assets\app.ico" />
      <!-- App.xaml 移入 src/App 后，SDK 只在项目根目录找 App.xaml 的隐式匹配不再命中，需显式声明入口定义 -->
      <ApplicationDefinition Include="src\App\App.xaml" />
      <!-- 测试工程单独一层目录，主程序不编译它 -->
      <Compile Remove="tests\**" />
      <None Remove="tests\**" />
      <Content Remove="tests\**" />
    </ItemGroup>

    <!-- ================= pure-csharp 重构说明 =================
         旧版经 CEF 渲染前端（frontend/ Vue3 SPA）并离屏出帧；本分支起改为纯 C#：
           - 渲染引擎：src/Engine（SkiaSharp，逐文件对位移植 frontend/src/engine）
           - 导出：src/Export（FFmpeg 编码 + SkiaSharp PNG/ZIP）
           - 编辑器 UI：WPF 原生（M2/M3 回归）
         frontend/ 暂冻结保留作移植参照，M7 删除。下方保留前端构建所需的引用注释占位：
         （无——前端构建目标已整体移除） -->
</Project>
