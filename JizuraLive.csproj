<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>JizuraLive</RootNamespace>
        <AssemblyName>JizuraLive</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
        <Version>0.5.0</Version>
        <Product>JIZURA Live</Product>
        <Description>JIZURA-live</Description>
        <ApplicationIcon>assets\app.ico</ApplicationIcon>
        <NoWarn>$(NoWarn);NU1701</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EmbedIO" Version="3.5.2"/>
        <PackageReference Include="log4net" Version="3.4.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="QRCoder" Version="1.6.0"/>
        <PackageReference Include="CefSharp.Common" Version="152.0.100"/>
        <PackageReference Include="CefSharp.Wpf" Version="152.0.100"/>
        <PackageReference Include="CefSharp.OffScreen" Version="152.0.100"/>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="SharpDX">
            <HintPath>$(NuGetPackageRoot)sharpdx\4.2.0\lib\net45\SharpDX.dll</HintPath>
        </Reference>
        <Reference Include="SharpDX.Direct3D11">
            <HintPath>$(NuGetPackageRoot)sharpdx.direct3d11\4.2.0\lib\net45\SharpDX.Direct3D11.dll</HintPath>
        </Reference>
        <Reference Include="SharpDX.DXGI">
            <HintPath>$(NuGetPackageRoot)sharpdx.dxgi\4.2.0\lib\net45\SharpDX.DXGI.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="CefSharp">
            <HintPath>$(NuGetPackageRoot)cefsharp.common\152.0.100\lib\net462\CefSharp.dll</HintPath>
        </Reference>
        <Reference Include="CefSharp.Core">
            <HintPath>$(NuGetPackageRoot)cefsharp.common\152.0.100\lib\net462\CefSharp.Core.dll</HintPath>
        </Reference>
        <Reference Include="CefSharp.Wpf">
            <HintPath>$(NuGetPackageRoot)cefsharp.wpf\152.0.100\lib\net462\CefSharp.Wpf.dll</HintPath>
        </Reference>
        <Reference Include="SpoutDXWrapper">
            <HintPath>native\SpoutDXWrapper.dll</HintPath>
        </Reference>
        <None Remove="native\SpoutDX.dll"/>
        <Content Include="native\SpoutDX.dll" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Target Name="CopySpoutDx" AfterTargets="Build;Publish" Condition="Exists('native\SpoutDX.dll')">
        <Copy SourceFiles="native\SpoutDX.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
        <!-- publish 时 OutDir 指向构建目录，发布目录需要单独补一份，
             否则 SpoutDXWrapper.dll 找不到原生依赖，镜像管线启动失败 -->
        <Copy SourceFiles="native\SpoutDX.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
              Condition="'$(PublishDir)' != '' And !Exists('$(PublishDir)SpoutDX.dll')"/>
    </Target>

    <!-- CefSharp 子进程 exe 的图标替换为 app.ico（任务管理器/资源管理器可见）。
         CefSharp 升级覆盖 exe 后，每次构建会自动重新打补丁；
         exe 被占用（程序正在运行）时只警告不阻断构建 -->
    <Target Name="PatchCefSubprocessIcon" AfterTargets="Build;Publish">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)tools\patch-subprocess-icon.ps1&quot; -TargetExe &quot;$(OutDir)CefSharp.BrowserSubprocess.exe&quot; -IconPath &quot;$(MSBuildThisFileDirectory)assets\app.ico&quot;"
              ContinueOnError="WarnAndContinue"
              Condition="Exists('$(OutDir)CefSharp.BrowserSubprocess.exe')"/>
        <!-- publish 目录单独补一份（同 CopySpoutDx 的处理方式） -->
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)tools\patch-subprocess-icon.ps1&quot; -TargetExe &quot;$(PublishDir)CefSharp.BrowserSubprocess.exe&quot; -IconPath &quot;$(MSBuildThisFileDirectory)assets\app.ico&quot;"
              ContinueOnError="WarnAndContinue"
              Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)CefSharp.BrowserSubprocess.exe')"/>
    </Target>

    <!-- 发布产物不携带引用程序的 pdb/xml -->
    <PropertyGroup>
        <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="wwwroot\**\*"/>
        <!-- 打包只带中文（zh-hans）：其余语言与站点构建工具链只存在于
             wwwroot 源码（GitHub Pages 用），不进应用产物 -->
        <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest"
                 Exclude="wwwroot\en\**;wwwroot\id\**;wwwroot\ko\**;wwwroot\vi\**;wwwroot\zh-hant\**;wwwroot\index.html;wwwroot\sitemap.xml;wwwroot\build.py;wwwroot\**\*.py;wwwroot\**\*.pyc;wwwroot\**\__pycache__\**"/>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="assets\app.ico" />
    </ItemGroup>
</Project>
