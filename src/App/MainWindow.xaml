<Window x:Class="JizuraLive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:views="clr-namespace:JizuraLive.App.Views"
        Title="{DynamicResource Loc.Main.Title}"
        Icon="pack://application:,,,/assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Width="1440" Height="860" MinWidth="980" MinHeight="620"
        Background="{StaticResource Ink}"
        Foreground="{StaticResource Fg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（bg #151519；标题 14 左距，窗口按钮右贴） -->
        <Grid Grid.Row="0" Height="36" Background="#FF151519"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="{DynamicResource Loc.Main.Title}"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Opacity="0.65" Foreground="{StaticResource FgMain}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMin" Style="{StaticResource ChromeBtn}" Click="BtnMin_Click" ToolTip="{DynamicResource Loc.Main.Min.Tip}">
                    <Path Data="M 0 0 H 10" Stroke="{StaticResource FgMain}" StrokeThickness="1"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="BtnMax" Style="{StaticResource ChromeBtn}" Click="BtnMax_Click" ToolTip="{DynamicResource Loc.Main.Max.Tip}">
                    <Path x:Name="IcMax" Data="M 0 0 H 10 V 10 H 0 Z" Stroke="{StaticResource FgMain}"
                          StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="BtnClose" Click="BtnClose_Click" ToolTip="{DynamicResource Loc.Main.Close.Tip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E5C42B1C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path x:Name="IcClose" Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{StaticResource FgMain}"
                          StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 顶栏：曲名/歌手 + 打开/保存/初始化/使用说明（对位 TopBar.vue） -->
        <views:TopBar Grid.Row="1" />
        <!-- 三栏工作区（对位 EditorPage.vue：minmax(280,340) | 1fr | minmax(300,370)） -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="340" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="370" MinWidth="300" MaxWidth="370" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：歌词与时间（bg-panel + border-r） -->
            <Border Grid.Column="0" Background="{StaticResource Panel}">
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 打点浮层（对位 TapPanel：active 时盖在歌词面板上） -->
                            <views:TapPanel />
                            <views:LyricsPanel />
                            <views:AudioPanel />
                            <views:LineList />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- 中栏：舞台 / 播放条 / 时间轴 / 切分信息（px-4 py-3 gap-2.5） -->
            <Grid Grid.Column="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 舞台视口：bg-black + 1px line + 圆角 10（对位 StageCanvas.vue 的 viewport） -->
                <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <skia:SKElement x:Name="Stage" PaintSurface="Stage_PaintSurface" />
                </Border>
                <views:Transport Grid.Row="1" Margin="0,10,0,0" />
                <views:TimelineCanvas Grid.Row="2" Margin="0,10,0,0" />
                <views:CutInfo Grid.Row="3" Margin="0,10,0,0" />
            </Grid>

            <!-- 右栏：风格与导出（bg-panel + border-l） -->
            <Border Grid.Column="2" Background="{StaticResource Panel}">
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                    <views:RightPanel x:Name="Right" />
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
