<Window x:Class="JizuraLive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="字面 Live"
        Icon="pack://application:,,,/assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Width="1280" Height="720" MinWidth="480" MinHeight="360"
        Background="#FF0F0F12"
        Foreground="{StaticResource FgMain}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF26262E" />
            <Setter Property="Foreground" Value="{StaticResource FgMain}" />
            <Setter Property="BorderBrush" Value="#FF3C3C46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF34343E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1D1D24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="36" Background="#FF151519"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="字面 Live"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Opacity="0.65" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMin_Click" ToolTip="最小化" />
                <!-- 最大化 ↔ 窗口化共用一个按钮，图标和提示随窗口状态切换（见 UpdateMaxButton） -->
                <Button x:Name="BtnMax" Content="&#xE739;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMax_Click" ToolTip="最大化" />
                <Button x:Name="BtnClose" Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets" Click="BtnClose_Click" ToolTip="退出">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#E5C42B1C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        <!-- 顶栏工具条：歌词编辑 / 重新规划 / Spout 输出开关；右侧状态文本（引擎/输出概况） -->
        <Border Grid.Row="1" Background="#FF1D1D24" Padding="10,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnLyrics" Content="歌词" Style="{StaticResource ToolBtn}"
                            Click="BtnLyrics_Click" ToolTip="编辑歌词（保存后重新规划）" />
                    <Button x:Name="BtnReplan" Content="重新规划" Style="{StaticResource ToolBtn}"
                            Click="BtnReplan_Click" ToolTip="按当前工程重新生成 plan" />
                    <CheckBox x:Name="ChkSpout" Content="Spout 输出" VerticalAlignment="Center" Margin="4,0,0,0"
                              Checked="ChkSpout_Changed" Unchecked="ChkSpout_Changed" ToolTip="Spout 发送开关（即时启停）" />
                </StackPanel>
                <TextBlock x:Name="TblStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontSize="11" Opacity="0.55" Text="" />
            </DockPanel>
        </Border>
        <!-- 引擎预览舞台：SKElement 画 PreviewEngine.Plan 的当前帧（Renderer.Frame，Stage 模式） -->
        <Grid Grid.Row="2" Margin="5,5,5,0" Background="#FF0F0F12">
            <skia:SKElement x:Name="Stage" PaintSurface="Stage_PaintSurface" />
        </Grid>
        <!-- 底部 Transport：播放/暂停、时间滑条（scrub）、当前时间/总时长、循环开关 -->
        <Border Grid.Row="3" Background="#FF151519" Padding="10,6">
            <DockPanel>
                <Button x:Name="BtnPlay" Content="&#xE768;" Style="{StaticResource ToolBtn}" Width="36"
                        FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0"
                        Click="BtnPlay_Click" ToolTip="播放/暂停（空格）" />
                <TextBlock x:Name="TblTime" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Margin="10,0,0,0"
                           FontFamily="Consolas" Text="00:00.00 / 00:00.00" />
                <CheckBox x:Name="ChkLoop" Content="循环" DockPanel.Dock="Right" VerticalAlignment="Center"
                          IsChecked="True" Margin="0,0,10,0" Checked="ChkLoop_Changed" Unchecked="ChkLoop_Changed" />
                <Slider x:Name="SldTime" VerticalAlignment="Center" Minimum="0" Maximum="1"
                        ValueChanged="SldTime_ValueChanged"
                        PreviewMouseLeftButtonDown="SldTime_Down" PreviewMouseLeftButtonUp="SldTime_Up" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
