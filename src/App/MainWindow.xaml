<Window x:Class="JizuraLive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="字面 Live"
        Icon="pack://application:,,,/assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Width="1280" Height="720" MinWidth="480" MinHeight="360"
        Background="#FF0F0F12"
        Foreground="{StaticResource FgMain}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="36" Background="#FF151519"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="字面 Live"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Opacity="0.65" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMin_Click" ToolTip="最小化" />
                <!-- 最大化 ↔ 窗口化共用一个按钮，图标和提示随窗口状态切换（见 UpdateMaxButton） -->
                <Button x:Name="BtnMax" Content="&#xE739;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMax_Click" ToolTip="最大化" />
                <Button x:Name="BtnClose" Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets" Click="BtnClose_Click" ToolTip="退出">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#E5C42B1C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        <!-- 纯 C# 重构（pure-csharp 分支）：CEF 已移除。编辑器 UI 将按里程碑回归（M2/M3），
             这里先放 SkiaSharp 渲染验证画布，验证 net10 + SkiaSharp 端到端可用 -->
        <Border Grid.Row="1" Background="#FF1D1D24" Padding="14,8">
            <TextBlock Text="纯 C# 重构中 · M0 脚手架 —— CEF 已移除；渲染引擎 / 编辑器 / 导出将逐里程碑回归"
                       FontSize="12" Opacity="0.7" />
        </Border>
        <Grid Grid.Row="2" Margin="5,5,5,5" Background="#FF0F0F12">
            <skia:SKElement x:Name="Stage" PaintSurface="Stage_PaintSurface" />
        </Grid>
    </Grid>
</Window>
