<Window x:Class="JizuraLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JizuraLive"
        xmlns:cef="clr-namespace:CefSharp.Wpf.HwndHost;assembly=CefSharp.Wpf"
        Title="JIZURA Live"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Width="1280" Height="756" MinWidth="480" MinHeight="360"
        Background="#FF0F0F12"
        Foreground="{StaticResource FgMain}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="36" Background="#FF151519"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="JIZURA Live"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Opacity="0.65"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGear" Content="&#x2699;" Style="{StaticResource ChromeBtn}"
                        FontSize="16" Click="BtnGear_Click" ToolTip="设置"/>
                <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMin_Click" ToolTip="最小化"/>
                <Button x:Name="BtnClose" Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets" Click="BtnClose_Click" ToolTip="退出">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#E5C42B1C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        <cef:ChromiumWebBrowser x:Name="Browser" Grid.Row="1"/>
    </Grid>
</Window>
