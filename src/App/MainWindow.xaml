<Window x:Class="JizuraLive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:views="clr-namespace:JizuraLive.App.Views"
        Title="字面 Live"
        Icon="pack://application:,,,/assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Width="1440" Height="860" MinWidth="980" MinHeight="620"
        Background="{StaticResource Ink}"
        Foreground="{StaticResource Fg}"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo, Microsoft YaHei" FontSize="12">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid Grid.Row="0" Height="36" Background="#FF151519"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="字面 Live"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Opacity="0.65" Foreground="{StaticResource FgMain}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMin_Click" ToolTip="最小化" />
                <Button x:Name="BtnMax" Content="&#xE739;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMax_Click" ToolTip="最大化" />
                <Button x:Name="BtnClose" Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets" Click="BtnClose_Click" ToolTip="退出">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#E5C42B1C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 顶栏：曲名/歌手 + 打开/保存/初始化/使用说明 + Spout 开关 + 状态（对位 TopBar.vue） -->
        <views:TopBar Grid.Row="1" />

        <!-- 三栏工作区（对位 EditorPage.vue：280-340 | * | 300-370） -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" MaxWidth="380" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" MinWidth="300" MaxWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：歌词与时间 -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <views:TapPanel />
                        <!--<views:LyricsPanel />-->
                        <views:AudioPanel />
                        <views:LineList />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中栏：舞台 / 播放条 / 时间轴 / 切分信息 -->
            <Grid Grid.Column="1" Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FF0A0A0C" CornerRadius="4">
                    <skia:SKElement x:Name="Stage" PaintSurface="Stage_PaintSurface" />
                </Border>
                <views:Transport Grid.Row="1" Margin="0,8,0,0" />
                <views:TimelineCanvas Grid.Row="2" Margin="0,6,0,0" />
                <views:CutInfo Grid.Row="3" Margin="0,6,0,0" />
            </Grid>

            <!-- 右栏：风格与导出 -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <views:RightPanel />
            </Border>
        </Grid>
    </Grid>
</Window>
