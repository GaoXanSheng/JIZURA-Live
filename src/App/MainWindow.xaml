<Window x:Class="JizuraLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cef="clr-namespace:CefSharp.Wpf.HwndHost;assembly=CefSharp.Wpf"
        Title="字面 Live"
        Icon="pack://application:,,,/assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Width="1280" Height="720" MinWidth="480" MinHeight="360"
        Background="#FF0F0F12"
        Foreground="{StaticResource FgMain}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="36" Background="#FF151519"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="字面 Live"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Opacity="0.65" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMin_Click" ToolTip="最小化" />
                <!-- 最大化 ↔ 窗口化共用一个按钮，图标和提示随窗口状态切换（见 UpdateMaxButton） -->
                <Button x:Name="BtnMax" Content="&#xE739;" Style="{StaticResource ChromeBtn}"
                        FontFamily="Segoe MDL2 Assets" Click="BtnMax_Click" ToolTip="最大化" />
                <Button x:Name="BtnClose" Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets" Click="BtnClose_Click" ToolTip="退出">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#E5C42B1C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        <!-- CEF 是 Win32 句柄控件，贴满边缘会盖住缩放热区（鼠标进不了 WindowChrome 命中测试），
             内缩 5px 让边缘归 WPF 才能拖拽缩放 -->
        <Grid Grid.Row="1" Margin="5" Background="#FF0F0F12">
            <cef:ChromiumWebBrowser x:Name="Browser" />
        </Grid>
    </Grid>
</Window>