<UserControl x:Class="JizuraLive.App.Views.LineList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JizuraLive.App.Controls"
             xmlns:views="clr-namespace:JizuraLive.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <!-- 手法/切分下拉的弹出条目：11px 紧凑行（对位旧 select 的 option 紧凑行高） -->
        <Style x:Key="MiniComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 切分手法下拉：!h-[22px] !py-0 !px-1 text-[10px] max-w-[112px] w-auto（SelXs + 宽度上限 112） -->
        <Style x:Key="SelTech" TargetType="ComboBox" BasedOn="{StaticResource SelXs}">
            <Setter Property="MaxWidth" Value="112" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MiniComboItem}" />
        </Style>

        <!-- 动作行小号下拉：!h-auto !py-0.5 !px-1 text-[11px] max-w-[92px] w-auto -->
        <Style x:Key="SelMini" TargetType="ComboBox" BasedOn="{StaticResource SelXs}">
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,0,14,0" />
            <Setter Property="MaxWidth" Value="92" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MiniComboItem}" />
        </Style>

        <!-- 动作行图标：Theme.xaml 的 16 视图框几何（stroke 1.4，色随按钮前景），套 15×15 Viewbox
             （对位 .btn-icon svg 的 w/h 15px；不用 Segoe MDL2 —— 本机无字形） -->
        <Viewbox x:Key="IcEdit" x:Shared="False" Width="15" Height="15">
            <Canvas Width="16" Height="16">
                <Path Data="{StaticResource IconEditPath}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
                <Path Data="{StaticResource IconEditLine}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
            </Canvas>
        </Viewbox>
        <Viewbox x:Key="IcTap" x:Shared="False" Width="15" Height="15">
            <Canvas Width="16" Height="16">
                <Path Data="{StaticResource IconTapInner}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
                <Path Data="{StaticResource IconTapOuter}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
            </Canvas>
        </Viewbox>
        <Viewbox x:Key="IcRange" x:Shared="False" Width="15" Height="15">
            <Canvas Width="16" Height="16">
                <Path Data="{StaticResource IconRangeEdge}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
                <Path Data="{StaticResource IconRangeArrow}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
            </Canvas>
        </Viewbox>
        <Viewbox x:Key="IcLock" x:Shared="False" Width="15" Height="15">
            <Canvas Width="16" Height="16">
                <Path Data="{StaticResource IconLockBody}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
                <Path Data="{StaticResource IconLockPath}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
            </Canvas>
        </Viewbox>

        <!-- 行模板（对位 LineRow.vue 的 <li>：22px | 66px | minmax(0,1fr) 三列，p6 圆角 6，
             切分格 + 动作行跨第 2-3 列纵排；列距 6 / 行距 4 用 Margin 折算） -->
        <DataTemplate x:Key="RowTemplate">
            <Border x:Name="RowBd" BorderThickness="1" CornerRadius="6" Padding="6" SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- 未选中：border-transparent；hover 补 bg-raised -->
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Raised}" />
                            </Trigger>
                            <!-- 播放中行：border-line2 + bg-raised（对位 active 类） -->
                            <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Raised}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
                            </DataTrigger>
                            <!-- 导出范围命中的行：`!border-amber` 覆盖 active（Trigger 顺序靠后者胜） -->
                            <DataTrigger Binding="{Binding InRange}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- 列宽 = Vue 的 grid-cols-[22px_66px_minmax(0,1fr)] + 列距 6（gap-x-1.5）：
                         22+6 / 66+6，子元素用 6px 右边距削出间隙，几何与浏览器逐像素一致 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 播放中行的左侧 2px 琥珀内嵌条（对位 shadow-[inset_2px_0_0_amber]；
                         Margin -6 抵消外层 Padding，贴到边框内沿） -->
                    <Border x:Name="ActiveBar" Grid.RowSpan="2" Grid.ColumnSpan="3" Width="2" Margin="-6,-6,0,-6"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Background="{StaticResource Amber}" CornerRadius="1" Visibility="Collapsed" />

                    <!-- 第 1 列：序号（font-mono 11px text-faint 右对齐） -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding No}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" Foreground="{StaticResource Faint}" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,6,0" />

                    <!-- 第 2 列：行开始时刻（h26 mono 12px，w-full；手动时间边框青色。
                         外框承载颜色 —— 内层 TextBox 无边框，避免 hover/focus 触发器把青框顶掉） -->
                    <Border x:Name="StartBd" Grid.Row="0" Grid.Column="1" Height="26" BorderThickness="1"
                            CornerRadius="6" Background="{StaticResource Raised}"
                            BorderBrush="{StaticResource LineBrush}" Margin="0,0,6,0"
                            SnapsToDevicePixels="True">
                        <TextBox x:Name="StartBox" Style="{StaticResource TbSm}" Height="Auto" BorderThickness="0"
                                 Background="Transparent" Padding="4,0" Text="{Binding StartText, Mode=OneWay}"
                                 ToolTip="{Binding StartTip}"
                                 LostFocus="StartBox_LostFocus" KeyDown="TimeBox_KeyDown" />
                    </Border>

                    <!-- 编辑态：行内文本框（Enter 确认 / Esc 取消，记法可用） -->
                    <TextBox x:Name="EditBox" Grid.Row="0" Grid.Column="2" Style="{StaticResource TbSm}"
                             FontSize="13" Padding="6,0" VerticalAlignment="Center"
                             Visibility="{Binding Editing, Converter={StaticResource B2V}}"
                             Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="EditBox_LostFocus" KeyDown="EditBox_KeyDown" Loaded="EditBox_Loaded"
                             ToolTip="{DynamicResource Loc.LineList.EditBox.Tip}" />

                    <!-- 第 3 列：行文本 13px 超出裁切，点击定位到行首（编辑态由触发器收起） -->
                    <TextBlock x:Name="Lbl" Grid.Row="0" Grid.Column="2" Text="{Binding Label}" ToolTip="{Binding Full}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonDown="Label_Click" />

                    <!-- 第 2-3 列跨列（col-start-2 col-span-2）：切分格 + 动作行，纵排 gap-1（4） -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <!-- 每个切分一格：边界时刻（第 2 段起） + 手法下拉；段间 4px -->
                        <ItemsControl ItemsSource="{Binding Cuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <!-- 切分边界时刻 w-52 h-22 mono 10px（手动时刻边框青色） -->
                                        <Border x:Name="CutBd" Width="52" Height="22" BorderThickness="1"
                                                CornerRadius="6" Background="{StaticResource Raised}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                SnapsToDevicePixels="True"
                                                Visibility="{Binding HasTime, Converter={StaticResource B2V}}">
                                            <TextBox x:Name="CutTimeBox" Style="{StaticResource TbXs}" Height="Auto"
                                                     Width="Auto" BorderThickness="0" Background="Transparent"
                                                     Padding="2,0" Text="{Binding StartText, Mode=OneWay}"
                                                     ToolTip="{Binding BoundaryTip}"
                                                     LostFocus="CutTimeBox_LostFocus" KeyDown="TimeBox_KeyDown" />
                                        </Border>
                                        <!-- 手法下拉：边框色 = 该手法在 LAYOUT_ORDER 的序号取色；强制指定时琥珀 -->
                                        <Border x:Name="TechBd" Height="22" MaxWidth="112" Margin="2,0,0,0"
                                                BorderThickness="1" CornerRadius="6" Background="{StaticResource Raised}"
                                                BorderBrush="{Binding Border}" SnapsToDevicePixels="True">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Loc.LineList.CutQuiet}" IsCheckable="True" IsChecked="{Binding IsQuiet}" Click="CutQuiet_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <ComboBox x:Name="TechCombo" Style="{StaticResource SelTech}" Height="Auto"
                                                      BorderThickness="0" Background="Transparent"
                                                      ItemsSource="{Binding LayoutItems, RelativeSource={RelativeSource AncestorType=views:LineList}}"
                                                      SelectedIndex="{Binding LayoutIndex}"
                                                      SelectionChanged="CutCombo_SelectionChanged"
                                                      ToolTip="{Binding Title}" />
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CtManual}" Value="True">
                                            <Setter TargetName="CutBd" Property="BorderBrush"
                                                    Value="{StaticResource Cyan}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Forced}" Value="True">
                                            <Setter TargetName="TechBd" Property="BorderBrush"
                                                    Value="{StaticResource Amber}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 动作行（gap-0.5 靠右；放不下时折行 —— Vue 是 overflow-x-auto 单行横滚，
                             本机按可折行处理，宁可折行也不裁掉按钮） -->
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="EditBtn" Style="{StaticResource BtnIcon}" Content="{StaticResource IcEdit}"
                                    Margin="2,0,0,2" Click="EditBtn_Click" ToolTip="{DynamicResource Loc.LineList.Edit.Tip}" />
                            <!-- 切分数：切分 自动 / 切分 N（间奏行不显示） -->
                            <ComboBox x:Name="NcutCombo" Style="{StaticResource SelMini}" Margin="2,0,0,2"
                                      ItemsSource="{Binding NcutItems, RelativeSource={RelativeSource AncestorType=views:LineList}}"
                                      SelectedIndex="{Binding NcutIndex}"
                                      SelectionChanged="NcutCombo_SelectionChanged" ToolTip="{DynamicResource Loc.LineList.Ncut.Tip}"
                                      Visibility="{Binding HasCutsControls, Converter={StaticResource B2V}}" />
                            <!-- 布局指定（自动 = 按词数随机抽取） -->
                            <ComboBox x:Name="RowLayoutCombo" Style="{StaticResource SelMini}" Margin="2,0,0,2"
                                      ItemsSource="{Binding LayoutItems, RelativeSource={RelativeSource AncestorType=views:LineList}}"
                                      SelectedIndex="{Binding LayoutIndex}"
                                      SelectionChanged="RowLayoutCombo_SelectionChanged"
                                      ToolTip="{DynamicResource Loc.LineList.RowLayout.Tip}"
                                      Visibility="{Binding HasCutsControls, Converter={StaticResource B2V}}" />
                            <Button x:Name="TapBtn" Style="{StaticResource BtnIcon}" Content="{StaticResource IcTap}"
                                    Margin="2,0,0,2" Click="TapFromBtn_Click" ToolTip="{DynamicResource Loc.LineList.Tap.Tip}" />
                            <!-- 导出范围（选段）：点一下把这一行首→末切分设为范围；Shift+点击扩大（并集）；
                                 再点同一段取消。命中行按钮琥珀 + 行框琥珀描边（对位 LineRow.vue 的 inRange） -->
                            <Button x:Name="RangeBtn" Style="{StaticResource BtnIcon}" Content="{StaticResource IcRange}"
                                    Margin="2,0,0,2" Click="RangeBtn_Click" ToolTip="{DynamicResource Loc.LineList.Range.Tip}" />
                            <Button x:Name="LockBtn" Style="{StaticResource BtnIcon}" Content="{StaticResource IcLock}"
                                    Margin="2,0,0,2" Click="LockBtn_Click" ToolTip="{DynamicResource Loc.LineList.Lock.Tip}"
                                    Visibility="{Binding HasCutsControls, Converter={StaticResource B2V}}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Manual}" Value="True">
                    <Setter TargetName="StartBd" Property="BorderBrush" Value="{StaticResource Cyan}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Interlude}" Value="True">
                    <Setter TargetName="Lbl" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Editing}" Value="True">
                    <Setter TargetName="Lbl" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Locked}" Value="True">
                    <Setter TargetName="LockBtn" Property="Foreground" Value="{StaticResource Amber}" />
                </DataTrigger>
                <!-- 导出范围按钮点亮（对位 row.inRange ? '!text-amber' : ''） -->
                <DataTrigger Binding="{Binding InRange}" Value="True">
                    <Setter TargetName="RangeBtn" Property="Foreground" Value="{StaticResource Amber}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 对位 .sec：bg-panel / border-b / px-4 py-3.5；标题与列表间距 10（gap-2.5） -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- sec-h：左 sec-title（11px tracking .18em mut semibold），右 `N 行 / M 切分` -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ctl:JzLabel Text="{DynamicResource Loc.LineList.Title}" Tracking="0.18" TextElement.FontSize="11"
                             TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Mut}"
                             VerticalAlignment="Center" />
                <TextBlock x:Name="TblInfo" Grid.Column="1" Style="{StaticResource MonoMut}" FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 行列表（行距 6 = gap-1.5；虚拟化交给 ListBox，行数据由 code-behind 重建） -->
            <ListBox x:Name="Lst" Grid.Row="1" ItemTemplate="{StaticResource RowTemplate}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
