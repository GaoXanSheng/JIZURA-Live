<Window x:Class="JizuraLive.App.Views.CloudPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云音乐" Width="800" Height="580" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 平台切换小页签（对位旧版 CloudMusicModal 头部的 酷狗/网易云 分段按钮） -->
        <Style x:Key="SrcBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 歌曲列表行容器 -->
        <Style x:Key="SongItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VipBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#C8A24A" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 平台切换 + 音质 + 登录态 -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="云音乐" FontSize="14" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Border DockPanel.Dock="Left" Background="{StaticResource Raised}" CornerRadius="6"
                    BorderBrush="{StaticResource Line2}" BorderThickness="1" Margin="14,0,0,0" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnKugou" Content="酷狗" Style="{StaticResource SrcBtn}" Click="BtnSource_Click" />
                    <Button x:Name="BtnNetease" Content="网易云" Style="{StaticResource SrcBtn}"
                            Click="BtnSource_Click" />
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TblLogin" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource Mut}" Text="未登录" />
                <Button x:Name="BtnLogin" Content="登录" Click="BtnLogin_Click"
                        ToolTip="扫码登录（VIP 歌曲需要）" />
                <Button x:Name="BtnLogout" Content="退出" Style="{StaticResource BtnGhost}" Margin="4,0,0,0"
                        Click="BtnLogout_Click" />
                <ComboBox x:Name="CmbQuality" Width="76" Margin="10,0,0,0" SelectionChanged="CmbQuality_Changed"
                          ToolTip="音质（320k/无损需要扫码登录）" />
            </StackPanel>
        </DockPanel>

        <!-- 搜索行 -->
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,8">
            <TextBox x:Name="TbQuery" Width="360" DockPanel.Dock="Left"
                     KeyDown="TbQuery_KeyDown"
                     ToolTip="在线搜索：歌名 / 歌手（回车搜索）" />
            <Button x:Name="BtnSearch" Content="搜索" DockPanel.Dock="Left" Margin="8,0,0,0"
                    Click="BtnSearch_Click" />
            <TextBlock x:Name="TblSearchInfo" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource Mut}" Margin="0,0,2,0" Text="" />
        </DockPanel>

        <!-- 二维码登录（弹出区，默认收起） -->
        <Border x:Name="QrPanel" Grid.Row="2" Background="{StaticResource Raised}" CornerRadius="8"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12"
                Visibility="Collapsed" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Border Background="White" CornerRadius="4" Padding="6">
                    <Image x:Name="QrImg" Width="168" Height="168" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TblQrTip" Text="正在获取二维码…" Foreground="{StaticResource Fg}" />
                    <TextBlock Text="打开手机版 App 扫一扫登录" Foreground="{StaticResource Mut}" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnQrRefresh" Content="刷新二维码" Click="BtnQrRefresh_Click" />
                        <Button Content="关闭" Style="{StaticResource BtnGhost}" Margin="6,0,0,0"
                                Click="BtnQrClose_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- SMTC 跟随 -->
        <Border x:Name="FollowBox" Grid.Row="3" Background="{StaticResource Raised}" CornerRadius="8"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkFollow" Content="跟随外部播放器" Checked="ChkFollow_Changed"
                                  Unchecked="ChkFollow_Changed"
                                  ToolTip="酷狗/网易云/QQ音乐等播放器出声，这里只同步进度渲染歌词（SMTC）" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="-0.5s" Style="{StaticResource BtnGhost}" Click="BtnNudgeM_Click"
                                ToolTip="歌词向后挪 0.5 秒（对齐微调）" />
                        <Button Content="+0.5s" Style="{StaticResource BtnGhost}" Click="BtnNudgeP_Click"
                                ToolTip="歌词向前赶 0.5 秒（对齐微调）" />
                        <Button x:Name="BtnRematch" Content="重新匹配" Style="{StaticResource BtnGhost}"
                                Click="BtnRematch_Click" />
                        <TextBlock x:Name="TblOffset" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{StaticResource Mut}" Text="" />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="FollowDetail" Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="TblFollowStatus" VerticalAlignment="Center" />
                    <TextBlock x:Name="TblFollowNow" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource Mut}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="TblFollowDetail" Foreground="{StaticResource Amber}" Margin="0,4,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- 歌曲列表 -->
        <ListBox x:Name="Lst" Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                 Background="{StaticResource Ink}" ItemContainerStyle="{StaticResource SongItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SingerLine}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SingerLine}" Foreground="{StaticResource Mut}"
                                   FontSize="11" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="VIP" Style="{StaticResource VipBadge}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding VipVisibility}" />
                        <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" FontSize="11"
                                   Foreground="{StaticResource Cyan}" />
                        <Button Grid.Column="4" Content="装载" Click="BtnLoad_Click" Tag="{Binding}"
                                VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部提示 / 空态 -->
        <TextBlock x:Name="TblHint" Grid.Row="5" Margin="2,8,2,0" Foreground="{StaticResource Mut}"
                   TextWrapping="Wrap"
                   Text="输入关键词搜索歌曲，「装载」会下载音频与歌词并填入工程。跟随模式请勿装载歌曲（会带入音频抢时间轴）；导出歌曲请确认你拥有相应权利。" />
    </Grid>
</Window>
