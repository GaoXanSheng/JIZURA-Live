<Window x:Class="JizuraLive.App.Views.CloudPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:JizuraLive.App.Controls"
        Title="云端音乐"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 对位旧版 CloudMusicModal.vue：fixed inset-0 遮罩 rgba(6,6,8,.6) + 居中 bg-panel 卡片（min(860px,96vw) × min(600px,88vh)）。 -->
    <Window.Resources>
        <!-- 平台切换分段按钮（CloudMusicModal 头部 酷狗/网易云）：px-3 py-1 text-xs rounded-md hover:bg-white/5 -->
        <Style x:Key="SrcBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧页签（nav button）：选中 = bg-amber/10 + text-amber（Tag="on"），悬停 hover:bg-white/5 + text-fg -->
        <Style x:Key="PaneBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Amber10}" />
                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌曲行容器（SongList.vue 的 li：border-t border-line，首行无分隔线，hover bg-white/5） -->
        <Style x:Key="SongItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                <Setter TargetName="bd" Property="BorderThickness" Value="0" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 整行即按钮（SongList.vue：点歌名即可载入）：无边框透明，悬停交给外层 ListBoxItem -->
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 账号页平台卡片：bg-raised border-line rounded-[10px] p-3.5，hover:border-line2 -->
        <Style x:Key="AccountCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- cyan 下划线文字按钮（跟随页「重新匹配」「去搜索页手动找歌」） -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Cyan}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 跟随开关（FollowPane：未开=btn-primary「开始跟随」，开启=btn-ghost「停止跟随」；仍是 CheckBox，语义/事件不变） -->
        <Style x:Key="FollowToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd" Background="{StaticResource Amber}" BorderBrush="{StaticResource Amber}"
                                BorderThickness="1" CornerRadius="6" Height="32" Padding="12,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#F5A50C" BlurRadius="14" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <TextBlock x:Name="tx" Text="开始跟随" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryInk}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="Transparent" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter TargetName="bd" Property="Effect" Value="{x:Null}" />
                                <Setter TargetName="tx" Property="Text" Value="停止跟随" />
                                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Fg}" />
                                <Setter TargetName="tx" Property="FontWeight" Value="Normal" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 空态/占位文案（text-xs mut） -->
        <Style x:Key="EmptyTx" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 全窗遮罩 rgba(6,6,8,.6)，点空白关窗（对位 @click.self="cloud.open = false"） -->
        <Border x:Name="Mask" Background="#99060608" MouseLeftButtonDown="Mask_Click" />

        <!-- 居中卡片 -->
        <Border x:Name="Card" Width="860" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1"
                CornerRadius="16" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="8" Opacity="0.5" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 头部：标题 + 平台切换 + 关闭 -->
                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                        Padding="18,14">
                    <DockPanel LastChildFill="False">
                        <ctl:JzLabel DockPanel.Dock="Left" Text="云端音乐" Tracking="0.05"
                                     TextElement.FontSize="15" TextElement.FontWeight="SemiBold"
                                     TextElement.Foreground="{StaticResource Fg}" VerticalAlignment="Center" />
                        <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="✕" Style="{StaticResource BtnIcon}"
                                Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="关闭"
                                Click="BtnClose_Click" />
                        <Border DockPanel.Dock="Right" Background="{StaticResource Raised}"
                                BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8"
                                Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnKugou" Content="酷狗" Style="{StaticResource SrcBtn}"
                                        Margin="0,0,2,0" Click="BtnSource_Click" />
                                <Button x:Name="BtnNetease" Content="网易云" Style="{StaticResource SrcBtn}"
                                        Click="BtnSource_Click" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 主体：左侧页签 + 内容区 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="144" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#26000000" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,1,0" Padding="10">
                        <StackPanel VerticalAlignment="Top">
                            <Button x:Name="NavSearch" Content="搜索" Style="{StaticResource PaneBtn}" Tag="on"
                                    Click="Nav_Click" />
                            <Button x:Name="NavPlaylists" Content="我的歌单" Style="{StaticResource PaneBtn}"
                                    Click="Nav_Click" />
                            <Button x:Name="NavFollow" Content="跟随播放器" Style="{StaticResource PaneBtn}"
                                    Click="Nav_Click" />
                            <Button x:Name="NavAccount" Content="账号" Style="{StaticResource PaneBtn}"
                                    Click="Nav_Click" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="16,14">
                        <!-- ===== 搜索页（SearchPane.vue） ===== -->
                        <Grid x:Name="PaneSearch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="TbQuery" KeyDown="TbQuery_KeyDown" />
                                    <TextBlock Text="在线搜索：歌名 / 歌手" Foreground="{StaticResource Faint}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TbQuery}"
                                                                 Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ComboBox x:Name="CmbQuality" Grid.Column="1" Width="92" Margin="8,0,0,0"
                                          SelectionChanged="CmbQuality_Changed"
                                          ToolTip="音质（320k/无损需要扫码登录）" />
                                <Button x:Name="BtnSearch" Grid.Column="2" Content="搜索" Margin="8,0,0,0"
                                        Style="{StaticResource BtnPrimary}" Click="BtnSearch_Click" />
                                <TextBlock x:Name="TblSearchInfo" Grid.Column="3" Margin="10,0,2,0" FontSize="11"
                                           Foreground="{StaticResource Mut}" VerticalAlignment="Center" Text="" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="6" ClipToBounds="True">
                                    <ListBox x:Name="Lst" Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource SongItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowBtn}" Tag="{Binding}"
                                                        Click="BtnLoad_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52*" />
                                                            <ColumnDefinition Width="48*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   ToolTip="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SingerLine}"
                                                                   ToolTip="{Binding SingerLine}" FontSize="11"
                                                                   Foreground="{StaticResource Mut}"
                                                                   TextTrimming="CharacterEllipsis" Margin="8,0,8,0"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" BorderBrush="#8A6D2F" BorderThickness="1"
                                                                CornerRadius="4" Padding="4,0" Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding VipVisibility}">
                                                            <TextBlock Text="VIP" FontSize="10" LineHeight="15"
                                                                       Foreground="#C8A24A" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11"
                                                                   Foreground="{StaticResource Cyan}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock Text="输入关键词搜索歌曲，点歌名即可载入音频与歌词"
                                           VerticalAlignment="Center" Foreground="{StaticResource Mut}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyTx}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=Lst}"
                                                             Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- ===== 我的歌单（PlaylistPane.vue：我的歌单列表 + 粘贴链接/ID 载入） ===== -->
                        <Grid x:Name="PanePlaylists" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="TbPlaylist" KeyDown="TbPlaylist_KeyDown" />
                                    <TextBlock Text="粘贴歌单 ID / 链接，回车载入" Foreground="{StaticResource Faint}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TbPlaylist}"
                                                                 Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button x:Name="BtnPlaylistLoad" Grid.Column="1" Content="载入" Margin="8,0,0,0"
                                        Click="BtnPlaylistLoad_Click" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="6" ClipToBounds="True">
                                    <ListBox x:Name="LstPlaylists" Background="Transparent" BorderThickness="0"
                                             Padding="0" ItemContainerStyle="{StaticResource SongItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowBtn}" Tag="{Binding}"
                                                        Click="BtnPlaylist_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   ToolTip="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding CountLine}"
                                                                   FontSize="11" Foreground="{StaticResource Mut}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <!-- 空态 / 加载中 / 错误共用一行（文案与配色由代码按状态写） -->
                                <TextBlock x:Name="TblPlaylistStatus" Text="正在加载我的歌单…"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Margin="24,0" Foreground="{StaticResource Mut}" />
                            </Grid>

                            <TextBlock x:Name="TblPlaylistTip" Grid.Row="2" FontSize="11"
                                       Foreground="{StaticResource Mut}" TextWrapping="Wrap" Text=""
                                       Margin="0,8,0,0" />
                        </Grid>

                        <!-- ===== 跟随播放器（FollowPane.vue） ===== -->
                        <ScrollViewer x:Name="PaneFollow" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <Border Style="{StaticResource AccountCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="跟随外部播放器" FontWeight="Bold" />
                                            <TextBlock Text="酷狗 / 网易云 / QQ音乐 等播放器出声，这里只同步进度渲染歌词"
                                                       FontSize="11" Foreground="{StaticResource Mut}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkFollow" Grid.Column="1" VerticalAlignment="Center"
                                                  Style="{StaticResource FollowToggle}"
                                                  ToolTip="酷狗/网易云/QQ音乐等播放器出声，这里只同步进度渲染歌词（SMTC）"
                                                  Checked="ChkFollow_Changed" Unchecked="ChkFollow_Changed" />
                                    </Grid>
                                </Border>

                                <Border x:Name="FollowDetail" Visibility="Collapsed" Margin="0,0,0,12"
                                        Style="{StaticResource AccountCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="TblFollowNow" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock x:Name="TblFollowStatus" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <Button x:Name="BtnRematch" Style="{StaticResource LinkBtn}" Margin="8,0,0,0"
                                                    Visibility="Collapsed" Click="BtnRematch_Click">
                                                <TextBlock Text="重新匹配" TextDecorations="Underline"
                                                           Foreground="{StaticResource Cyan}" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="TblFollowDetail" FontSize="11"
                                                   Foreground="{StaticResource Amber}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" Visibility="Collapsed" />
                                        <Border x:Name="SessionsRow" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="0,1,0,0" Padding="0,4,0,0" Margin="0,8,0,0"
                                                Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="跟随的播放器" FontSize="11"
                                                           Foreground="{StaticResource Mut}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="CmbFollowSession" Grid.Column="1"
                                                          Style="{StaticResource SelSm}"
                                                          SelectedValuePath="AppId" DisplayMemberPath="Label"
                                                          SelectionChanged="CmbFollowSession_Changed" />
                                            </Grid>
                                        </Border>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                                                Padding="0,4,0,0" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="对齐微调" FontSize="11" Foreground="{StaticResource Mut}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button x:Name="BtnNudgeM" Content="-0.5s"
                                                        Style="{StaticResource BtnGhostSm}" Click="BtnNudgeM_Click" />
                                                <Button x:Name="BtnNudgeP" Content="+0.5s"
                                                        Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0"
                                                        Click="BtnNudgeP_Click" />
                                                <Button x:Name="BtnNudgeM5" Content="-5s"
                                                        Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0"
                                                        Visibility="Collapsed" Click="BtnNudgeM5_Click" />
                                                <Button x:Name="BtnNudgeP5" Content="+5s"
                                                        Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0"
                                                        Visibility="Collapsed" Click="BtnNudgeP5_Click" />
                                                <Button x:Name="BtnOffsetReset" Content="重置"
                                                        Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0"
                                                        IsEnabled="False" Click="BtnOffsetReset_Click" />
                                                <TextBlock x:Name="TblOffset" FontSize="11"
                                                           Foreground="{StaticResource Mut}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" Text="" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{StaticResource Line2}" BorderThickness="2,0,0,0"
                                        Padding="10,0,0,0" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="音频由播放器自己出声，本工具只读系统媒体进度；网易云需在 设置→播放和下载 打开「允许在任务栏显示和控制播放」。切歌后自动按 酷狗（逐字）→网易云（逐行）匹配歌词；没匹配到可去「搜索」页手动找，跟随模式下不要点载入歌曲（会带入音频抢时间轴）。 打点 / 切分 / 字幕等工具照常可用。" />
                                </Border>
                                <Border BorderBrush="{StaticResource Line2}" BorderThickness="2,0,0,0"
                                        Padding="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource LinkBtn}" Click="FollowGoSearch_Click">
                                            <TextBlock Text="去搜索页手动找歌" TextDecorations="Underline"
                                                       Foreground="{StaticResource Cyan}" FontSize="11" />
                                        </Button>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="｜跟随开启期间本地循环自动停用，停止跟随后恢复。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== 账号（AccountPane.vue） ===== -->
                        <ScrollViewer x:Name="PaneAccount" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <Border Style="{StaticResource AccountCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2AA4F4" Offset="0" />
                                                    <GradientStop Color="#0B6FD1" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="酷" Foreground="White" FontWeight="Black" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="酷狗音乐" FontWeight="Bold" />
                                            <TextBlock x:Name="TblLoginKg" FontSize="11"
                                                       Foreground="{StaticResource Mut}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="BtnLoginKg" Tag="kugou" Content="扫码登录"
                                                    Style="{StaticResource BtnPrimary}" Click="BtnLogin_Click" />
                                            <Button x:Name="BtnLogoutKg" Tag="kugou" Content="退出登录"
                                                    Style="{StaticResource BtnGhost}" Visibility="Collapsed"
                                                    Click="BtnLogout_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource AccountCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#EC4141" Offset="0" />
                                                    <GradientStop Color="#C01F1F" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="易" Foreground="White" FontWeight="Black" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="网易云音乐" FontWeight="Bold" />
                                            <TextBlock x:Name="TblLoginNe" FontSize="11"
                                                       Foreground="{StaticResource Mut}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="BtnLoginNe" Tag="netease" Content="扫码登录"
                                                    Style="{StaticResource BtnPrimary}" Click="BtnLogin_Click" />
                                            <Button x:Name="BtnLogoutNe" Tag="netease" Content="退出登录"
                                                    Style="{StaticResource BtnGhost}" Visibility="Collapsed"
                                                    Click="BtnLogout_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border BorderBrush="{StaticResource Line2}" BorderThickness="2,0,0,0"
                                        Padding="10,0,0,0">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="登录凭据只保存在本机服务端（config/kg_login.json、ne_login.json），不会上传。" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 扫码登录弹层（AccountPane 的 Teleport：自身的遮罩 + 居中卡片，点空白关闭） -->
        <Grid x:Name="QrPanel" Visibility="Collapsed">
            <Border Background="#99060608" MouseLeftButtonDown="QrMask_Click" />
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1"
                    CornerRadius="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="236">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TblQrTitle" Text="扫码登录" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <Border Width="188" Height="188" CornerRadius="10" Background="White" Margin="0,12,0,0"
                            HorizontalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="QrImg" Width="188" Height="188" />
                            <Border x:Name="QrScanned" Background="#D10A0C0A" CornerRadius="10"
                                    Visibility="Collapsed">
                                <TextBlock Text="已扫码" Foreground="{StaticResource Cyan}" FontWeight="Bold"
                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" LineHeight="26" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TblQrTip" FontSize="12" Foreground="{StaticResource Mut}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" MinHeight="18" Text="" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="BtnQrRefresh" Content="刷新二维码" Style="{StaticResource BtnGhostSm}"
                                Click="BtnQrRefresh_Click" />
                        <Button x:Name="BtnQrClose" Content="关闭" Style="{StaticResource BtnGhostSm}"
                                Margin="8,0,0,0" Click="BtnQrClose_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
