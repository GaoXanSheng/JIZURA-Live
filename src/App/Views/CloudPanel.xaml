<Window x:Class="JizuraLive.App.Views.CloudPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:JizuraLive.App.Controls"
        xmlns:views="clr-namespace:JizuraLive.App.Views"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="{DynamicResource Loc.Cloud.WindowTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 对位旧版 CloudMusicModal.vue：fixed inset-0 遮罩 rgba(6,6,8,.6) + 居中 bg-panel 卡片（min(860px,96vw) × min(600px,88vh)）。 -->
    <Window.Resources>
        <!-- 平台切换分段按钮（CloudMusicModal 头部 酷狗/网易云）：px-3 py-1 text-xs rounded-md hover:bg-white/5 -->
        <Style x:Key="SrcBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧页签（nav button）：选中 = bg-amber/10 + text-amber（Tag="on"），悬停 hover:bg-white/5 + text-fg -->
        <Style x:Key="PaneBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Amber10}" />
                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌曲行容器（SongList.vue 的 li：border-t border-line，首行无分隔线，hover bg-white/5） -->
        <Style x:Key="SongItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                <Setter TargetName="bd" Property="BorderThickness" Value="0" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 整行即按钮（SongList.vue：点歌名即可载入）：无边框透明，悬停交给外层 ListBoxItem -->
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 账号页平台卡片：bg-raised border-line rounded-[10px] p-3.5，hover:border-line2 -->
        <Style x:Key="AccountCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- cyan 下划线文字按钮（跟随页「重新匹配」「去搜索页手动找歌」） -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Cyan}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 空态/占位文案（text-xs mut） -->
        <Style x:Key="EmptyTx" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- 归属筛选条（取代原来的三段标题：虚拟化卡片墙只有一条滚动，塞不进整行标题） -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片墙的容器（ListBox 提供自己的 ScrollViewer，虚拟化靠它） -->
        <Style x:Key="PlaylistCardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌单卡片：悬停提亮 + 上浮 2px（只位移不缩放——逐像素透明窗口缩放要重采样，字会发虚） -->
        <Style x:Key="PlaylistCard" TargetType="Button">
            <Setter Property="Width" Value="204" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBg" Background="{StaticResource Raised}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBg" Property="BorderBrush" Value="{StaticResource Line2}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="-2" Duration="0:0:0.11">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="0" Duration="0:0:0.11" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌单卡片内容（三个分组共用）：色块首字 + 歌单名 + 「N 首 · 创建者」 + 归属徽标 -->
        <DataTemplate x:Key="PlaylistCardTpl">
            <Button Style="{StaticResource PlaylistCard}" Tag="{Binding}" Click="BtnPlaylist_Click"
                    Loaded="Card_Loaded" DataContextChanged="Card_DataChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{Binding Tile}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#D8FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding InitialVisibility}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="13"
                                   Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MetaLine}" ToolTip="{Binding MetaLine}" FontSize="11"
                                   Foreground="{StaticResource Mut}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" BorderThickness="1" CornerRadius="4" Padding="4,0"
                            VerticalAlignment="Top" BorderBrush="{Binding BadgeBrush}"
                            Visibility="{Binding BadgeVisibility}">
                        <TextBlock Text="{Binding Badge}" FontSize="10" LineHeight="14"
                                   Foreground="{Binding BadgeBrush}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 歌曲行（搜索页与歌单详情共用）：播放键(序号) + 歌名 + 歌手/专辑/时长 + VIP + 状态。
             点行本体＝载入工程（老语义不变）；点左边那个键＝试听，之后顺序播下去。
             序号只由歌单详情填（搜索页为空串）。 -->
        <DataTemplate x:Key="SongRowTpl">
            <Button Style="{StaticResource RowBtn}" Tag="{Binding}" Click="BtnLoad_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="52*" />
                        <ColumnDefinition Width="48*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RowPlay" Grid.Column="0" Style="{StaticResource RowPlayBtn}"
                            Tag="{Binding}" Click="BtnRowPlay_Click" VerticalAlignment="Center"
                            ToolTip="{DynamicResource Loc.Cloud.PreviewTip}">
                        <Grid>
                            <TextBlock x:Name="TxIdx" Text="{Binding Index}" FontSize="11"
                                       Foreground="{StaticResource Faint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxGlyph" Text="{Binding PlayGlyph}" FontSize="11"
                                       Foreground="{StaticResource Cyan}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               ToolTip="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SingerLine}"
                               ToolTip="{Binding SingerLine}" FontSize="11"
                               Foreground="{StaticResource Mut}"
                               TextTrimming="CharacterEllipsis" Margin="8,0,8,0"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="3" BorderBrush="#8A6D2F" BorderThickness="1"
                            CornerRadius="4" Padding="4,0" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding VipVisibility}">
                        <TextBlock Text="VIP" FontSize="10" LineHeight="15"
                                   Foreground="#C8A24A" />
                    </Border>
                    <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="11"
                               Foreground="{StaticResource Cyan}"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <!-- 悬停该行：序号让位给播放键图标 -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                             Value="True">
                    <Setter TargetName="TxIdx" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TxGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- 正在试听的那一行：常显图标（▶/⏸） -->
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="RowPlay" Property="ToolTip" Value="{DynamicResource Loc.Cloud.PreviewToggleTip}" />
                    <Setter TargetName="TxIdx" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TxGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 全窗遮罩 rgba(6,6,8,.6)，点空白关窗（对位 @click.self="cloud.open = false"） -->
        <Border x:Name="Mask" Background="#99060608" MouseLeftButtonDown="Mask_Click" />

        <!-- 居中卡片 -->
        <Border x:Name="Card" Width="860" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1"
                CornerRadius="16" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部：标题 + 平台切换 + 关闭 -->
                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                        Padding="18,14">
                    <DockPanel LastChildFill="False">
                        <ctl:JzLabel DockPanel.Dock="Left" Text="{DynamicResource Loc.Cloud.WindowTitle}" Tracking="0.05"
                                     TextElement.FontSize="15" TextElement.FontWeight="SemiBold"
                                     TextElement.Foreground="{StaticResource Fg}" VerticalAlignment="Center" />
                        <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="✕" Style="{StaticResource BtnIcon}"
                                Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{DynamicResource Loc.Cloud.Close}"
                                Click="BtnClose_Click" />
                        <Border DockPanel.Dock="Right" Background="{StaticResource Raised}"
                                BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8"
                                Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnKugou" Content="{DynamicResource Loc.Cloud.SourceKugou}" Style="{StaticResource SrcBtn}"
                                        Margin="0,0,2,0" Click="BtnSource_Click" />
                                <Button x:Name="BtnNetease" Content="{DynamicResource Loc.Cloud.SourceNetease}" Style="{StaticResource SrcBtn}"
                                        Click="BtnSource_Click" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 主体：左侧页签 + 内容区 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="144" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#26000000" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,1,0" Padding="10">
                        <StackPanel VerticalAlignment="Top">
                            <Button x:Name="NavSearch" Content="{DynamicResource Loc.Cloud.Search}" Style="{StaticResource PaneBtn}" Tag="on"
                                    Click="Nav_Click" />
                            <Button x:Name="NavPlaylists" Content="{DynamicResource Loc.Cloud.NavPlaylists}" Style="{StaticResource PaneBtn}"
                                    Click="Nav_Click" />
                            <Button x:Name="NavAccount" Content="{DynamicResource Loc.Cloud.NavAccount}" Style="{StaticResource PaneBtn}"
                                    Click="Nav_Click" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="16,14">
                        <!-- ===== 搜索页（SearchPane.vue） ===== -->
                        <Grid x:Name="PaneSearch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="TbQuery" KeyDown="TbQuery_KeyDown" />
                                    <TextBlock Text="{DynamicResource Loc.Cloud.SearchPlaceholder}" Foreground="{StaticResource Faint}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TbQuery}"
                                                                 Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ComboBox x:Name="CmbQuality" Grid.Column="1" Width="92" Margin="8,0,0,0"
                                          SelectionChanged="CmbQuality_Changed"
                                          ToolTip="{DynamicResource Loc.Cloud.Quality.Tip}" />
                                <Button x:Name="BtnSearch" Grid.Column="2" Content="{DynamicResource Loc.Cloud.Search}" Margin="8,0,0,0"
                                        Style="{StaticResource BtnPrimary}" Click="BtnSearch_Click" />
                                <TextBlock x:Name="TblSearchInfo" Grid.Column="3" Margin="10,0,2,0" FontSize="11"
                                           Foreground="{StaticResource Mut}" VerticalAlignment="Center" Text="" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="6" ClipToBounds="True">
                                    <ListBox x:Name="Lst" Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource SongItem}"
                                             ItemTemplate="{StaticResource SongRowTpl}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.VirtualizationMode="Recycling" />
                                </Border>
                                <TextBlock Text="{DynamicResource Loc.Cloud.SearchEmpty}"
                                           VerticalAlignment="Center" Foreground="{StaticResource Mut}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyTx}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=Lst}"
                                                             Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- ===== 我的歌单（PlaylistPane.vue：我的歌单列表 + 粘贴链接/ID 载入） ===== -->
                        <Grid x:Name="PanePlaylists" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="TbPlaylist" KeyDown="TbPlaylist_KeyDown" />
                                    <TextBlock Text="{DynamicResource Loc.Cloud.PlaylistPlaceholder}" Foreground="{StaticResource Faint}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TbPlaylist}"
                                                                 Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button x:Name="BtnPlaylistLoad" Grid.Column="1" Content="{DynamicResource Loc.Cloud.Load}" Margin="8,0,0,0"
                                        Click="BtnPlaylistLoad_Click" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="ChipAll" Style="{StaticResource ChipBtn}" Tag="all"
                                            Click="ChipFilter_Click" />
                                    <Button x:Name="ChipMine" Style="{StaticResource ChipBtn}" Tag="mine"
                                            Click="ChipFilter_Click" />
                                    <Button x:Name="ChipSub" Style="{StaticResource ChipBtn}" Tag="sub"
                                            Click="ChipFilter_Click" />
                                    <Button x:Name="ChipLiked" Style="{StaticResource ChipBtn}" Tag="liked"
                                            Click="ChipFilter_Click" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <!-- 虚拟化换行面板：只实例化视口内的卡片（滚动时回收复用），
                                         封面在容器实例化时才加载（见 Card_Realized） -->
                                    <ListBox x:Name="LstPlaylists" Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource PlaylistCardItem}"
                                             ItemTemplate="{StaticResource PlaylistCardTpl}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <vwp:VirtualizingWrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <!-- 空态 / 加载中 / 错误共用一行（文案与配色由代码按状态写） -->
                                    <TextBlock x:Name="TblPlaylistStatus" Text="{DynamicResource Loc.Cloud.PlaylistLoading}"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Margin="24,0" Foreground="{StaticResource Mut}" />
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="TblPlaylistTip" Grid.Row="2" FontSize="11"
                                       Foreground="{StaticResource Mut}" TextWrapping="Wrap" Text=""
                                       Margin="0,8,0,0" />
                        </Grid>

                        <!-- ===== 歌单详情（点卡片进来；不再把歌曲灌进搜索页） ===== -->
                        <Grid x:Name="PanePlaylistDetail" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnDetailBack" Grid.Column="0" Style="{StaticResource BtnGhost}"
                                        Content="{DynamicResource Loc.Cloud.DetailBack}" Padding="8,4"
                                        VerticalAlignment="Center" Click="BtnDetailBack_Click" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TblDetailName" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TblDetailMeta" FontSize="11" Foreground="{StaticResource Mut}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="BtnPlayAll" Grid.Column="2" Style="{StaticResource BtnPrimary}"
                                        Content="{DynamicResource Loc.Cloud.PlayAll}" Padding="12,4"
                                        VerticalAlignment="Center" Click="BtnPlayAll_Click"
                                        ToolTip="{DynamicResource Loc.Cloud.PlayAllTip}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="6" ClipToBounds="True">
                                    <ListBox x:Name="LstDetail" Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource SongItem}"
                                             ItemTemplate="{StaticResource SongRowTpl}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.VirtualizationMode="Recycling" />
                                </Border>
                                <TextBlock x:Name="TblDetailStatus" TextAlignment="Center" TextWrapping="Wrap"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Margin="24,0" Foreground="{StaticResource Mut}" Text="" />
                            </Grid>
                        </Grid>

                        <!-- ===== 账号（AccountPane.vue） ===== -->
                        <ScrollViewer x:Name="PaneAccount" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <Border Style="{StaticResource AccountCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2AA4F4" Offset="0" />
                                                    <GradientStop Color="#0B6FD1" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{DynamicResource Loc.Cloud.LogoKugou}" Foreground="White" FontWeight="Black" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc.Cloud.AccountKugou}" FontWeight="Bold" />
                                            <TextBlock x:Name="TblLoginKg" FontSize="11"
                                                       Foreground="{StaticResource Mut}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="BtnLoginKg" Tag="kugou" Content="{DynamicResource Loc.Cloud.Login}"
                                                    Style="{StaticResource BtnPrimary}" Click="BtnLogin_Click" />
                                            <Button x:Name="BtnLogoutKg" Tag="kugou" Content="{DynamicResource Loc.Cloud.Logout}"
                                                    Style="{StaticResource BtnGhost}" Visibility="Collapsed"
                                                    Click="BtnLogout_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource AccountCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#EC4141" Offset="0" />
                                                    <GradientStop Color="#C01F1F" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{DynamicResource Loc.Cloud.LogoNetease}" Foreground="White" FontWeight="Black" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc.Cloud.AccountNetease}" FontWeight="Bold" />
                                            <TextBlock x:Name="TblLoginNe" FontSize="11"
                                                       Foreground="{StaticResource Mut}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="BtnLoginNe" Tag="netease" Content="{DynamicResource Loc.Cloud.Login}"
                                                    Style="{StaticResource BtnPrimary}" Click="BtnLogin_Click" />
                                            <Button x:Name="BtnLogoutNe" Tag="netease" Content="{DynamicResource Loc.Cloud.Logout}"
                                                    Style="{StaticResource BtnGhost}" Visibility="Collapsed"
                                                    Click="BtnLogout_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border BorderBrush="{StaticResource Line2}" BorderThickness="2,0,0,0"
                                        Padding="10,0,0,0">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="{DynamicResource Loc.Cloud.CredentialHint}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 试听条：与主界面底部那条是同一个控件（Compact 去掉音量），
                     数据源都是全局的 CloudPlayService -->
                <views:CloudBar x:Name="BarCloud" Grid.Row="2" Compact="True" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 扫码登录弹层（AccountPane 的 Teleport：自身的遮罩 + 居中卡片，点空白关闭） -->
        <Grid x:Name="QrPanel" Visibility="Collapsed">
            <Border Background="#99060608" MouseLeftButtonDown="QrMask_Click" />
            <!-- 阴影独立一层、卡片本身不带 Effect：Effect 子树会先光栅成中间面且不用 ClearType，
                 卡片里的文字跟着一起糊（MessageDialog 同款规避；两层同格即同尺寸） -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="236">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1"
                        CornerRadius="16">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="8" Opacity="0.5" />
                    </Border.Effect>
                </Border>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1"
                        CornerRadius="16" Padding="24">
                    <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TblQrTitle" Text="{DynamicResource Loc.Cloud.Login}" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <Border Width="188" Height="188" CornerRadius="10" Background="White" Margin="0,12,0,0"
                            HorizontalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="QrImg" Width="188" Height="188" />
                            <Border x:Name="QrScanned" Background="#D10A0C0A" CornerRadius="10"
                                    Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Loc.Cloud.QrScanned}" Foreground="{StaticResource Cyan}" FontWeight="Bold"
                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" LineHeight="26" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TblQrTip" FontSize="12" Foreground="{StaticResource Mut}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" MinHeight="18" Text="" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="BtnQrRefresh" Content="{DynamicResource Loc.Cloud.QrRefresh}" Style="{StaticResource BtnGhostSm}"
                                Click="BtnQrRefresh_Click" />
                        <Button x:Name="BtnQrClose" Content="{DynamicResource Loc.Cloud.Close}" Style="{StaticResource BtnGhostSm}"
                                Margin="8,0,0,0" Click="BtnQrClose_Click" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
