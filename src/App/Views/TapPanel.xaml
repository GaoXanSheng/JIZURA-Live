<UserControl x:Class="JizuraLive.App.Views.TapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 暗色下拉（本文件本地资源；Theme.xaml 尚无 ComboBox 模板） -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource Raised}"
                                                BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="4">
                                            <Path Data="M 0 0 L 3.5 3.5 L 7 0" Stroke="{StaticResource Mut}" StrokeThickness="1.4"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Faint}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="7,2,20,2" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   StaysOpen="False" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Raised2}" BorderBrush="{StaticResource Line2}"
                                        BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,2,8,8">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
        </Style>
    </UserControl.Resources>

    <!-- 打点中的浮层（对位 TapPanel.vue v-if="active"：琥珀 8% 叠在面板色上 + 琥珀描边圆角） -->
    <Border x:Name="Root" Visibility="Collapsed" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Amber}" BorderThickness="1" CornerRadius="10"
            Margin="12,12,12,0" Padding="10">
        <Grid>
            <Border Background="{StaticResource Amber}" Opacity="0.08" CornerRadius="9" />
            <StackPanel>
                <!-- 提示（打点 3 步内显示，compact 后收起） -->
                <TextBlock x:Name="HintBox" Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Text="{DynamicResource Loc.Tap.Hint}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Loc.Tap.NextLine}" FontSize="15" Foreground="{StaticResource Fg}" />
                    <TextBlock x:Name="TblLine" Text="—" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Fg}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- TAP 大按钮（琥珀底深字，对位 Vue !bg-amber !text-[#120c00]） -->
                <Button x:Name="BtnTap" Content="TAP" Click="BtnTap_Click" Height="52"
                        FontFamily="Consolas" FontSize="17" FontWeight="Bold" Cursor="Hand"
                        Background="{StaticResource Amber}" Foreground="#FF120C00">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!-- hover:!bg-[#ffb52a] -->
                                    <Setter TargetName="bd" Property="Background" Value="#FFFFB52A" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{DynamicResource Loc.Tap.Rate}" FontSize="11" Foreground="{StaticResource Mut}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbRate" Style="{StaticResource DarkCombo}" Width="70" Height="26"
                              SelectedIndex="0" SelectionChanged="CmbRate_SelectionChanged"
                              ToolTip="{DynamicResource Loc.Tap.Rate.Tip}"
                              IsEnabled="False">
                        <ComboBoxItem Content="1×" />
                        <ComboBoxItem Content="0.75×" />
                        <ComboBoxItem Content="0.5×" />
                    </ComboBox>
                    <CheckBox x:Name="ChkCount" Content="{DynamicResource Loc.Tap.Count}" Margin="12,0,0,0" VerticalAlignment="Center"
                              ToolTip="{DynamicResource Loc.Tap.Count.Tip}" Checked="ChkCount_Changed" Unchecked="ChkCount_Changed" />
                </StackPanel>
                <Button x:Name="BtnBack" Content="{DynamicResource Loc.Tap.Back}" Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="BtnBack_Click" />
                <Button x:Name="BtnStop" Content="{DynamicResource Loc.Tap.Stop}" Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Stretch" Margin="0,2,0,0" Click="BtnStop_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
