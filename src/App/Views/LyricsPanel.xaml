<UserControl x:Class="JizuraLive.App.Views.LyricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JizuraLive.App.Controls">
    <!-- 对位 LyricsPanel.vue：.sec（px-4 py-3.5 gap-2.5 border-b） -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="16,14">
        <StackPanel>
            <!-- .sec-h：标题 + 读取 LRC / 清空歌词 / 记法 -->
            <Grid Margin="0,0,0,10">
                <ctl:JzLabel Text="{DynamicResource Loc.Lyrics.Header}" Tracking="0.18" TextElement.FontSize="11"
                             TextElement.FontWeight="SemiBold"
                             TextElement.Foreground="{StaticResource Mut}" HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Loc.Lyrics.LoadLrc}" Style="{StaticResource BtnGhostSm}" Click="BtnLoadLrc_Click"
                            ToolTip="{DynamicResource Loc.Lyrics.LoadLrc.Tip}" />
                    <Button Content="{DynamicResource Loc.Lyrics.Clear}" Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0" Click="BtnClear_Click"
                            ToolTip="{DynamicResource Loc.Lyrics.Clear.Tip}" />
                    <Button x:Name="BtnSyntax" Content="{DynamicResource Loc.Lyrics.Syntax}" Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0"
                            Click="BtnSyntax_Click" ToolTip="{DynamicResource Loc.Lyrics.Syntax.Tip}" />
                </StackPanel>
            </Grid>
            <!-- 歌词正文（1 行 = 1 短语）；输入经 260ms 防抖 Mutate（对位 onInput 的 replanSoon(260)） -->
            <TextBox x:Name="TbLyrics" Style="{StaticResource Ta}" Height="214"
                     TextWrapping="Wrap" TextChanged="TbLyrics_TextChanged"
                     ToolTip="{DynamicResource Loc.Lyrics.Box.Tip}" />
            <!-- 歌词语言 + 自动判定结果 -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource Loc.Lyrics.Lang}" FontSize="11" Foreground="{StaticResource Mut}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbLang" Style="{StaticResource SelSm}" MinWidth="104"
                          SelectionChanged="CmbLang_SelectionChanged" />
                <TextBlock x:Name="TblLangNote" FontSize="11" Foreground="{StaticResource Mut}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <!-- 音译 / 翻译（云端歌词装载时是否写入注音） -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="CkRoma" Content="{DynamicResource Loc.Lyrics.Roma}" FontSize="12" Checked="LyricOpt_Changed"
                          Unchecked="LyricOpt_Changed"
                          ToolTip="{DynamicResource Loc.Lyrics.Roma.Tip}" />
                <CheckBox x:Name="CkTrans" Content="{DynamicResource Loc.Lyrics.Trans}" FontSize="12" Margin="14,0,0,0" Checked="LyricOpt_Changed"
                          Unchecked="LyricOpt_Changed"
                          ToolTip="{DynamicResource Loc.Lyrics.Trans.Tip}" />
            </StackPanel>
            <!-- 记法说明（对位 syntaxOpen 折叠块：bg-raised 圆角 6 + 12px mut 文案） -->
            <Border x:Name="SyntaxBox" Visibility="Collapsed" Background="{StaticResource Raised}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="12,10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="{DynamicResource Loc.Lyrics.Help.Plain}" />
                    <TextBlock Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="{DynamicResource Loc.Lyrics.Help.Slash}" />
                    <TextBlock Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="{DynamicResource Loc.Lyrics.Help.Em}" />
                    <TextBlock Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="{DynamicResource Loc.Lyrics.Help.Bang}" />
                    <TextBlock Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="{DynamicResource Loc.Lyrics.Help.Pipe}" />
                    <TextBlock Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="{DynamicResource Loc.Lyrics.Help.LrcTime}" />
                    <TextBlock Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="{DynamicResource Loc.Lyrics.Help.Interlude}" />
                    <TextBlock Foreground="{StaticResource Mut}" FontSize="12" TextWrapping="Wrap"
                               Text="{DynamicResource Loc.Lyrics.Help.Comment}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
