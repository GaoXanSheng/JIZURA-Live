<UserControl x:Class="JizuraLive.App.Views.CutInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JizuraLive.App.Views">
    <!-- 对位 CutInfo.vue：信息行（chips）+ 手法替换面板（点 chip 弹出的候选网格）。
         chips 与面板内容全部在 code-behind 里重建；面板结构（标题行 + 可滚候选网格）在下面。 -->
    <StackPanel>
        <local:FlexWrapRow x:Name="Row" Gap="6" MinHeight="26" />

        <!-- 替换面板（对位 .cut-pick：border-line rounded-md bg-panel max-h-[min(42vh,420px)] 内部滚动）。
             固定头 + 内部滚动区；滚动容器不带顶部 padding（否则滚动内容会从 sticky 头上方穿出）。 -->
        <Border x:Name="Pick" Visibility="Collapsed" Margin="0,8,0,0"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,8,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TblPickTitle" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Loc.CutInfo.Pick.Sub}" FontSize="11"
                               Foreground="{StaticResource Mut}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Grid Grid.Column="3">
                        <TextBox x:Name="TbPickSearch" Width="112" Style="{StaticResource TbNum}"
                                 ToolTip="{DynamicResource Loc.CutInfo.Pick.SearchTip}"
                                 AutomationProperties.Name="{DynamicResource Loc.CutInfo.Pick.Search}"
                                 TextChanged="PickSearch_TextChanged" />
                        <TextBlock x:Name="TbPickHint" Text="{DynamicResource Loc.CutInfo.Pick.Search}"
                                   FontSize="12" Foreground="{StaticResource Faint}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Button x:Name="BtnPickAuto" Grid.Column="4" Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0"
                            Content="{DynamicResource Loc.CutInfo.Pick.Auto}" Click="PickAuto_Click" />
                    <Button x:Name="BtnPickClose" Grid.Column="5" Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0"
                            Content="✕" ToolTip="{DynamicResource Loc.CutInfo.Pick.Close}" Click="PickClose_Click" />
                </Grid>
                <ScrollViewer x:Name="PickScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="PickGrid" Margin="10,0,4,10" />
                </ScrollViewer>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
