<UserControl x:Class="JizuraLive.App.Views.CutInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 对位 CutInfo.vue 的信息行：当前切分手法 chips（#序号 + 布局/入场/保持/退场/装饰/文字处理/
         背景/运镜/转场），无切分时显示提示。手法替换面板（chips 点击出候选）属后续里程碑 -->
    <Grid MinHeight="26">
        <TextBlock x:Name="TblNone" Text="此位置没有切分" FontSize="11" VerticalAlignment="Center"
                   Foreground="{StaticResource Faint}" Visibility="Collapsed" />
        <WrapPanel x:Name="Chips" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</UserControl>
