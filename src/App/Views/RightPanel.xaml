<UserControl x:Class="JizuraLive.App.Views.RightPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JizuraLive.App.Views">
    <TabControl Background="Transparent" BorderThickness="0" Padding="0">
        <TabItem Header="风格" Style="{StaticResource TabHeader}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:StyleTab Margin="10,4" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="特效" Style="{StaticResource TabHeader}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:FxTab Margin="10,4" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="手法" Style="{StaticResource TabHeader}">
            <views:TechTab />
        </TabItem>
        <TabItem Header="设置" Style="{StaticResource TabHeader}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:SettingsTab Margin="10,4" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="导出" Style="{StaticResource TabHeader}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:OutTab Margin="10,4" />
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
