<UserControl x:Class="JizuraLive.App.Views.RightPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JizuraLive.App.Views">
    <!-- PV 合成控制台：等宽页签（sticky top，选中等宽下边框琥珀）+ 内容；默认激活 PV 页签 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <UniformGrid x:Name="TabGrid" Columns="5">
                <Button x:Name="TabStyle" Content="{DynamicResource Loc.RightPanel.TabStyle}" Style="{StaticResource TabHeader}"
                        Click="Tab_Click" />
                <Button x:Name="TabFx" Content="{DynamicResource Loc.RightPanel.TabFx}" Style="{StaticResource TabHeader}" Click="Tab_Click" />
                <Button x:Name="TabTech" Content="{DynamicResource Loc.RightPanel.TabTech}" Style="{StaticResource TabHeader}" Click="Tab_Click" />
                <Button x:Name="TabPv" Content="{DynamicResource Loc.RightPanel.TabPv}" Style="{StaticResource TabHeader}" Tag="on"
                        Click="Tab_Click" />
                <Button x:Name="TabSettings" Content="{DynamicResource Loc.RightPanel.TabSettings}" Style="{StaticResource TabHeader}" Click="Tab_Click" />
            </UniformGrid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="HostStyle" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <views:StyleTab Margin="16,12" />
            </ScrollViewer>
            <ScrollViewer x:Name="HostFx" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <views:FxTab x:Name="Fx" Margin="16,12" />
            </ScrollViewer>
            <Grid x:Name="HostTech" Visibility="Collapsed">
                <views:TechTab />
            </Grid>
            <ScrollViewer x:Name="HostPv" VerticalScrollBarVisibility="Auto">
                <views:PvTab x:Name="Pv" Margin="16,12" />
            </ScrollViewer>
            <ScrollViewer x:Name="HostSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <views:SettingsTab Margin="16,12" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
