<UserControl x:Class="JizuraLive.App.Views.FxTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JizuraLive.App.Controls">
    <UserControl.Resources>
        <!-- 参数滑块（暗色轨道 + Amber 进度/拇指，对位旧版 range 观感） -->
        <Style x:Key="FxSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.01" />
            <Setter Property="LargeChange" Value="0.1" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2,0,0,2" Background="{StaticResource Amber}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="0,2,2,0" Background="{StaticResource Raised2}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="thumb" Width="12" Height="12" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource Amber}" Stroke="{StaticResource Ink}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 锁定图标（btn-icon svg 的 16 视图框锁形，stroke 1.4 随按钮前景；x:Shared=False 每个按钮一份） -->
        <Viewbox x:Key="FxLock" x:Shared="False" Width="15" Height="15">
            <Canvas Width="16" Height="16">
                <Path Data="{StaticResource IconLockBody}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
                <Path Data="{StaticResource IconLockPath}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" />
            </Canvas>
        </Viewbox>

        <!-- 锁定小按钮（.btn.btn-icon.btn-ghost；锁定 = !text-amber + 琥珀描边） -->
        <Style x:Key="LockBtn" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Width" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 统一感 / 文字排列（.flex flex-col gap-1.5 mb-3 pb-1.5 border-b border-line） -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="0,0,0,6" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ToggleButton x:Name="CkUnify" Style="{StaticResource Switch}"
                                  Checked="Unify_Changed" Unchecked="Unify_Changed" />
                    <TextBlock Text="统一感" FontSize="12" LineHeight="18" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="CkTypeset" Style="{StaticResource Switch}"
                                  Checked="Typeset_Changed" Unchecked="Typeset_Changed" />
                    <TextBlock Text="文字排列" FontSize="12" LineHeight="18" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- fx 参数滑块（代码生成 7 行，对位 FX 表：96px | 滑块 | 36px | 30px，行距 8） -->
        <Grid x:Name="SliderRows" />

        <!-- 闪光 + 抽帧（.row mt-1.5） -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <CheckBox x:Name="CkFlash" Content="闪光" VerticalAlignment="Center" Margin="0,0,8,0"
                      Checked="Flash_Changed" Unchecked="Flash_Changed" />
            <TextBlock Text="抽帧" FontSize="12" Foreground="{StaticResource Mut}" VerticalAlignment="Center"
                       Margin="6,0,8,0" />
            <ComboBox x:Name="CbKoma" Style="{StaticResource SelSm}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      SelectionChanged="CbKoma_SelectionChanged"
                      ToolTip="动效每秒画多少张（与导出 fps 无关）" />
            <Button x:Name="BtnKomaLock" Style="{StaticResource LockBtn}" Content="{StaticResource FxLock}"
                    Click="BtnKomaLock_Click" ToolTip="锁定：一键随机/重抽不改动此项" />
        </StackPanel>

        <!-- HUD / 种子 / 新种子（.grid grid-cols-3 gap-2 mt-3） -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="HUD" Style="{StaticResource FieldLab}" Margin="0,0,0,4" />
                <ComboBox x:Name="CbHud" SelectionChanged="CbHud_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="种子" Style="{StaticResource FieldLab}" Margin="0,0,0,4" />
                <TextBox x:Name="TbSeed" Style="{StaticResource TbNum}" LostFocus="TbSeed_Commit"
                         KeyDown="TbSeed_KeyDown" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="&#160;" Style="{StaticResource FieldLab}" Margin="0,0,0,4" />
                <Button x:Name="BtnNewSeed" Content="新种子" Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Left" Click="BtnNewSeed_Click" />
            </StackPanel>
        </Grid>

        <!-- 隐藏装饰编号/时刻（.flex flex-col gap-1.5 mt-3） -->
        <StackPanel Margin="0,12,0,0">
            <CheckBox x:Name="CkHideNo" Content="不显示装饰编号（No.01 等；歌词里的数字保留）"
                      Margin="0,0,0,6" Checked="HideDeco_Changed" Unchecked="HideDeco_Changed" />
            <CheckBox x:Name="CkHideTime" Content="不显示装饰时刻（00:12.34 等；歌词里的时刻保留）"
                      Checked="HideDeco_Changed" Unchecked="HideDeco_Changed" />
        </StackPanel>

        <!-- .note（text-xs mut + border-l-2 line2 + pl-2.5 mt-3） -->
        <Border BorderBrush="{StaticResource Line2}" BorderThickness="2,0,0,0" Padding="10,0,0,0"
                Margin="0,12,0,0">
            <TextBlock Style="{StaticResource NoteTx}"
                       Text="相同的种子会生成相同的编排。逐行“重新随机”和“锁定”请在左侧行列表中操作。" />
        </Border>

        <!-- 音频特效（对位 Dialogs.vue 的音频特效弹窗：预设 + 效果单元开关） -->
        <ctl:JzLabel Text="音频特效" Tracking="0.14" TextElement.FontSize="11"
                     TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Mut}"
                     Margin="0,16,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="预设" FontSize="12" Foreground="{StaticResource Mut}" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="CbAfxPreset" Grid.Column="1" SelectionChanged="CbAfxPreset_SelectionChanged"
                      ToolTip="一键写整条效果链" />
        </Grid>
        <StackPanel x:Name="AfxUnitRows" Margin="0,8,0,0" />
        <Border BorderBrush="{StaticResource Line2}" BorderThickness="2,0,0,0" Padding="10,0,0,0"
                Margin="0,8,0,0">
            <TextBlock Style="{StaticResource NoteTx}"
                       Text="效果按顺序串联；预览与导出 MP4/WAV 同时生效。变速与 EQ 曲线调节在 M4 随音频链接入。" />
        </Border>
    </StackPanel>
</UserControl>
