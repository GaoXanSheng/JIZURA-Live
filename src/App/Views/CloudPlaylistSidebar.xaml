<UserControl x:Class="JizuraLive.App.Views.CloudPlaylistSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- 播放器模式的左侧歌单栏（对位酷狗音乐歌曲页左边的"我的歌单"）：
         点歌单 = 整单从第一首播；点左边的小箭头 = 展开曲目（懒加载）；点曲目 = 从这首开始播。
         封面走同一份 CoverCache（内存 + 磁盘），与云音乐面板共用。 -->
    <UserControl.Resources>
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 展开箭头：命中区给足（16px 的图标 + 4px 内边距，手指/鼠标都好点） -->
        <Style x:Key="ChevronBtn" TargetType="Button" BasedOn="{StaticResource RowBtn}">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
        </Style>
        <Style x:Key="SongRowBtn" TargetType="Button" BasedOn="{StaticResource RowBtn}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}">
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="14,12,14,8">
                    <TextBlock Text="{DynamicResource Loc.Cloud.NavPlaylists}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnKg" Content="{DynamicResource Loc.Cloud.SourceKugou}"
                                Style="{StaticResource SegBtn}" Tag="on" Margin="0,0,6,0" Click="BtnSource_Click" />
                        <Button x:Name="BtnNe" Content="{DynamicResource Loc.Cloud.SourceNetease}"
                                Style="{StaticResource SegBtn}" Click="BtnSource_Click" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListBox x:Name="Lst" Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- 歌单行：小箭头展开 / 封面 + 名字 + N 首 / 右侧播放提示 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource ChevronBtn}" Tag="{Binding}"
                                                Click="BtnExpand_Click" VerticalAlignment="Center">
                                            <Path Data="{Binding Chevron}" Fill="{StaticResource Mut}"
                                                  Width="9" Height="9" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource RowBtn}" Tag="{Binding}"
                                                Click="BtnPlaylist_Click" Margin="2,0,0,0"
                                                ToolTip="{DynamicResource Loc.Cloud.PlayerPlaylistTip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="7"
                                                        Background="{Binding Tile}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontSize="15" Foreground="#D8FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding InitialVisibility}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                               FontSize="13" Foreground="{StaticResource Fg}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MetaLine}" FontSize="11"
                                                               Foreground="{StaticResource Mut}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="10"
                                                   Foreground="{Binding BadgeBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding BadgeVisibility}" />
                                    </Grid>
                                    <!-- 展开后的曲目（懒加载）：点曲目从这首开始播 -->
                                    <ItemsControl ItemsSource="{Binding Songs}" Margin="24,0,0,4"
                                                  Visibility="{Binding SongsVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SongRowBtn}" Tag="{Binding}"
                                                        Click="BtnSong_Click" ToolTip="{Binding Name}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11"
                                                                   Foreground="{StaticResource Faint}" MinWidth="20"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Dur}" FontSize="11"
                                                                   Foreground="{StaticResource Faint}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{DynamicResource Loc.Cloud.PlaylistReading}" FontSize="11"
                                               Foreground="{StaticResource Faint}" Margin="24,0,0,6"
                                               Visibility="{Binding SongsLoadingVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="TblStatus" Text="{DynamicResource Loc.Cloud.PlaylistLoading}"
                               TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Margin="20,0" Foreground="{StaticResource Mut}" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
