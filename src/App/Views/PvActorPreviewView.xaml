<UserControl x:Class="JizuraLive.App.Views.PvActorPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource BtnGhostSm}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}"
            BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="8">
        <StackPanel>
            <!-- 视口标题 + 独立弹窗按钮 -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="角色动效监视器" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                    <TextBlock x:Name="TblActorStatus" Text="（实时节拍协同）" FontSize="11" Foreground="{StaticResource Mut}" Margin="4,1,0,0" />
                </StackPanel>
                <Button x:Name="BtnPopOut" Grid.Column="1" Style="{StaticResource MiniBtn}"
                        Content="⤢ 独立窗口" ToolTip="在新窗口中独立监视角色动效与姿态" Click="BtnPopOut_Click" />
            </Grid>

            <!-- 16:9 取景预览框 -->
            <Border Background="#FF0D0D11" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True" Height="140">
                <Grid>
                    <!-- 十字参考准心与安全网格 -->
                    <Path Stroke="#1FFFFFFF" StrokeThickness="1" StrokeDashArray="4,4"
                          Data="M 0,70 L 600,70 M 150,0 L 150,300" IsHitTestVisible="False" />

                    <!-- 角色渲染承载图元 -->
                    <Image x:Name="ImgViewport" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />

                    <!-- 无源时的贴心指引提示 -->
                    <TextBlock x:Name="TblEmptyHint" Text="未接入外部源（显示虚拟模特配合预览）"
                               FontSize="11" Foreground="#44FFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="0,0,0,6" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- 调试与交互快捷控制条 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBeatTap" Grid.Column="0" Style="{StaticResource MiniBtn}"
                        Content="⚡ 模拟重音" ToolTip="点击触发一次重音打击，测试角色弹性下沉与光影爆发"
                        Click="BtnBeatTap_Click" />

                <CheckBox x:Name="CkSimulateBounce" Grid.Column="1" Margin="8,0,0,0" IsChecked="True"
                          VerticalAlignment="Center" ToolTip="开启/暂停视口内的节拍下沉律动">
                    <TextBlock Text="节拍律动" FontSize="11" Foreground="{StaticResource Mut}" />
                </CheckBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BPM" FontSize="10" Foreground="{StaticResource Mut}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider x:Name="SlBpm" Minimum="60" Maximum="200" Value="130" Width="60"
                            SmallChange="1" LargeChange="5" Style="{StaticResource FxSlider}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TblBpmVal" Text="130" FontSize="10" Style="{StaticResource MonoMut}"
                               Width="24" TextAlignment="Right" VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
