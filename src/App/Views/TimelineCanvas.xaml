<UserControl x:Class="JizuraLive.App.Views.TimelineCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JizuraLive.App.Views">
    <!-- 对位 TimelineCanvas.vue：提示行 + 三带（上条视图滑动 16px / 中条播放头 20px / 下条本体 60px，
         三带合进一个 TimelineSurface 自绘；本体带一圈 1px border-line，对位 body canvas 的 border）。
         提示行：左侧 11px mut 说明（整句单键，Shift 直排句中），右侧「撤销 − ＋ 全部」一组 btn-ghost btn-sm。
         Vue 原 DOM 顺序（两块根节点）：div.flex.justify-between.my-2.mb-1 → 提示 + 按钮；div.flex.flex-col → 三块 canvas。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- my-2 mb-1（上 8 / 下 4）+ justify-between items-center gap-2 -->
        <DockPanel Grid.Row="0" Margin="0,8,0,4" LastChildFill="True">
            <!-- ml-auto flex gap-1（4px）：一组 btn-ghost btn-sm；两个缩放键 min-w-7（28px） -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="{DynamicResource Loc.Timeline.Undo}" Style="{StaticResource BtnGhostSm}" Click="OnUndo"
                        ToolTip="{DynamicResource Loc.Timeline.Undo.Tip}" />
                <Button Content="−" Style="{StaticResource BtnGhostSm}" MinWidth="28" Margin="4,0,0,0"
                        Click="OnZoomOut" ToolTip="{DynamicResource Loc.Timeline.ZoomOut.Tip}"
                        AutomationProperties.Name="{DynamicResource Loc.Timeline.ZoomOut.Name}" />
                <Button Content="＋" Style="{StaticResource BtnGhostSm}" MinWidth="28" Margin="4,0,0,0"
                        Click="OnZoomIn" ToolTip="{DynamicResource Loc.Timeline.ZoomIn.Tip}"
                        AutomationProperties.Name="{DynamicResource Loc.Timeline.ZoomIn.Name}" />
                <Button Content="{DynamicResource Loc.Timeline.All}" Style="{StaticResource BtnGhostSm}" Margin="4,0,0,0"
                        Click="OnZoomAll" ToolTip="{DynamicResource Loc.Timeline.All.Tip}" />
            </StackPanel>
            <!-- text-[11px] text-mut；整句单键（Shift 字样保留在句中） -->
            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Mut}"
                       TextTrimming="CharacterEllipsis" Text="{DynamicResource Loc.Timeline.Hint}" />
        </DockPanel>
        <!-- 三带：16 + 20 + 60（本体 60 含 1px 边框，对位 canvas 的 box-sizing: border-box） -->
        <local:TimelineSurface x:Name="Surface" Grid.Row="1" Height="96" ClipToBounds="True" />
    </Grid>
</UserControl>
