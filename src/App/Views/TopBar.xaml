<UserControl x:Class="JizuraLive.App.Views.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 对位 TopBar.vue <header>：px-4 py-2 gap-3.5 border-b bg-panel；
         曲名/歌手等宽拉伸，四个按钮固定在右 -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="16,8">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                <Button x:Name="BtnOpen" Content="打开" Style="{StaticResource BtnFile}"
                        ToolTip="打开工程（.jizuralive 全量恢复；老 .json 仅作样式配置导入）" Click="BtnOpen_Click" />
                <Button x:Name="BtnSave" Content="保存" Margin="8,0,0,0"
                        ToolTip="保存为字面 Live 专用工程包（.jizuralive：含歌曲与歌词）" Click="BtnSave_Click" />
                <Button x:Name="BtnReset" Content="初始化" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        ToolTip="清空歌词、歌曲、设置和历史，回到初始状态" Click="BtnReset_Click" />
                <Button x:Name="BtnTerms" Content="使用说明" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        ToolTip="输出物的权利与许可证" Click="BtnTerms_Click" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbTitle" Grid.Column="0" Margin="0,0,4,0"
                         ToolTip="曲名（标题卡・HUD 显示）" TextChanged="TbTitle_TextChanged" />
                <TextBox x:Name="TbArtist" Grid.Column="1" Margin="4,0,0,0"
                         ToolTip="歌手" TextChanged="TbArtist_TextChanged" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
