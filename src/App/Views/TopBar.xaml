<UserControl x:Class="JizuraLive.App.Views.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,6">
        <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBox x:Name="TbTitle" Width="180" ToolTip="曲名（标题卡・HUD 显示）" />
                <TextBox x:Name="TbArtist" Width="130" Margin="6,0,0,0" ToolTip="歌手" />
                <Button x:Name="BtnOpen" Content="打开" Margin="10,0,0,0"
                        ToolTip="打开工程（.jizuralive 全量恢复；老 .json 仅作样式配置导入）" Click="BtnOpen_Click" />
                <Button x:Name="BtnSave" Content="保存" Margin="6,0,0,0"
                        ToolTip="保存为字面 Live 专用工程包（.jizuralive：含歌曲与歌词）" Click="BtnSave_Click" />
                <Button x:Name="BtnReset" Content="初始化" Style="{StaticResource BtnGhost}" Margin="6,0,0,0"
                        ToolTip="清空歌词、歌曲、设置和历史，回到初始状态" Click="BtnReset_Click" />
                <Button x:Name="BtnTerms" Content="使用说明" Style="{StaticResource BtnGhost}" Margin="2,0,0,0"
                        ToolTip="输出物的权利与许可证" Click="BtnTerms_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock x:Name="TblStatus" VerticalAlignment="Center" Margin="0,0,12,0"
                           FontSize="11" Foreground="{StaticResource Mut}" Text="" />
                <CheckBox x:Name="ChkSpout" Content="Spout 输出" VerticalAlignment="Center"
                          Checked="ChkSpout_Changed" Unchecked="ChkSpout_Changed"
                          ToolTip="Spout 发送开关（即时启停）" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
