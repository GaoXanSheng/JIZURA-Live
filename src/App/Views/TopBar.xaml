<UserControl x:Class="JizuraLive.App.Views.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 对位 TopBar.vue <header>：px-4 py-2 gap-3.5 border-b bg-panel；
         曲名/歌手等宽拉伸，四个按钮固定在右 -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="16,8">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                <Button x:Name="BtnOpen" Content="{DynamicResource Loc.TopBar.Open}" Style="{StaticResource BtnFile}"
                        ToolTip="{DynamicResource Loc.TopBar.Open.Tip}" Click="BtnOpen_Click" />
                <Button x:Name="BtnSave" Content="{DynamicResource Loc.TopBar.Save}" Margin="8,0,0,0"
                        ToolTip="{DynamicResource Loc.TopBar.Save.Tip}" Click="BtnSave_Click" />
                <Button x:Name="BtnReset" Content="{DynamicResource Loc.TopBar.Reset}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        ToolTip="{DynamicResource Loc.TopBar.Reset.Tip}" Click="BtnReset_Click" />
                <Button x:Name="BtnTerms" Content="{DynamicResource Loc.TopBar.Terms}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        ToolTip="{DynamicResource Loc.TopBar.Terms.Tip}" Click="BtnTerms_Click" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbTitle" Grid.Column="0" Margin="0,0,4,0"
                         ToolTip="{DynamicResource Loc.TopBar.Title.Tip}" TextChanged="TbTitle_TextChanged" />
                <TextBox x:Name="TbArtist" Grid.Column="1" Margin="4,0,0,0"
                         ToolTip="{DynamicResource Loc.TopBar.Artist.Tip}" TextChanged="TbArtist_TextChanged" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
