<UserControl x:Class="JizuraLive.App.Views.CloudNowPlaying"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- 播放器模式的"正在播放"控制块（对位酷狗音乐歌曲页的排布）：
         紧贴画面下方的进度条 → 控制键行（上/播/下 + 时间 + 队列 + 操作）→ 大字歌名 → 歌手/meta。
         数据源是 CloudPlayService（与底部常驻条同一个会话），自己不持有播放状态。 -->
    <UserControl.Resources>
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource Amber10}" />
            <Setter Property="Foreground" Value="{StaticResource Amber}" />
        </Style>
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Line2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Amber}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="BarThumb" TargetType="Ellipse">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Fill" Value="{StaticResource Amber}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 进度（与画面同宽，紧贴其下）：自绘 + 位移刷新，不写 Width、不触发布局 -->
        <Grid x:Name="BarProg" Height="16" Background="Transparent" Cursor="Hand"
              MouseLeftButtonDown="Prog_Down" MouseMove="Prog_Move" MouseLeftButtonUp="Prog_Up"
              LostMouseCapture="Prog_LostCapture" SizeChanged="Prog_SizeChanged"
              ToolTip="{DynamicResource Loc.Transport.Progress.Tip}">
            <Border Style="{StaticResource BarTrack}">
                <Border x:Name="ProgFill" Style="{StaticResource BarFill}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgFillShift" />
                    </Border.RenderTransform>
                </Border>
            </Border>
            <Ellipse x:Name="ProgThumb" Style="{StaticResource BarThumb}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="ProgThumbShift" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- 控制行：上/播/下 + 时间 + 队列位置 …… 右侧操作（选歌 / 载入编辑器） -->
        <Grid Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="BtnPrev" Style="{StaticResource IconBtn}" Click="BtnPrev_Click"
                        ToolTip="{DynamicResource Loc.Cloud.PreviewPrev}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPrev}" />
                </Button>
                <Button x:Name="BtnPlay" Style="{StaticResource PlayBtn}" Click="BtnPlay_Click"
                        ToolTip="{DynamicResource Loc.Cloud.PreviewToggleTip}">
                    <Path x:Name="IcPlay" Style="{StaticResource IconPath}" Data="{StaticResource IconPlay}" />
                </Button>
                <Button x:Name="BtnNext" Style="{StaticResource IconBtn}" Click="BtnNext_Click"
                        ToolTip="{DynamicResource Loc.Cloud.PreviewNext}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNext}" />
                </Button>
                <TextBlock x:Name="TblTime" Style="{StaticResource MonoMut}" FontSize="12" Margin="8,0,0,0"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Text="0:00 / 0:00" />
                <TextBlock x:Name="TblQueue" FontSize="12" Foreground="{StaticResource Faint}" Margin="12,0,0,0"
                           VerticalAlignment="Center" Text="" />
                <TextBlock x:Name="TblStatus" FontSize="12" Foreground="{StaticResource Cyan}" Margin="12,0,0,0"
                           VerticalAlignment="Center" Text="" TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnMute" Style="{StaticResource IconBtn}" Click="BtnMute_Click"
                        ToolTip="{DynamicResource Loc.Cloud.BarMuteTip}">
                    <Path x:Name="IcVol" Style="{StaticResource IconPath}" Data="{StaticResource IconVolume}" />
                </Button>
                <Slider x:Name="VolSlider" Style="{StaticResource FxSlider}" Width="96" MinWidth="56"
                        VerticalAlignment="Center" Margin="2,0,10,0" Minimum="0" Maximum="1"
                        SmallChange="0.05" LargeChange="0.1" Value="0.85"
                        ValueChanged="Vol_Changed" PreviewMouseUp="Vol_Commit"
                        LostMouseCapture="Vol_LostCapture" />
                <Button x:Name="BtnPick" Content="{DynamicResource Loc.Cloud.WindowTitle}"
                        Style="{StaticResource BtnGhost}" Padding="12,4" FontSize="12"
                        Click="BtnPick_Click" ToolTip="{DynamicResource Loc.Cloud.PlayerPickTip}" />
                <Button x:Name="BtnLoadToEditor" Content="{DynamicResource Loc.Cloud.PlayerLoadToEditor}"
                        Style="{StaticResource BtnPrimary}" Padding="12,4" FontSize="12" Margin="8,0,0,0"
                        Click="BtnLoadToEditor_Click" ToolTip="{DynamicResource Loc.Cloud.PlayerLoadToEditorTip}" />
            </StackPanel>
        </Grid>

        <!-- 歌名（大字）+ 歌手/meta（对位酷狗：画面下方是标题区） -->
        <TextBlock x:Name="TblTitle" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0"
                   Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" Text="" />
        <TextBlock x:Name="TblMeta" FontSize="13" Margin="0,6,0,0" Foreground="{StaticResource Mut}"
                   TextTrimming="CharacterEllipsis" Text="" />
    </StackPanel>
</UserControl>
