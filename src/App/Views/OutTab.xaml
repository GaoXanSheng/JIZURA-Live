<UserControl x:Class="JizuraLive.App.Views.OutTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JizuraLive.App.Views">
    <!-- 对位 OutTab.vue：grid-cols-2 字段 → 留出画面中央 → 格式/内容/背景勾选 → 导出按钮 + 进度 → 说明 -->
    <UserControl.Resources>
        <!-- 格式单选（btn-sm：未选 btn-ghost / 选中 btn-primary，FmtState.On 控选中态，Tag 留给格式值） -->
        <Style x:Key="FmtBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BtnHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Margin" Value="0,1,0,0" />
                            </Trigger>
                            <Trigger Property="views:FmtState.On" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Amber}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryInk}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="views:FmtState.On" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .note 的左竖线（border-l-2 border-line2 pl-2.5 mt-3） -->
        <Style x:Key="NoteWrap" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- grid-cols-2 gap-2：画面比例 / 分辨率 / fps（.field = 11px mut 标签 + 全宽控件） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8">
                <TextBlock Text="{DynamicResource Loc.Out.Aspect}" Style="{StaticResource FieldLab}" Margin="0,0,0,4" />
                <ComboBox x:Name="CbAspect" SelectionChanged="CbAspect_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8">
                <TextBlock Text="{DynamicResource Loc.Out.Res}" Style="{StaticResource FieldLab}" Margin="0,0,0,4" />
                <ComboBox x:Name="CbRes" SelectionChanged="CbRes_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="fps" Style="{StaticResource FieldLab}" Margin="0,0,0,4" />
                <ComboBox x:Name="CbFps" SelectionChanged="CbFps_SelectionChanged" />
            </StackPanel>
        </Grid>

        <!-- checkblock my-2.5：留出画面中央（放角色用）＋ 11px 说明行 -->
        <CheckBox x:Name="CkCenterFree" Margin="0,10,0,10" Checked="Center_Changed" Unchecked="Center_Changed">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Out.CenterFree}" FontSize="12" />
                <TextBlock Text="{DynamicResource Loc.Out.CenterFree.Hint}" FontSize="11"
                           Foreground="{StaticResource Mut}" TextWrapping="Wrap" MaxWidth="276" />
            </StackPanel>
        </CheckBox>

        <!-- v-if="centerFree"：竖屏时 上下/左右分列 -->
        <StackPanel x:Name="CenterDirRow" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Loc.Out.CenterDirLead}" FontSize="12" Foreground="{StaticResource Mut}" VerticalAlignment="Center" />
            <ComboBox x:Name="CbCenterDir" Width="130" Margin="6,0,0,0" SelectionChanged="Center_Changed" />
        </StackPanel>

        <!-- mt-3 pt-3 border-t：格式 × 内容 × 背景形态，一个「导出」按钮按组合落盘 -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                Margin="0,12,0,0">
            <StackPanel>
                <!-- 格式按钮组（btn-sm：选中 btn-primary） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Loc.Out.Format}" FontSize="11" Foreground="{StaticResource Mut}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="BtnFmtMp4" Style="{StaticResource FmtBtn}" Click="Format_Click" Tag="mp4"
                            Content="{DynamicResource Loc.Out.Fmt.Mp4}" />
                    <Button x:Name="BtnFmtWebm" Style="{StaticResource FmtBtn}" Click="Format_Click" Tag="webm"
                            Content="{DynamicResource Loc.Out.Fmt.Webm}" />
                    <Button x:Name="BtnFmtPng" Style="{StaticResource FmtBtn}" Click="Format_Click" Tag="png"
                            Content="{DynamicResource Loc.Out.Fmt.Png}" />
                </StackPanel>

                <!-- grid-cols-2 gap-x-4 gap-y-1.5：渲染画面 / 字幕 / 背景 / 音频 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="CkVisuals" Grid.Row="0" Grid.Column="0" Margin="0,0,16,6"
                              Checked="Cfg_Changed" Unchecked="Cfg_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Out.Visuals}" FontSize="12" />
                            <TextBlock Text="{DynamicResource Loc.Out.Visuals.Sub}" FontSize="11" Foreground="{StaticResource Mut}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="CkSubs" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                              ToolTip="{DynamicResource Loc.Out.Subs.Tip}"
                              Checked="Cfg_Changed" Unchecked="Cfg_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Out.Subs}" FontSize="12" />
                            <TextBlock Text="{DynamicResource Loc.Out.Subs.Sub}" FontSize="11" Foreground="{StaticResource Mut}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="CkBg" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0"
                              Content="{DynamicResource Loc.Out.Bg}"
                              ToolTip="{DynamicResource Loc.Out.Bg.Tip}"
                              Checked="Cfg_Changed" Unchecked="Cfg_Changed" />
                    <CheckBox x:Name="CkAudio" Grid.Row="1" Grid.Column="1"
                              ToolTip="{DynamicResource Loc.Out.Audio.Tip}"
                              Checked="Cfg_Changed" Unchecked="Cfg_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Out.Audio}" FontSize="12" />
                            <TextBlock Text="{DynamicResource Loc.Out.Audio.Sub}" FontSize="11" Foreground="{StaticResource Mut}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                </Grid>

                <!-- 背景形态（勾了背景） / 透明底（没勾背景） -->
                <Grid x:Name="BgStyleRow" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Out.BgStyle}" FontSize="11" Foreground="{StaticResource Mut}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="CbBgStyle" Grid.Column="1" Width="88" Margin="6,0,0,0"
                              SelectionChanged="BgStyle_Changed" />
                    <TextBlock x:Name="TblBgNote" Grid.Column="2" Text="{DynamicResource Loc.Out.BgStyle.Note}"
                               FontSize="11" Foreground="{StaticResource Mut}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
                <Grid x:Name="TransparentRow" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Out.Transparent}" FontSize="11" Foreground="{StaticResource Cyan}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TblMp4TransWarn" Grid.Column="1"
                               Text="{DynamicResource Loc.Out.Mp4TransWarn}"
                               FontSize="11" Foreground="{StaticResource Amber}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>

                <!-- PNG 分层 / MP4 直存（grid gap-1 mt-2） -->
                <StackPanel Margin="0,8,0,0">
                    <CheckBox x:Name="CkLayered" Margin="0,0,0,4"
                              ToolTip="{DynamicResource Loc.Out.Layered.Tip}"
                              Checked="Cfg_Changed" Unchecked="Cfg_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Out.Layered}" FontSize="12" />
                            <TextBlock Text="{DynamicResource Loc.Out.Layered.Sub}" FontSize="11" Foreground="{StaticResource Mut}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="CkToFile"
                              ToolTip="{DynamicResource Loc.Out.ToFile.Tip}"
                              Checked="Cfg_Changed" Unchecked="Cfg_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Out.ToFile}" FontSize="12" />
                            <TextBlock Text="{DynamicResource Loc.Out.ToFile.Sub}" FontSize="11" Foreground="{StaticResource Mut}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- 导出范围（选段）：按切分选（对位 OutTab.vue 的 rangeFrom/rangeTo 两个下拉 + 信息行）——
                     from 选「全部」= 清空；to 选「—」= 折叠成单切分；与行列表的 ◁▷ 按钮写同一份 project.exportRange -->
                <Grid x:Name="RangeRow" Margin="0,10,0,0" ToolTip="{DynamicResource Loc.Out.Range.Tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Out.Range}" FontSize="11" Foreground="{StaticResource Mut}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CbRangeFrom" Grid.Column="1" Width="104" SelectionChanged="Range_Changed"
                              ToolTip="{DynamicResource Loc.Out.Range.Tip}" />
                    <TextBlock Grid.Column="2" Text="〜" FontSize="11" Foreground="{StaticResource Mut}"
                               VerticalAlignment="Center" Margin="6,0,6,0" />
                    <ComboBox x:Name="CbRangeTo" Grid.Column="3" Width="104" SelectionChanged="Range_Changed"
                              ToolTip="{DynamicResource Loc.Out.Range.Tip}" />
                    <TextBlock x:Name="TblRangeInfo" Grid.Column="4" Style="{StaticResource MonoMut}" FontSize="11"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>

                <!-- 校验 / 提示（.note：左竖线 + 12px mut；invalid 用琥珀） -->
                <Border x:Name="NoteInvalid" Style="{StaticResource NoteWrap}" Visibility="Collapsed">
                    <TextBlock x:Name="TblInvalid" Style="{StaticResource NoteTx}"
                               Foreground="{StaticResource Amber}" />
                </Border>
                <Border x:Name="NoteAudio" Style="{StaticResource NoteWrap}" Visibility="Collapsed">
                    <TextBlock x:Name="TblAudioNote" Style="{StaticResource NoteTx}" />
                </Border>
                <Border x:Name="NoteSubs" Style="{StaticResource NoteWrap}" Visibility="Collapsed">
                    <TextBlock x:Name="TblSubsNote" Style="{StaticResource NoteTx}"
                               Text="{DynamicResource Loc.Out.SubsNote}" />
                </Border>

                <!-- btn btn-primary w-full !py-3 mt-2.5 text-[15px] -->
                <Button x:Name="BtnExport" Style="{StaticResource BtnPrimary}" Content="{DynamicResource Loc.Out.Export}" Height="46"
                        Padding="0,12" FontSize="15" Margin="0,10,0,0" ToolTip="{DynamicResource Loc.Out.Export.Tip}"
                        Click="BtnExport_Click" />
            </StackPanel>
        </Border>

        <!-- 进度（.progress + 琥珀填充条，busy 或 progressText ≠ '—' 时显示） -->
        <StackPanel x:Name="ProgWrap" Margin="0,12,0,0" Visibility="Collapsed">
            <Border x:Name="ProgTrack" Style="{StaticResource ProgTrack}" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgFillCol" Width="0*" />
                        <ColumnDefinition x:Name="ProgRestCol" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ProgFill" Grid.Column="0" CornerRadius="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF16F4D4" Offset="0" />
                                <GradientStop Color="#FFF5A50C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TblProg" Style="{StaticResource MonoMut}" FontSize="11" Text="—"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button x:Name="BtnAbort" Grid.Column="1" Style="{StaticResource BtnGhostSm}"
                        Content="{DynamicResource Loc.Out.Abort}"
                        Margin="8,0,0,0" Click="BtnAbort_Click" Visibility="Collapsed" />
            </Grid>
        </StackPanel>

        <!-- codec 说明（.note） -->
        <Border Style="{StaticResource NoteWrap}">
            <TextBlock x:Name="TblCodecNote" Style="{StaticResource NoteTx}"
                       Text="{DynamicResource Loc.Out.CodecNote}" />
        </Border>

        <!-- 状态小字（12px mut / mono）：{W}×{H} · {切分数} 切分 · seed {seed} · Spout→… -->
        <TextBlock x:Name="TblStatus" Style="{StaticResource MonoMut}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,12,0,0" Text="—" />
    </StackPanel>
</UserControl>
