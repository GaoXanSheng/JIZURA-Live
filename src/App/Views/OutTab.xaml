<UserControl x:Class="JizuraLive.App.Views.OutTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowLab" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- 格式单选（Vue 的 btn / btn-primary 切换） -->
        <Style x:Key="FmtBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 画幅 / 分辨率 / fps（与设置页同源：project.aspect/res/fps） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="画面比例" Grid.Row="0" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <ComboBox x:Name="CbAspect" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                      SelectionChanged="CbAspect_SelectionChanged" />
            <TextBlock Text="分辨率" Grid.Row="1" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <ComboBox x:Name="CbRes" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                      SelectionChanged="CbRes_SelectionChanged" />
            <TextBlock Text="fps" Grid.Row="2" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <ComboBox x:Name="CbFps" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                      SelectionChanged="CbFps_SelectionChanged" />
        </Grid>

        <CheckBox x:Name="CkCenterFree" Content="留出画面中央（放角色用）" Margin="0,4,0,4"
                  ToolTip="留白宽度在「设置」页自定义；预览会用虚线标出留空范围"
                  Checked="Center_Changed" Unchecked="Center_Changed" />
        <StackPanel x:Name="CenterDirRow" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="竖屏时" Style="{StaticResource RowLab}" Margin="0,0,6,0" />
            <ComboBox x:Name="CbCenterDir" Width="120" SelectionChanged="Center_Changed" />
        </StackPanel>

        <!-- 导出内容勾选：格式 × 内容 × 背景形态，一个「导出」按钮按组合落盘 -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="格式" Style="{StaticResource RowLab}" Margin="0,0,8,0" />
            <Button x:Name="BtnFmtMp4" Style="{StaticResource FmtBtn}" Click="Format_Click" Tag="mp4" Content="MP4 视频" />
            <Button x:Name="BtnFmtWebm" Style="{StaticResource FmtBtn}" Click="Format_Click" Tag="webm" Content="WebM 视频" />
            <Button x:Name="BtnFmtPng" Style="{StaticResource FmtBtn}" Click="Format_Click" Tag="png" Content="PNG 序列" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="CkVisuals" Grid.Row="0" Content="渲染画面（歌词动画）" Margin="0,0,0,5"
                      ToolTip="歌词动画渲染层" Checked="Cfg_Changed" Unchecked="Cfg_Changed" />
            <CheckBox x:Name="CkSubs" Grid.Row="0" Grid.Column="1" Content="字幕（云字幕）" Margin="0,0,0,5"
                      ToolTip="按「字幕」面板的样式，把翻译/音译字幕烤进导出画面；需先在「字幕」面板开启字幕渲染"
                      Checked="Cfg_Changed" Unchecked="Cfg_Changed" />
            <CheckBox x:Name="CkBg" Grid.Row="1" Content="背景" Margin="0,0,0,5"
                      ToolTip="不勾 = 透明底导出（仅 WebM / PNG 序列；MP4 需勾上并用绿幕/黑幕抠像）"
                      Checked="Cfg_Changed" Unchecked="Cfg_Changed" />
            <CheckBox x:Name="CkAudio" Grid.Row="1" Grid.Column="1" Content="音频（歌曲）" Margin="0,0,0,5"
                      ToolTip="MP4：歌曲内嵌进视频；WebM / PNG：无法内嵌，导出时询问另存 WAV"
                      Checked="Cfg_Changed" Unchecked="Cfg_Changed" />
        </Grid>

        <!-- 背景形态 / 透明底提示 -->
        <StackPanel x:Name="BgStyleRow" Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="背景形态" Style="{StaticResource RowLab}" Margin="0,0,8,0" />
            <ComboBox x:Name="CbBgStyle" Width="90" SelectionChanged="BgStyle_Changed" />
            <TextBlock x:Name="TblBgNote" Text="单色底上只画白色文字与演出，剪辑软件色度键/滤色合成"
                       Style="{StaticResource RowLab}" FontSize="10" Margin="8,0,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="TransparentRow" Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="透明底（无背景）" FontSize="11" Foreground="{StaticResource Cyan}" />
            <TextBlock x:Name="TblMp4TransWarn" Text="MP4 不支持透明，请勾上背景或改用 WebM / PNG"
                       FontSize="11" Foreground="{StaticResource Amber}" Margin="8,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- PNG 分层 / MP4 直存 -->
        <CheckBox x:Name="CkLayered" Content="分层输出（back / front 双目录）" Margin="0,6,0,0"
                  ToolTip="后景（背景图形与歌词后面的装饰）和前景（歌词与其装饰）分别导出到 back / front 文件夹的透明 PNG"
                  Checked="Cfg_Changed" Unchecked="Cfg_Changed" />
        <CheckBox x:Name="CkToFile" Content="大视频直接写入文件（不占内存）" Margin="0,4,0,0"
                  ToolTip="边导出边直接写文件。长曲・1080p 以上内存不足时使用"
                  Checked="Cfg_Changed" Unchecked="Cfg_Changed" />

        <!-- 校验 / 提示 -->
        <TextBlock x:Name="TblInvalid" Foreground="{StaticResource Amber}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="TblAudioNote" Foreground="{StaticResource Mut}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="TblSubsNote" Text="字幕按「字幕」面板当前样式与内容烤入；只勾字幕时导出的是透明底纯字幕层（可与画面分层素材叠放）。"
                   Foreground="{StaticResource Mut}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <Button x:Name="BtnExport" Content="导　出" FontSize="14" Padding="0,8" Margin="0,10,0,0"
                Background="{StaticResource Amber}" Foreground="{StaticResource Ink}"
                BorderThickness="0" FontWeight="SemiBold"
                ToolTip="按上方勾选导出（M4 接入本机渲染管线）" Click="BtnExport_Click" />
        <TextBlock x:Name="TblCodecNote" Text="导出在本机渲染管线内完成（M4 接入）。"
                   Style="{StaticResource Hint}" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>
