<UserControl x:Class="JizuraLive.App.Views.TechTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JizuraLive.App.Controls">
    <!-- 手法选项卡（对位 frontend/src/components/panels/TechTab.vue）：
         顶部套装开关（.checkblock 的 Switch）+ 筛选行（input flex-1 + mono 计数）+ 提示，
         10 组手法段（段头=组名/计数/锁，段内=全开全关反转 + 自适应卡片网格）。
         组段与卡片是注册表数据驱动，在 code-behind 构建；缩略图由后台队列逐张出图。 -->
    <UserControl.Resources>
        <!-- 卡片名行徽标：.badge-set.set-horror / set-typo / set-kinetic 三色（新增=BadgeEx 青、和=默认琥珀） -->
        <SolidColorBrush x:Key="BadgeHorrorLine" Color="#FFC0544A" />
        <SolidColorBrush x:Key="BadgeHorrorTx" Color="#FFE0786E" />
        <SolidColorBrush x:Key="BadgeTypoLine" Color="#FF9AA3AD" />
        <SolidColorBrush x:Key="BadgeTypoTx" Color="#FFC5CCD3" />
        <SolidColorBrush x:Key="BadgeKineticLine" Color="#FF7FBF6A" />
        <SolidColorBrush x:Key="BadgeKineticTx" Color="#FF9FD98A" />
        <Style x:Key="BadgeHorror" TargetType="{x:Type ctl:JzBadge}" BasedOn="{StaticResource {x:Type ctl:JzBadge}}">
            <Setter Property="BorderBrush" Value="{StaticResource BadgeHorrorLine}" />
            <Setter Property="Foreground" Value="{StaticResource BadgeHorrorTx}" />
        </Style>
        <Style x:Key="BadgeTypo" TargetType="{x:Type ctl:JzBadge}" BasedOn="{StaticResource {x:Type ctl:JzBadge}}">
            <Setter Property="BorderBrush" Value="{StaticResource BadgeTypoLine}" />
            <Setter Property="Foreground" Value="{StaticResource BadgeTypoTx}" />
        </Style>
        <Style x:Key="BadgeKinetic" TargetType="{x:Type ctl:JzBadge}" BasedOn="{StaticResource {x:Type ctl:JzBadge}}">
            <Setter Property="BorderBrush" Value="{StaticResource BadgeKineticLine}" />
            <Setter Property="Foreground" Value="{StaticResource BadgeKineticTx}" />
        </Style>
        <!-- 组头（Vue summary：px-2.5 py-2 整行可点，悬停微亮，无描边） -->
        <Style x:Key="GroupHeaderBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- 筛选框占位符（WPF TextBox 无 placeholder：空文本时叠一层提示字，缩进 = 1px 描边 + 9px 内边距） -->
        <Style x:Key="FilterHintTx" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <!-- 旧 px-4 py-3.5（底 14 落在滚动内容末尾，见 GroupsHost） -->
    <Grid Margin="16,14,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 套装开关（Vue SETS checkblocks：新增/和风/排版/动态/恐怖，flex-col gap-1 mb-3） -->
        <StackPanel x:Name="SetsHost" Margin="0,0,0,12" />

        <!-- 筛选 + 总计数（Vue .row mb-2.5：input flex-1 + span.font-mono.text-xs.text-mut） -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="TbFilter" ToolTip="{DynamicResource Loc.Tech.Filter}"
                         AutomationProperties.Name="{DynamicResource Loc.Tech.Filter}"
                         TextChanged="TbFilter_TextChanged" />
                <TextBlock x:Name="FilterHint" Text="{DynamicResource Loc.Tech.Filter}" Style="{StaticResource FilterHintTx}" />
            </Grid>
            <TextBlock x:Name="TblTotal" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource MonoMut}" FontSize="12" />
        </Grid>

        <!-- 提示行（Vue p.hint.mb-2） -->
        <TextBlock Grid.Row="2" Text="{DynamicResource Loc.Tech.Hint}"
                   Style="{StaticResource Hint}" Margin="0,0,0,8" />

        <!-- 组段宿主：折叠的组不建卡片（对位 Vue 的 v-if 卸载省内存策略） -->
        <ScrollViewer x:Name="GroupsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsHost" Margin="0,0,0,14" />
        </ScrollViewer>
    </Grid>
</UserControl>
