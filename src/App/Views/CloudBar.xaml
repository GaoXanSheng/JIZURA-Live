<UserControl x:Class="JizuraLive.App.Views.CloudBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JizuraLive.App.Controls"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <!-- 云试听常驻条：主窗口底部与云音乐面板内共用（面板那侧 Compact=true 去掉音量）。
         数据源是 CloudPlayService（全局播放会话），控件自己不持有播放状态。 -->
    <UserControl.Resources>
        <!-- 媒体图标（Path 几何，来自 Theme.xaml；不依赖字体图标） -->
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 传输键：透明底，悬停提亮（对位播放器的圆形图标键） -->
        <Style x:Key="BarIconBtn" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarPlayBtn" TargetType="Button" BasedOn="{StaticResource BarIconBtn}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Background" Value="{StaticResource Amber10}" />
            <Setter Property="Foreground" Value="{StaticResource Amber}" />
        </Style>
        <!-- 自绘进度槽/填充/拖柄（与 Transport 同款：填充恒宽靠位移露出左段，写 Width 会触发布局） -->
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource Amber}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="BarThumb" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="{StaticResource Amber}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBar" Background="#12000000" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0" Padding="14,7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" x:Name="ColVolume" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TblCover" Grid.Column="0" Width="40" Height="40" CornerRadius="7"
                    Background="{StaticResource Raised}" VerticalAlignment="Center">
                <TextBlock x:Name="TblCoverInitial" FontSize="16" Foreground="{StaticResource Mut}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="" />
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="TblTitle" FontSize="13" TextTrimming="CharacterEllipsis" Text="" />
                <TextBlock x:Name="TblStatus" FontSize="11" Foreground="{StaticResource Mut}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPrev" Style="{StaticResource BarIconBtn}" Click="BtnPrev_Click"
                        ToolTip="{DynamicResource Loc.Cloud.PreviewPrev}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPrev}" />
                </Button>
                <Button x:Name="BtnPlay" Style="{StaticResource BarPlayBtn}" Click="BtnPlay_Click"
                        ToolTip="{DynamicResource Loc.Cloud.PreviewToggleTip}">
                    <Path x:Name="IcPlay" Style="{StaticResource IconPath}" Data="{StaticResource IconPlay}" />
                </Button>
                <Button x:Name="BtnNext" Style="{StaticResource BarIconBtn}" Click="BtnNext_Click"
                        ToolTip="{DynamicResource Loc.Cloud.PreviewNext}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNext}" />
                </Button>
            </StackPanel>

            <Grid x:Name="BarProg" Grid.Column="3" Height="24" Margin="10,0" Background="Transparent"
                  Cursor="Hand" MouseLeftButtonDown="Prog_Down" MouseMove="Prog_Move"
                  MouseLeftButtonUp="Prog_Up" LostMouseCapture="Prog_LostCapture"
                  SizeChanged="Prog_SizeChanged" ToolTip="{DynamicResource Loc.Cloud.Progress.Tip}">
                <Border Style="{StaticResource BarTrack}">
                    <Border x:Name="ProgFill" Style="{StaticResource BarFill}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ProgFillShift" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <Ellipse x:Name="ProgThumb" Style="{StaticResource BarThumb}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="ProgThumbShift" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <TextBlock x:Name="TblTime" Grid.Column="4" Text="0:00 / 0:00" Style="{StaticResource MonoMut}"
                       FontSize="11" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />

            <TextBlock x:Name="TblQueue" Grid.Column="5" FontSize="11" Foreground="{StaticResource Faint}"
                       Margin="10,0,0,0" VerticalAlignment="Center" Text="" />

            <StackPanel x:Name="VolBox" Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="10,0,0,0">
                <Button x:Name="BtnMute" Style="{StaticResource BarIconBtn}" Click="BtnMute_Click"
                        ToolTip="{DynamicResource Loc.Cloud.BarMuteTip}">
                    <Path x:Name="IcVol" Style="{StaticResource IconPath}" Data="{StaticResource IconVolume}" />
                </Button>
                <Slider x:Name="VolSlider" Style="{StaticResource FxSlider}" Width="86" MinWidth="46"
                        VerticalAlignment="Center" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        ValueChanged="Vol_Changed" PreviewMouseUp="Vol_Commit"
                        LostMouseCapture="Vol_LostCapture" Value="0.85" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
