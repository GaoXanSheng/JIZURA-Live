<UserControl x:Class="JizuraLive.App.Views.Transport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JizuraLive.App.Views">
    <!-- 播放条（对位 Transport.vue）：一整行 flex-wrap（`flex items-center gap-2.5 flex-wrap`，无外框卡片），
         宽不够自然折成两行。元素序与文案照抄旧模板：
         ▶/❚❚ · 当前时间 / 总时长 · 进度条 · 循环 · 声音组 · 历史 ◀/▶ · 重抽构成 · 主题 · 一键随机 -->
    <UserControl.Resources>
        <!-- 播放键：!w-11 !h-[34px] !p-0 text-[13px] -->
        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- 历史 ◀/▶：btn-ghost btn-sm !text-[10px] min-w-7 -->
        <Style x:Key="HistBtn" TargetType="Button" BasedOn="{StaticResource BtnGhostSm}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <!-- 主题下拉：SelSm 之上 !h-[30px] max-w-[92px] -->
        <Style x:Key="ThemeSel" TargetType="ComboBox" BasedOn="{StaticResource SelSm}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MaxWidth" Value="92" />
        </Style>
        <!-- 自绘进度/音量条的 5px 圆角槽（对位 `h-[5px] rounded bg-line overflow-hidden`） -->
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- overflow-hidden：填充越界也不画出槽外 -->
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- 琥珀填充（对位 `h-full w-full bg-amber`，宽按比例） -->
        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource Amber}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- 12px 琥珀圆点拖柄（对位 `w-3 h-3 rounded-full bg-amber shadow-[0_0_4px_rgba(0,0,0,0.6)]`） -->
        <Style x:Key="BarThumb" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="{StaticResource Amber}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- FlexWrapRow = 旧 `flex items-center gap-2.5 flex-wrap`；Grow=1 的元素在自己的行里分掉剩余宽
         （对位 `flex-[1_1_160px]`：basis 取 MinWidth） -->
    <local:FlexWrapRow x:Name="Row">
        <Button x:Name="BtnPlay" Content="▶" Style="{StaticResource PlayBtn}"
                Click="BtnPlay_Click" ToolTip="{DynamicResource Loc.Transport.Play.Tip}" />

        <TextBlock x:Name="TblNow" Text="0:00.0" Style="{StaticResource MonoTx}" FontWeight="Medium"
                   Typography.NumeralAlignment="Tabular" />
        <TextBlock x:Name="TblSlash" Text="/" Style="{StaticResource MonoMut}" />
        <TextBlock x:Name="TblDur" Text="0:00.0" Style="{StaticResource MonoMut}"
                   Typography.NumeralAlignment="Tabular" />

        <!-- 进度条：h26 命中区，自绘（原生 Slider 的 value 写入会带整页重绘，旧版也是自绘） -->
        <Grid x:Name="ProgBar" Height="26" MinWidth="160" Background="Transparent" Cursor="Hand"
              local:FlexWrapRow.Grow="1" ToolTip="{DynamicResource Loc.Transport.Progress.Tip}"
              MouseLeftButtonDown="ProgBar_Down" MouseMove="ProgBar_Move"
              MouseLeftButtonUp="ProgBar_Up" LostMouseCapture="ProgBar_LostCapture"
              SizeChanged="ProgBar_SizeChanged">
            <Border Style="{StaticResource BarTrack}">
                <!-- 填充恒为整条宽、靠位移露出左段（对位 Vue 的 translateX 手法）：写 Width 每次都要
                     跑一遍布局，位移只走合成；右端由槽的 ClipToBounds 裁掉，左端圆角由自身保住 -->
                <Border x:Name="ProgFill" Style="{StaticResource BarFill}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgFillShift" />
                    </Border.RenderTransform>
                </Border>
            </Border>
            <Ellipse x:Name="ProgThumb" Style="{StaticResource BarThumb}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="ProgThumbShift" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- 循环：五态轮转按钮（对位 Transport.vue 的 LOOP_LABEL/cycleLoop）——
             循环 / 切分循环（当前整行）/ 行循环（当前单个切分）/ 选段循环（导出范围）/ 不循环。
             文案与琥珀/0.55 视觉在 code-behind 的 SyncLoopBtn 里刷（随档位与语言变） -->
        <Button x:Name="BtnLoop" Content="{DynamicResource Loc.Transport.Loop}" Style="{StaticResource BtnGhostSm}"
                Click="BtnLoop_Click" ToolTip="{DynamicResource Loc.Transport.Loop.Tip}" />

        <!-- 声音组（对位 `<span class="inline-flex items-center gap-1">`，gap-1 = 4px）：
             预览音量/消音走引擎 SetVolume（对位 AP.setVol：增益 muted ? 0 : vol²），只动预览出声，
             导出始终原电平。拖动音量条即解除消音，松手落盘（旧版 localStorage 记忆音量） -->
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnMute" Content="{DynamicResource Loc.Transport.Mute}" Style="{StaticResource BtnGhostSm}" Margin="0,0,4,0"
                    Click="BtnMute_Click"
                    ToolTip="{DynamicResource Loc.Transport.Mute.Tip}" />
            <Grid x:Name="VolBar" Width="80" Height="26" Background="Transparent" Margin="0,0,4,0"
                  ToolTip="{DynamicResource Loc.Transport.Volume.Tip}"
                  Focusable="True" Cursor="Hand"
                  MouseLeftButtonDown="VolBar_Down" MouseMove="VolBar_Move"
                  MouseLeftButtonUp="VolBar_Up" LostMouseCapture="VolBar_LostCapture"
                  KeyDown="VolBar_KeyDown">
                <Border Style="{StaticResource BarTrack}">
                    <Border x:Name="VolFill" Style="{StaticResource BarFill}" />
                </Border>
                <Ellipse x:Name="VolThumb" Style="{StaticResource BarThumb}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="VolThumbShift" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <Button x:Name="BtnFx" Content="{DynamicResource Loc.Transport.Fx}" Style="{StaticResource BtnGhostSm}" Click="BtnFx_Click"
                    ToolTip="{DynamicResource Loc.Transport.Fx.Tip}" />
        </StackPanel>

        <!-- 历史 ◀/▶：外观（look）历史，对位 histInfo/histGo -->
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnHistBack" Content="◀" Style="{StaticResource HistBtn}" Margin="0,0,4,0"
                    Click="BtnHistBack_Click" ToolTip="{DynamicResource Loc.Transport.HistBack.Tip}" />
            <Button x:Name="BtnHistFwd" Content="▶" Style="{StaticResource HistBtn}"
                    Click="BtnHistFwd_Click" ToolTip="{DynamicResource Loc.Transport.HistFwd.Tip}" />
        </StackPanel>

        <Button x:Name="BtnShuffle" Content="{DynamicResource Loc.Transport.Shuffle}" Style="{StaticResource BtnAccent}"
                Click="BtnShuffle_Click" ToolTip="{DynamicResource Loc.Transport.Shuffle.Tip}" />

        <ComboBox x:Name="SelTheme" Style="{StaticResource ThemeSel}" SelectionChanged="SelTheme_Changed"
                  ToolTip="{DynamicResource Loc.Transport.Theme.Tip}" />

        <Button x:Name="BtnOmakase" Content="{DynamicResource Loc.Transport.Omakase}" Style="{StaticResource BtnPrimary}"
                Click="BtnOmakase_Click" ToolTip="{DynamicResource Loc.Transport.Omakase.Tip}" />
    </local:FlexWrapRow>
</UserControl>
