<UserControl x:Class="JizuraLive.App.Views.PvTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JizuraLive.App.Views">
    <!-- PV 面板：多路 Spout 源（VTS/游戏/桌面捕获）合成到主通道与预览的控制台。
         只放壳：源卡片（四路同构、还随增删重建）在代码里建，见 PvTab.xaml.cs。
         面板里所有参数**即时生效**——对象被 Spout 泵与预览泵每拍读一次，拖完就看得到画面变化。 -->
    <UserControl.Resources>
        <!-- 行标签（同 SettingsTab 的 RowLab：12px mut，行内垂直居中） -->
        <Style x:Key="RowLab" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 源卡片：左侧一道竖线 + 深底，和设置页的功能卡同形 -->
        <Style x:Key="SrcCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- 删除按钮（幽灵小按钮，只放一个 ✕） -->
        <Style x:Key="DelBtn" TargetType="Button" BasedOn="{StaticResource BtnGhostSm}">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
        </Style>
        <Style x:Key="NoteWrap" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 总开关：PV 合成 + 跟随镜头 -->
        <CheckBox x:Name="CkEnabled" Checked="Flag_Changed" Unchecked="Flag_Changed">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Pv.Enable}" FontSize="12" />
                <TextBlock Text="{DynamicResource Loc.Pv.Enable.Hint}" FontSize="11" Foreground="{StaticResource Mut}"
                           TextWrapping="Wrap" MaxWidth="276" />
            </StackPanel>
        </CheckBox>
        <CheckBox x:Name="CkGlobalCam" Margin="0,10,0,0" ToolTip="{DynamicResource Loc.Pv.GlobalCam.Tip}"
                  Checked="Flag_Changed" Unchecked="Flag_Changed">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Pv.GlobalCam}" FontSize="12" />
                <TextBlock Text="{DynamicResource Loc.Pv.GlobalCam.Hint}" FontSize="11" Foreground="{StaticResource Mut}"
                           TextWrapping="Wrap" MaxWidth="276" />
            </StackPanel>
        </CheckBox>
        <CheckBox x:Name="CkFollow" Margin="24,8,0,0" ToolTip="{DynamicResource Loc.Pv.Follow.Tip}"
                  Checked="Flag_Changed" Unchecked="Flag_Changed">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Pv.Follow}" FontSize="12" />
                <TextBlock Text="{DynamicResource Loc.Pv.Follow.Hint}" FontSize="11" Foreground="{StaticResource Mut}"
                           TextWrapping="Wrap" MaxWidth="252" />
            </StackPanel>
        </CheckBox>
        <CheckBox x:Name="CkSubtitleTop" Margin="0,10,0,0" ToolTip="{DynamicResource Loc.Pv.SubtitleTop.Tip}"
                  Checked="Flag_Changed" Unchecked="Flag_Changed">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Pv.SubtitleTop}" FontSize="12" />
                <TextBlock Text="{DynamicResource Loc.Pv.SubtitleTop.Hint}" FontSize="11" Foreground="{StaticResource Mut}"
                           TextWrapping="Wrap" MaxWidth="276" />
            </StackPanel>
        </CheckBox>

        <!-- 角色动效独立监视视口（实时预览节拍下沉律动、呼吸脉冲光晕与环境光调色） -->
        <views:PvActorPreviewView x:Name="ActorPreview" Margin="0,12,0,0" />

        <!-- 输出/接收状态 + 刷新源列表 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TblOut" Style="{StaticResource MonoMut}" FontSize="11" Text="—"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button x:Name="BtnRefresh" Grid.Column="1" Style="{StaticResource BtnGhostSm}"
                    Content="{DynamicResource Loc.Pv.Refresh}" Margin="8,0,0,0" Click="BtnRefresh_Click" />
        </Grid>

        <!-- 源列表（卡片在代码里建） -->
        <StackPanel x:Name="SourceList" Margin="0,12,0,0" />

        <Button x:Name="BtnAdd" Style="{StaticResource BtnGhostSm}" Content="{DynamicResource Loc.Pv.Source.Add}"
                Margin="0,2,0,0" HorizontalAlignment="Left" Click="BtnAdd_Click" />

        <!-- VTube Studio 联动（插件 API）：模型取景 + 热键；卡片在代码里建 -->
        <StackPanel x:Name="VtsHost" Margin="0,14,0,0" />

        <Border Style="{StaticResource NoteWrap}">
            <TextBlock Style="{StaticResource NoteTx}" Text="{DynamicResource Loc.Pv.Hint}" />
        </Border>
    </StackPanel>
</UserControl>
