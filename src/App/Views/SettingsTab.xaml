<UserControl x:Class="JizuraLive.App.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 「标签 + 控件」行（对位 w-[110px] label + flex-1 控件） -->
        <Style x:Key="RowLab" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 自定义留出画面范围（中央を空ける） -->
        <TextBlock Text="自定义留出画面范围" Foreground="{StaticResource Fg}" FontSize="12"
                   FontWeight="SemiBold" Margin="0,2,0,2" />
        <TextBlock Text="给角色留出空白，文字与演出放两侧" Style="{StaticResource Hint}" Margin="0,0,0,6" />
        <CheckBox x:Name="CkCenterFree" Content="留出画面中央（导出页可开关，宽度用这里自定义的值）"
                  Checked="Center_Changed" Unchecked="Center_Changed" />
        <StackPanel x:Name="CenterOpts" Margin="0,6,0,0">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="留白位置" Style="{StaticResource RowLab}" />
                <ComboBox x:Name="CbCenterZone" Grid.Column="1" SelectionChanged="Center_Changed" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="留白宽度 %" Style="{StaticResource RowLab}" />
                <TextBox x:Name="TbCenterGap" Grid.Column="1" Width="60" LostFocus="CenterGap_Commit"
                         KeyDown="CenterGap_KeyDown" />
                <TextBlock Grid.Column="2" Text="%（10~70，按画面宽/高计）" Style="{StaticResource RowLab}"
                           Margin="6,0,0,0" />
            </Grid>
            <Grid x:Name="CenterDirRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="竖屏分列" Style="{StaticResource RowLab}" />
                <ComboBox x:Name="CbCenterDir" Grid.Column="1" SelectionChanged="Center_Changed" />
            </Grid>
        </StackPanel>

        <!-- 画幅 / 分辨率 / fps / 背景 -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="画布比例" Grid.Row="0" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <ComboBox x:Name="CbAspect" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                      SelectionChanged="CbAspect_SelectionChanged"
                      ToolTip="与「导出」页的画面比例同源，改这里导出页会同步" />
            <TextBlock Text="分辨率" Grid.Row="1" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <ComboBox x:Name="CbRes" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                      SelectionChanged="CbRes_SelectionChanged" />
            <TextBlock Text="fps" Grid.Row="2" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <ComboBox x:Name="CbFps" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                      SelectionChanged="CbFps_SelectionChanged" />
            <TextBlock Text="背景" Grid.Row="3" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <ComboBox x:Name="CbKeyBg" Grid.Row="3" Grid.Column="1"
                      SelectionChanged="CbKeyBg_SelectionChanged"
                      ToolTip="绿幕/黑幕时只在单色背景上绘制白色文字与演出，供合成抠像；与「导出」页的背景同源" />
        </Grid>

        <!-- 渲染窗口（Spout 宿主）草稿组 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="渲染窗口分辨率" Grid.Row="0" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="TbWinW" Width="70" TextChanged="Draft_Changed" />
                <TextBlock Text="×" Style="{StaticResource RowLab}" Margin="6,0,6,0" />
                <TextBox x:Name="TbWinH" Width="70" TextChanged="Draft_Changed" />
                <TextBlock x:Name="TbResErr" Text="64~4096" Foreground="{StaticResource Danger}"
                           FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock Text="渲染帧率" Grid.Row="1" Style="{StaticResource RowLab}" Margin="0,0,0,6" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="TbWinFps" Width="70" TextChanged="Draft_Changed" />
                <TextBlock Text="fps" Style="{StaticResource RowLab}" Margin="6,0,0,0" />
                <TextBlock x:Name="TbFpsErr" Text="1~240" Foreground="{StaticResource Danger}"
                           FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Spout 组 -->
        <StackPanel Margin="0,12,0,0">
            <CheckBox x:Name="CkSpoutEnabled" Content="Spout 输出" Checked="Draft_Changed" Unchecked="Draft_Changed" />
            <Grid Margin="20,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Spout ID：" Style="{StaticResource RowLab}" Margin="0,0,4,0" />
                <TextBox x:Name="TbSpoutName" Grid.Column="1" TextChanged="Draft_Changed" />
            </Grid>
            <CheckBox x:Name="CkSpoutTransparent" Content="渲染透明背景（输出透明图层）" Margin="0,4,0,0"
                      Checked="Draft_Changed" Unchecked="Draft_Changed" />
            <CheckBox x:Name="CkSpoutLyrics" Content="独立 Spout 字幕通道" Margin="0,4,0,0"
                      Checked="Draft_Changed" Unchecked="Draft_Changed" />
            <StackPanel x:Name="LyricsFpsRow" Margin="20,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="字幕渲染帧率：" Style="{StaticResource RowLab}" Margin="0,0,4,0" />
                    <TextBox x:Name="TbLyricsFps" Width="70" TextChanged="Draft_Changed" />
                    <TextBlock Text="fps" Style="{StaticResource RowLab}" Margin="6,0,0,0" />
                    <TextBlock x:Name="TbLyricsFpsErr" Text="1~240" Foreground="{StaticResource Danger}"
                               FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock Text="字幕通道的输出帧率，生效值不超过渲染帧率；改后随「重启渲染引擎」生效。"
                           Style="{StaticResource Hint}" Margin="0,2,0,0" />
            </StackPanel>
            <CheckBox x:Name="CkSplitMirror" Content="镜像独立进程渲染（GPU 隔离）" Margin="0,4,0,0"
                      Checked="Draft_Changed" Unchecked="Draft_Changed" />
            <TextBlock Text="渲染独立宿主进程，与编辑器互不抢占 GPU。切换会重建镜像输出（短暂黑 1~2 秒）。"
                       Style="{StaticResource Hint}" Margin="20,2,0,0" />
        </StackPanel>

        <!-- 应用 + 重启 -->
        <Button x:Name="BtnRestart" Margin="0,14,0,0" Click="BtnRestart_Click" />
        <TextBlock Text="分辨率・帧率・字幕帧率・Spout・透明背景・镜像独立进程的改动需点上方按钮保存后生效；画布比例即时生效。"
                   Style="{StaticResource Hint}" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>
