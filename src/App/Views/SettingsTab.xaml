<UserControl x:Class="JizuraLive.App.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JizuraLive.App.Controls">
    <!-- 对位 SettingsTab.vue：.sec-h 小节标题 → 留出画面范围 → 画布/渲染窗口参数 → Spout 组 → 重启按钮 + .note -->
    <UserControl.Resources>
        <!-- 行标签（Vue 的 w-[110px] flex-none text-mut，行内 12px） -->
        <Style x:Key="RowLab" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Mut}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 色块输入（对位 input[type=color]：彩色底 + 十六进制字，改色就是改字；StyleTab 同款） -->
        <Style x:Key="SubColorBox" TargetType="TextBox" BasedOn="{StaticResource TbNum}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 字幕卡片（对位 SubtitlePanel.vue：border-line rounded-md bg-raised/60 p-3.5，列表最顶） -->
        <Border BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource Raised}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ctl:JzLabel Text="{DynamicResource Loc.Settings.Subtitle.Title}" Tracking="0.18"
                                 TextElement.FontSize="11" TextElement.FontWeight="SemiBold"
                                 TextElement.Foreground="{StaticResource Mut}" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Loc.Settings.Subtitle.Sub}" FontSize="11"
                               Foreground="{StaticResource Mut}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <!-- 3 列网格（Vue 的 grid grid-cols-3 gap-2）：显示 col-span-2 + 位置 / 数值三连 /
                     字体 col-span-2 / 半透明底条 col-span-3 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Content}"
                                   Style="{StaticResource FieldLab}" />
                        <ComboBox x:Name="CbSubContent" Style="{StaticResource SelSm}" Margin="0,4,0,0"
                                  SelectionChanged="Sub_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Pos}"
                                   Style="{StaticResource FieldLab}" />
                        <ComboBox x:Name="CbSubPos" Style="{StaticResource SelSm}" Margin="0,4,0,0"
                                  SelectionChanged="Sub_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Size}"
                                   Style="{StaticResource FieldLab}" />
                        <TextBox x:Name="TbSubSize" Style="{StaticResource TbNum}" Margin="0,4,0,0"
                                 LostFocus="SubNum_Commit" KeyDown="SubNum_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Stroke}"
                                   Style="{StaticResource FieldLab}"
                                   ToolTip="{DynamicResource Loc.Settings.Subtitle.Stroke.Tip}" />
                        <TextBox x:Name="TbSubStroke" Style="{StaticResource TbNum}" Margin="0,4,0,0"
                                 LostFocus="SubNum_Commit" KeyDown="SubNum_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Color}"
                                   Style="{StaticResource FieldLab}" />
                        <TextBox x:Name="TbSubColor" Style="{StaticResource SubColorBox}" Margin="0,4,0,0"
                                 LostFocus="SubColor_Commit" KeyDown="SubColor_KeyDown" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.StrokeColor}"
                                   Style="{StaticResource FieldLab}" />
                        <TextBox x:Name="TbSubStrokeColor" Style="{StaticResource SubColorBox}" Margin="0,4,0,0"
                                 LostFocus="SubColor_Commit" KeyDown="SubColor_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.OffX}"
                                   Style="{StaticResource FieldLab}"
                                   ToolTip="{DynamicResource Loc.Settings.Subtitle.OffX.Tip}" />
                        <TextBox x:Name="TbSubOffX" Style="{StaticResource TbNum}" Margin="0,4,0,0"
                                 LostFocus="SubNum_Commit" KeyDown="SubNum_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.OffY}"
                                   Style="{StaticResource FieldLab}"
                                   ToolTip="{DynamicResource Loc.Settings.Subtitle.OffY.Tip}" />
                        <TextBox x:Name="TbSubOffY" Style="{StaticResource TbNum}" Margin="0,4,0,0"
                                 LostFocus="SubNum_Commit" KeyDown="SubNum_KeyDown" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Font}"
                                   Style="{StaticResource FieldLab}" />
                        <ComboBox x:Name="CbSubFont" Style="{StaticResource SelSm}" Margin="0,4,0,0"
                                  SelectionChanged="Sub_Changed" />
                    </StackPanel>

                    <CheckBox x:Name="CkSubBar" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                              Checked="Sub_Changed" Unchecked="Sub_Changed">
                        <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Bar}" FontSize="12" />
                    </CheckBox>
                </Grid>

                <!-- C# 扩展（Vue 面板没有）：只影响字幕层本体（Spout 独立字幕通道 / 主通道烤入）。
                     字幕整行单色（不做逐字高亮），所以这一组只剩「行间保持上一句」。 -->
                <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Ext}" Style="{StaticResource FieldLab}"
                           Margin="0,4,0,0" />
                <CheckBox x:Name="CkSubHold" Margin="0,4,0,0"
                          Checked="Sub_Changed" Unchecked="Sub_Changed">
                    <TextBlock Text="{DynamicResource Loc.Settings.Subtitle.Hold}" FontSize="12"
                               TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- .sec-h：标题（.sec-title 11px tracking-.18）＋右侧说明（11px mut） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ctl:JzLabel Text="{DynamicResource Loc.Settings.Section.Title}" Tracking="0.18" TextElement.FontSize="11"
                         TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Mut}" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Loc.Settings.Section.Sub}" FontSize="11"
                       Foreground="{StaticResource Mut}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <!-- checkline：留出画面中央 -->
        <CheckBox x:Name="CkCenterFree" Margin="0,10,0,0" Checked="Center_Changed" Unchecked="Center_Changed">
            <TextBlock Text="{DynamicResource Loc.Settings.CenterFree}" FontSize="12"
                       TextWrapping="Wrap" MaxWidth="276" />
        </CheckBox>

        <!-- v-if="centerFree"：留白位置 / 留白宽度 % / 竖屏分列（flex flex-col gap-2） -->
        <StackPanel x:Name="CenterOpts" Margin="0,8,0,0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Settings.Zone}" Style="{StaticResource RowLab}" />
                <ComboBox x:Name="CbCenterZone" Grid.Column="1" Margin="12,0,0,0"
                          SelectionChanged="Center_Changed" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Settings.Gap}" Style="{StaticResource RowLab}" />
                <TextBox x:Name="TbCenterGap" Grid.Column="1" Width="96" Margin="12,0,0,0"
                         Style="{StaticResource TbNum}" LostFocus="CenterGap_Commit" KeyDown="CenterGap_KeyDown" />
                <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Gap.Unit}" Style="{StaticResource RowLab}"
                           TextWrapping="Wrap" Margin="12,0,0,0" />
            </Grid>
            <Grid x:Name="CenterDirRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Settings.Dir}" Style="{StaticResource RowLab}" />
                <ComboBox x:Name="CbCenterDir" Grid.Column="1" Margin="12,0,0,0"
                          SelectionChanged="Center_Changed" />
            </Grid>
        </StackPanel>

        <!-- 画布比例 / 背景 / 渲染窗口分辨率 / 渲染帧率（flex flex-col gap-2.5） -->
        <StackPanel Margin="0,16,0,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Settings.Aspect}" Style="{StaticResource RowLab}" />
                <ComboBox x:Name="CbAspect" Grid.Column="1" Margin="12,0,0,0"
                          SelectionChanged="CbAspect_SelectionChanged" />
            </Grid>
            <TextBlock Text="{DynamicResource Loc.Settings.Aspect.SameSource}" Style="{StaticResource HintXs}"
                       Margin="0,0,0,10" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Settings.KeyBg}" Style="{StaticResource RowLab}" />
                <ComboBox x:Name="CbKeyBg" Grid.Column="1" Margin="12,0,0,0"
                          SelectionChanged="CbKeyBg_SelectionChanged" />
            </Grid>
            <TextBlock Text="{DynamicResource Loc.Settings.KeyBg.SameSource}"
                       Style="{StaticResource HintXs}" Margin="0,0,0,10" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Settings.WinRes}" Style="{StaticResource RowLab}" />
                <TextBox x:Name="TbWinW" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource TbNum}"
                         TextChanged="Draft_Changed" />
                <TextBlock Grid.Column="2" Text="×" Style="{StaticResource RowLab}" Margin="6,0,6,0" />
                <TextBox x:Name="TbWinH" Grid.Column="3" Style="{StaticResource TbNum}" TextChanged="Draft_Changed" />
                <TextBlock x:Name="TbResErr" Grid.Column="4" Text="64~4096" Foreground="{StaticResource Danger}"
                           FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Settings.WinFps}" Style="{StaticResource RowLab}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBox x:Name="TbWinFps" Width="96" Style="{StaticResource TbNum}" TextChanged="Draft_Changed" />
                    <TextBlock Text="fps" Style="{StaticResource RowLab}" Margin="6,0,0,0" />
                    <TextBlock x:Name="TbFpsErr" Text="1~240" Foreground="{StaticResource Danger}" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Spout 组（flex flex-col gap-1.5 mt-3.5） -->
        <StackPanel Margin="0,14,0,0">
            <CheckBox x:Name="CkSpoutEnabled" Content="{DynamicResource Loc.Settings.Spout.Title}" Margin="0,0,0,6"
                      Checked="Draft_Changed" Unchecked="Draft_Changed" />
            <Grid Margin="24,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Settings.Spout.Id}" Style="{StaticResource RowLab}" />
                <TextBox x:Name="TbSpoutName" Grid.Column="1" Margin="12,0,0,0" TextChanged="Draft_Changed" />
            </Grid>
            <CheckBox x:Name="CkSpoutTransparent" Content="{DynamicResource Loc.Settings.Spout.Transparent}" Margin="0,0,0,6"
                      Checked="Draft_Changed" Unchecked="Draft_Changed" />
        </StackPanel>

        <!-- 字体（即时生效，不需要重启渲染引擎） -->
        <StackPanel Margin="0,14,0,0">
            <CheckBox x:Name="CkFetchFonts" Margin="0,0,0,6"
                      Checked="FetchFonts_Changed" Unchecked="FetchFonts_Changed">
                <TextBlock Text="{DynamicResource Loc.Settings.Fonts.Fetch}" FontSize="12" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                <TextBlock Text="{DynamicResource Loc.Settings.Fonts.UserDir}" Style="{StaticResource RowLab}" />
                <Button x:Name="BtnOpenFontDir" Content="{DynamicResource Loc.Settings.Fonts.OpenDir}"
                        Style="{StaticResource BtnGhostSm}" Margin="6,0,0,0" Click="BtnOpenFontDir_Click" />
            </StackPanel>
            <TextBlock x:Name="TblFontDir" Style="{StaticResource HintXs}" Margin="24,0,0,6" TextWrapping="Wrap" MaxWidth="300"
                       HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource HintXs}" Margin="24,0,0,6" TextWrapping="Wrap" MaxWidth="300"
                       HorizontalAlignment="Left"
                       Text="{DynamicResource Loc.Settings.Fonts.Hint}" />
        </StackPanel>

        <!-- 存储空间与缓存清理（即时生效） -->
        <Border BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource Raised}" Padding="12" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ctl:JzLabel Text="{DynamicResource Loc.Settings.Storage.Title}" Tracking="0.14" TextElement.FontSize="11"
                                 TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Mut}" />
                    <Button Grid.Column="1" x:Name="BtnOpenDataDir" Content="{DynamicResource Loc.Settings.Storage.OpenDir}"
                            Style="{StaticResource BtnGhostSm}" Click="BtnOpenDataDir_Click" />
                </Grid>
                <TextBlock x:Name="TblStorageInfo" Style="{StaticResource HintXs}" Margin="0,8,0,8" />
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="BtnCleanCache" Content="{DynamicResource Loc.Settings.Storage.CleanCache}"
                            Style="{StaticResource BtnSm}" Margin="0,0,8,4" Click="BtnCleanCache_Click" />
                    <Button x:Name="BtnCleanCloud" Content="{DynamicResource Loc.Settings.Storage.CleanCloud}"
                            Style="{StaticResource BtnSm}" Margin="0,0,8,4" Click="BtnCleanCloud_Click" />
                    <Button x:Name="BtnCleanLogs" Content="{DynamicResource Loc.Settings.Storage.CleanLogs}"
                            Style="{StaticResource BtnSm}" Margin="0,0,8,4" Click="BtnCleanLogs_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 界面语言（即时生效，热切换；语言清单随词库目录扩展） -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Loc.Settings.UiLang}" Style="{StaticResource RowLab}"
                       ToolTip="{DynamicResource Loc.Settings.UiLang.Tip}" />
            <ComboBox x:Name="CbUiLang" Grid.Column="1" Margin="12,0,0,0" Width="160"
                      HorizontalAlignment="Left" SelectionChanged="UiLang_Changed" />
        </Grid>

        <!-- 保存并重启渲染引擎（btn btn-primary w-full mt-4） -->
        <Button x:Name="BtnRestart" Style="{StaticResource BtnPrimary}" Margin="0,16,0,0"
                Click="BtnRestart_Click" />

        <!-- .note：分辨率・帧率・… 的改动需点上方按钮保存后生效 -->
        <Border BorderBrush="{StaticResource Line2}" BorderThickness="2,0,0,0" Padding="10,0,0,0"
                Margin="0,12,0,0">
            <TextBlock Style="{StaticResource NoteTx}"
                       Text="{DynamicResource Loc.Settings.Note}" />
        </Border>
    </StackPanel>
</UserControl>
