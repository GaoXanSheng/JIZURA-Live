<Window x:Class="JizuraLive.App.Views.PvActorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JizuraLive.App.Views"
        Title="角色动效独立监视器 - JIZURA Live" Width="560" Height="400" MinWidth="380" MinHeight="280"
        Background="{StaticResource Panel}" Foreground="{StaticResource Fg}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏工具：置顶开关 + 状态 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <CheckBox x:Name="CkTopmost" Content="窗口置顶" VerticalAlignment="Center"
                      Foreground="{StaticResource Mut}" FontSize="12" Checked="CkTopmost_Changed" Unchecked="CkTopmost_Changed" />
            <TextBlock Text="实时监视：节拍下沉律动 · 呼吸脉冲光晕 · 白闪协同"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource Mut}" FontSize="11" />
        </DockPanel>

        <!-- 视口容器 -->
        <Border Grid.Row="1" Background="{StaticResource Raised}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="6">
            <views:PvActorPreviewView x:Name="PreviewView" />
        </Border>
    </Grid>
</Window>
