<Window x:Class="JizuraLive.App.ExportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.ExportProgress.Title}" Width="440" Height="150"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" Foreground="{StaticResource Fg}"
        FontSize="12">
    <StackPanel Margin="18,14">
        <TextBlock x:Name="TblStage" Text="{DynamicResource Loc.ExportProgress.Preparing}" Foreground="{StaticResource Fg}" />
        <ProgressBar x:Name="Bar" Height="14" Margin="0,10,0,10"
                     Minimum="0" Maximum="100" Foreground="{StaticResource Amber}" />
        <DockPanel>
            <Button x:Name="BtnCancel" Content="{DynamicResource Loc.ExportProgress.Cancel}" DockPanel.Dock="Right" MinWidth="72"
                    Click="BtnCancel_Click" />
            <TextBlock x:Name="TblPct" VerticalAlignment="Center"
                       FontFamily="Consolas" Foreground="{StaticResource Mut}" Text="0%" />
        </DockPanel>
    </StackPanel>
</Window>
