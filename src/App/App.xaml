<Application x:Class="JizuraLive.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 设计 token 与全局控件样式（从 frontend/src/styles/main.css 搬运） -->
                <ResourceDictionary Source="Theme.xaml" />
                <!-- PV 工作台的新设计语言（P5）：冷调近黑 + 靛蓝主色，与旧主题刻意区分。
                     放在 App 级是因为窗口自身的 Background/FontFamily 属性要在 Window.Resources
                     之前解析——StaticResource 找不到同一元素里后声明的资源。 -->
                <ResourceDictionary Source="PvStage/PvTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 窗口 chrome 专用（无边框标题栏）；面板级样式统一走 Theme.xaml -->
            <SolidColorBrush x:Key="FgMain" Color="#FFE6E6EC" />
            <Style x:Key="ChromeBtn" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource FgMain}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#44FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
