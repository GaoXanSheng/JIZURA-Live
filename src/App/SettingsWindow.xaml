<Window x:Class="JizuraLive.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JizuraLive"
             Title="设置"
             WindowStyle="None"
             AllowsTransparency="True"
             Background="Transparent"
             ShowInTaskbar="False"
             ShowActivated="True"
             ResizeMode="NoResize"
             SizeToContent="WidthAndHeight">
    <local:SettingsPanel x:Name="SettingsCtl"/>
</Window>
