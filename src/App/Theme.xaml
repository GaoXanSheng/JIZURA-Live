<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:JizuraLive.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- ============================================================
         设计 token：从 frontend/src/styles/main.css @theme 逐值搬运（暗色 + 琥珀基因）
         ============================================================ -->
    <SolidColorBrush x:Key="Ink" Color="#FF0C0C0E" />
    <SolidColorBrush x:Key="Panel" Color="#FF131316" />
    <SolidColorBrush x:Key="Raised" Color="#FF1B1B20" />
    <SolidColorBrush x:Key="Raised2" Color="#FF232329" />
    <SolidColorBrush x:Key="LineBrush" Color="#FF2A2A31" />
    <SolidColorBrush x:Key="Line2" Color="#FF383840" />
    <SolidColorBrush x:Key="Fg" Color="#FFECE7E1" />
    <SolidColorBrush x:Key="Mut" Color="#FF8E8A94" />
    <SolidColorBrush x:Key="Faint" Color="#FF5D5A63" />
    <SolidColorBrush x:Key="Amber" Color="#FFF5A50C" />
    <SolidColorBrush x:Key="Cyan" Color="#FF16F4D4" />
    <SolidColorBrush x:Key="Rose" Color="#FFFF6F9C" />
    <SolidColorBrush x:Key="Danger" Color="#FFFF5A6A" />

    <!-- 派生色（border-amber/55、bg-white/5、btn hover 边框一类） -->
    <SolidColorBrush x:Key="Amber55" Color="#8CF5A50C" />
    <SolidColorBrush x:Key="Amber60" Color="#99F5A50C" />
    <SolidColorBrush x:Key="Amber10" Color="#1AF5A50C" />
    <SolidColorBrush x:Key="Amber12" Color="#1FF5A50C" />
    <SolidColorBrush x:Key="Amber25" Color="#40F5A50C" />
    <SolidColorBrush x:Key="Cyan55" Color="#8C16F4D4" />
    <SolidColorBrush x:Key="Rose60" Color="#99FF6F9C" />
    <SolidColorBrush x:Key="Purple60" Color="#99B48CFF" />
    <SolidColorBrush x:Key="Green55" Color="#8C78C878" />
    <SolidColorBrush x:Key="Blue60" Color="#9978AAFF" />
    <SolidColorBrush x:Key="ChipGray" Color="#FF55525C" />
    <SolidColorBrush x:Key="HoverWhite5" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="BtnHoverBorder" Color="#FF4A4A54" />
    <SolidColorBrush x:Key="PrimaryInk" Color="#FF120C00" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#FFFFB52A" />
    <SolidColorBrush x:Key="DangerBg" Color="#FFC9433A" />
    <SolidColorBrush x:Key="DangerHover" Color="#FFDD5146" />
    <SolidColorBrush x:Key="Ink85" Color="#D90C0C0E" />

    <!-- ============================================================
         字体：font-ui / font-mono。界面字体用系统字体（微软雅黑；英文/符号回退 Segoe UI），
         不走自托管 webfont——WPF 的 pack 资源字体 URI 实测解析不到，且雅黑在中文 Windows 上必然存在。
         exe 旁 fonts\ 只服务引擎（PV 渲染的字体目录），与界面字体无关。
         ============================================================ -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <!-- 元素默认：body 13px / line-height 1.5 -->
    <sys:Double x:Key="BaseFontSize">13</sys:Double>
    <sys:Double x:Key="BaseLineHeight">19.5</sys:Double>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ============================================================
         文字类（.sec-title / .hint / .mut / .mono / .field / .note / .kbd）
         ============================================================ -->
    <Style x:Key="SecTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="TextBlock.LineHeight" Value="16.5" />
    </Style>
    <Style x:Key="SecSub" TargetType="TextBlock" BasedOn="{StaticResource SecTitle}">
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <!-- 面板内小节标签（对位旧 .field 的标签行） -->
    <Style x:Key="PanelLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="HintXs" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16.5" />
    </Style>
    <Style x:Key="MutTx" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
    </Style>
    <Style x:Key="FaintTx" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style x:Key="MonoTx" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style x:Key="MonoMut" TargetType="TextBlock" BasedOn="{StaticResource MonoTx}">
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
    </Style>
    <Style x:Key="FieldLab" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="LineHeight" Value="16.5" />
    </Style>
    <Style x:Key="NoteTx" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- .note 的左竖线：TextBlock 无边框，用 Border 包一层（BorderThickness="2,0,0,0" + Padding="10,0,0,0"） -->

    <!-- ============================================================
         按钮：.btn / .btn-sm / .btn-ghost / .btn-primary / .btn-accent /
               .btn-danger / .btn-icon / .btn-file；aria-pressed → Tag="on"
         ============================================================ -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BtnHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Margin" Value="0,1,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- .btn（默认） -->
    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}" />
    <!-- .btn-sm：h26 / px10 / 12px -->
    <Style x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- .btn-ghost：透明底 + line 边 -->
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>
    <Style x:Key="BtnGhostSm" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- .btn-ghost.btn-icon：只有图标 -->
    <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Height" Value="26" />
    </Style>
    <!-- .btn-primary：琥珀底深字 -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Amber}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryInk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#F5A50C" BlurRadius="14" ShadowDepth="2" Opacity="0.25" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHover}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Margin" Value="0,1,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- .btn-accent：琥珀描边 + 琥珀字 -->
    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber55}" />
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Amber10}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Margin" Value="0,1,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BtnAccentSm" TargetType="Button" BasedOn="{StaticResource BtnAccent}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- .btn-danger -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Background" Value="{StaticResource DangerBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBg}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style x:Key="BtnDangerSm" TargetType="Button" BasedOn="{StaticResource BtnDanger}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- .btn-file：虚线框文件按钮 -->
    <Style x:Key="BtnFile" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Border>
                        <Rectangle x:Name="dash" Stroke="{StaticResource Line2}" StrokeThickness="1"
                                   StrokeDashArray="2.4 1.8" RadiusX="6" RadiusY="6" Fill="Transparent"
                                   SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Amber10}" />
                            <Setter TargetName="dash" Property="Stroke" Value="{StaticResource Amber}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Margin" Value="0,1,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右栏页签（五等分）：选中态 = 亮字 + 琥珀下边框 -->
    <Style x:Key="TabHeader" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}" />
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         切分 chip（自定义控件 JzChip）：<b>前缀</b>值。
         注意顺序：隐式样式必须先于下面的描边变体（WPF 的 StaticResource 不做前向解析）
         ============================================================ -->
    <Style TargetType="{x:Type ctl:JzChip}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="19" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:JzChip}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Lead}" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource Mut}" Margin="0,0,4,0"
                                       Visibility="{Binding Lead, RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={x:Static ctl:JzChip.LeadVisibility}}" />
                            <TextBlock Text="{TemplateBinding Value}" FontSize="11"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- chip 描边变体（圆角胶囊，11px；分组配色见旧 main.css .chip-l/e/x/t/b/c/h） -->
    <Style x:Key="ChipL" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource Amber60}" />
    </Style>
    <Style x:Key="ChipE" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource Cyan55}" />
    </Style>
    <Style x:Key="ChipX" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource Rose60}" />
    </Style>
    <Style x:Key="ChipT" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource Purple60}" />
    </Style>
    <Style x:Key="ChipB" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource Green55}" />
    </Style>
    <Style x:Key="ChipC" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource Blue60}" />
    </Style>
    <Style x:Key="ChipH" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource ChipGray}" />
    </Style>

    <!-- 套装徽标 .badge-set（自定义控件：JzBadge） -->
    <Style TargetType="{x:Type ctl:JzBadge}">
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:JzBadge}">
                    <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="3,0">
                        <TextBlock Text="{TemplateBinding Text}" FontSize="10" LineHeight="14"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BadgeEx" TargetType="{x:Type ctl:JzBadge}" BasedOn="{StaticResource {x:Type ctl:JzBadge}}">
        <Setter Property="Foreground" Value="{StaticResource Cyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cyan}" />
    </Style>

    <!-- ============================================================
         输入：input / textarea / select / checkbox / switch / range
         ============================================================ -->
    <Style x:Key="TbBase" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Amber}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Amber}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" BorderThickness="3"
                                BorderBrush="{StaticResource Amber12}" Visibility="Collapsed" Margin="-3" />
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber55}" />
                            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource TbBase}" />
    <!-- 数字框（.mono） -->
    <Style x:Key="TbNum" TargetType="TextBox" BasedOn="{StaticResource TbBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <!-- 单行小框：h26 / 12px（行时刻输入） -->
    <Style x:Key="TbSm" TargetType="TextBox" BasedOn="{StaticResource TbNum}">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="3,0" />
    </Style>
    <!-- 单行微框：h22 / 10px（切分边界时刻） -->
    <Style x:Key="TbXs" TargetType="TextBox" BasedOn="{StaticResource TbNum}">
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="2,0" />
    </Style>
    <!-- textarea（歌词）：py6 / line-height 1.7 -->
    <Style x:Key="Ta" TargetType="TextBox" BasedOn="{StaticResource TbBase}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="TextBlock.LineHeight" Value="22" />
        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" BorderThickness="3"
                                BorderBrush="{StaticResource Amber12}" Visibility="Collapsed" Margin="-3" />
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber55}" />
                            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- select：暗色 + 右侧双斜线箭头 -->
    <Style x:Key="SelBase" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0,22,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Fg}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="9,5" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" BorderThickness="3"
                                BorderBrush="{StaticResource Amber12}" Visibility="Collapsed" Margin="-3" />
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <ContentPresenter x:Name="cp" IsHitTestVisible="False"
                                                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <Path Data="M 0 0 L 3.6 3.6 L 7.2 0" Stroke="{StaticResource Mut}"
                                      StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                            </Grid>
                        </Border>
                        <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="False" Focusable="False" PopupAnimation="Fade" VerticalOffset="3">
                            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line2}"
                                    BorderThickness="1" CornerRadius="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="300" Margin="0,0,10,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="3" Opacity="0.55" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber55}" />
                            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource SelBase}" />
    <!-- !h-7：歌词语言等 -->
    <Style x:Key="SelSm" TargetType="ComboBox" BasedOn="{StaticResource SelBase}">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="7,0,18,0" />
    </Style>
    <!-- 行内手法下拉：h22 / 10px -->
    <Style x:Key="SelXs" TargetType="ComboBox" BasedOn="{StaticResource SelBase}">
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="4,0,14,0" />
    </Style>

    <!-- checkbox：14×14，选中琥珀底深勾 -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="14" Height="14" CornerRadius="3" Background="{StaticResource Raised}"
                                BorderBrush="{StaticResource Line2}" BorderThickness="1" VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="check" Data="M 2.5 7 L 5.5 10 L 11 3.5" Stroke="{StaticResource PrimaryInk}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="cp" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Amber}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Amber}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Amber60}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .switch：30×17 胶囊开关（用法：<ToggleButton Style="{StaticResource Switch}" />） -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="tr" CornerRadius="9" Background="{StaticResource Line2}" />
                        <Ellipse x:Name="knob" Width="13" Height="13" Fill="#FF7A7680" HorizontalAlignment="Left"
                                 Margin="2,0,2,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tr" Property="Background" Value="{StaticResource Amber25}" />
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource Amber}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 进度：.progress（h6 圆角槽 + cyan→amber 渐变条） -->
    <Style x:Key="ProgTrack" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{StaticResource Raised2}" />
    </Style>

    <!-- ============================================================
         滚动条：宽 10，滑块 line 色，槽透明
         ============================================================ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bd" Background="{StaticResource LineBrush}" CornerRadius="5" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Line2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter Property="MinHeight" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTip：暗色气泡 -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line2}"
                            BorderThickness="1" CornerRadius="6" Padding="8,5" MaxWidth="420">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="2" Opacity="0.5" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 参数滑块（暗色轨道 + Amber 进度/拇指，对位旧版 range 观感）：
         界面里两处用（特效面板的 fx 参数行、音频效果弹窗的参数行/变速行），放主题级共用 -->
    <Style x:Key="FxSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="SmallChange" Value="0.01" />
        <Setter Property="LargeChange" Value="0.1" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2,0,0,2" Background="{StaticResource Amber}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="0,2,2,0" Background="{StaticResource Raised2}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="thumb" Width="12" Height="12" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource Amber}" Stroke="{StaticResource Ink}" StrokeThickness="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 通用几何图标（16 视图框，stroke 1.4 currentColor） -->
    <Geometry x:Key="IconLockPath">M5 7V5a3 3 0 0 1 6 0v2</Geometry>
    <Geometry x:Key="IconLockBody">M3 7h10v7H3z</Geometry>
    <Geometry x:Key="IconEditPath">M3 13l1-3.5L11 2.5l2.5 2.5L6.5 12z</Geometry>
    <Geometry x:Key="IconEditLine">M9.5 4l2.5 2.5</Geometry>
    <Geometry x:Key="IconTapOuter">M8 2.5a5.5 5.5 0 1 0 0 11a5.5 5.5 0 0 0 0-11z</Geometry>
    <Geometry x:Key="IconTapInner">M8 5.8a2.2 2.2 0 1 0 0 4.4a2.2 2.2 0 0 0 0-4.4z</Geometry>
    <Geometry x:Key="IconRangeEdge">M3 3v10M13 3v10</Geometry>
    <Geometry x:Key="IconRangeArrow">M5.5 8h5M8.5 5.5L11 8l-2.5 2.5</Geometry>
</ResourceDictionary>
