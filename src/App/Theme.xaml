<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:JizuraLive.App.Controls"
                    xmlns:app="clr-namespace:JizuraLive.App"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- ============================================================
         动效：时长/缓动 token 全在 JzAnim.cs（界面层唯一一份），这里用 {x:Static} 引用。
         模板内只做 ≤130ms 的微交互（hover / 按下 / 勾选 / 聚焦），一律只动 Opacity 与
         RenderTransform；颜色过渡只用两种安全写法：
           ① 叠加层交叉淡入 —— 目标色未知或随变体变时（按钮 / 页签 / chip），叠一个目标色的
              Border 动画它的 Opacity（Theme 里的画刷是共享单例，改色会波及全应用）；
           ② 模板内局部画刷 —— 目标色固定时（开关 / 复选框 / 下拉项），在模板里写
              <SolidColorBrush x:Name="..."/>，每个控件实例各一份，可安全做 ColorAnimation。
         每处动画都要配对的 EnterActions / ExitActions：HoldEnd 会永久压住基值，必须淡回去。
         ============================================================ -->

    <!-- ============================================================
         设计 token（P5 起为新设计语言）：**冷调近黑 + 靛蓝主色**。
         原先是从 frontend/src/styles/main.css @theme 逐值搬运的「暗色 + 琥珀」；
         换成冷调的理由：这工具长时间盯画面做视觉判断，冷调不刺眼，且与 PV 画面里常见的
         暖色内容（肤色、暖光）形成中性衬底。令牌名保持不变，所以全部控件自动换肤。
         ============================================================ -->
    <SolidColorBrush x:Key="Ink" Color="#FF0A0A0D" />
    <SolidColorBrush x:Key="Panel" Color="#FF101015" />
    <SolidColorBrush x:Key="Raised" Color="#FF17171E" />
    <SolidColorBrush x:Key="Raised2" Color="#FF1E1E27" />
    <SolidColorBrush x:Key="LineBrush" Color="#FF23232C" />
    <SolidColorBrush x:Key="Line2" Color="#FF31313C" />
    <SolidColorBrush x:Key="Fg" Color="#FFECECF2" />
    <SolidColorBrush x:Key="Mut" Color="#FF9A9AA8" />
    <SolidColorBrush x:Key="Faint" Color="#FF5E5E6C" />
    <SolidColorBrush x:Key="Amber" Color="#FF5B8CFF" />
    <SolidColorBrush x:Key="Cyan" Color="#FF38E1C4" />
    <SolidColorBrush x:Key="Rose" Color="#FFFF6F9C" />
    <SolidColorBrush x:Key="Danger" Color="#FFFF5F6E" />

    <!-- 派生色（border-amber/55、bg-white/5、btn hover 边框一类） -->
    <SolidColorBrush x:Key="Amber55" Color="#8C5B8CFF" />
    <SolidColorBrush x:Key="Amber60" Color="#995B8CFF" />
    <SolidColorBrush x:Key="Amber10" Color="#1A5B8CFF" />
    <SolidColorBrush x:Key="Amber12" Color="#1F5B8CFF" />
    <SolidColorBrush x:Key="Amber25" Color="#405B8CFF" />
    <SolidColorBrush x:Key="Cyan55" Color="#8C38E1C4" />
    <SolidColorBrush x:Key="Rose60" Color="#99FF6F9C" />
    <SolidColorBrush x:Key="Purple60" Color="#99B48CFF" />
    <SolidColorBrush x:Key="Green55" Color="#8C78C878" />
    <SolidColorBrush x:Key="Blue60" Color="#9978AAFF" />
    <SolidColorBrush x:Key="ChipGray" Color="#FF5E5E6C" />
    <SolidColorBrush x:Key="HoverWhite5" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="BtnHoverBorder" Color="#FF3A3A46" />
    <SolidColorBrush x:Key="PrimaryInk" Color="#FF08101F" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#FF7AA3FF" />
    <SolidColorBrush x:Key="DangerBg" Color="#FFC9433A" />
    <SolidColorBrush x:Key="DangerHover" Color="#FFDD5146" />
    <SolidColorBrush x:Key="Ink85" Color="#D90A0A0D" />

    <!-- ============================================================
         字体：font-ui / font-mono。界面字体用系统字体（微软雅黑；英文/符号回退 Segoe UI），
         不走自托管 webfont——WPF 的 pack 资源字体 URI 实测解析不到，且雅黑在中文 Windows 上必然存在。
         exe 旁 fonts\ 只服务引擎（PV 渲染的字体目录），与界面字体无关。
         ============================================================ -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <!-- 元素默认：body 13px / line-height 1.5 -->
    <sys:Double x:Key="BaseFontSize">13</sys:Double>
    <sys:Double x:Key="BaseLineHeight">19.5</sys:Double>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ============================================================
         文字类（.sec-title / .hint / .mut / .mono / .field / .note / .kbd）
         ============================================================ -->
    <Style x:Key="SecTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="TextBlock.LineHeight" Value="16.5" />
    </Style>
    <Style x:Key="SecSub" TargetType="TextBlock" BasedOn="{StaticResource SecTitle}">
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <!-- 面板内小节标签（对位旧 .field 的标签行） -->
    <Style x:Key="PanelLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="HintXs" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16.5" />
    </Style>
    <Style x:Key="MutTx" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
    </Style>
    <Style x:Key="FaintTx" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style x:Key="MonoTx" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style x:Key="MonoMut" TargetType="TextBlock" BasedOn="{StaticResource MonoTx}">
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
    </Style>
    <Style x:Key="FieldLab" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="LineHeight" Value="16.5" />
    </Style>
    <Style x:Key="NoteTx" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- .note 的左竖线：TextBlock 无边框，用 Border 包一层（BorderThickness="2,0,0,0" + Padding="10,0,0,0"） -->

    <!-- ============================================================
         按钮：.btn / .btn-sm / .btn-ghost / .btn-primary / .btn-accent /
               .btn-danger / .btn-icon / .btn-file；aria-pressed → Tag="on"
         ============================================================ -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 三明治：底(bd) → hover 叠加层(hx，只动 Opacity) → 内容。
                         内容从 bd 里搬到 Grid 上：hover 层必须盖住底、又被内容盖住。
                         按下 = 整层下移 1px（原先改 bd 的 Margin，会白跑一趟布局）。 -->
                    <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="prs" />
                        </Grid.RenderTransform>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True" />
                        <Border x:Name="hx" Background="{StaticResource Raised2}"
                                BorderBrush="{StaticResource BtnHoverBorder}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Opacity="0" IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="1" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- .btn（默认） -->
    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}" />
    <!-- .btn-sm：h26 / px10 / 12px -->
    <Style x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- .btn-ghost：透明底 + line 边 -->
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>
    <Style x:Key="BtnGhostSm" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- .btn-ghost.btn-icon：只有图标 -->
    <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Height" Value="26" />
    </Style>
    <!-- .btn-primary：琥珀底深字 -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Amber}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryInk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#5B8CFF" BlurRadius="14" ShadowDepth="2" Opacity="0.25" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="prs" />
                        </Grid.RenderTransform>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" />
                        <Border x:Name="hx" Background="{StaticResource PrimaryHover}"
                                BorderBrush="{StaticResource PrimaryHover}" BorderThickness="1"
                                CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="1" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- .btn-accent：琥珀描边 + 琥珀字 -->
    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber55}" />
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="prs" />
                        </Grid.RenderTransform>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" />
                        <Border x:Name="hx" Background="{StaticResource Amber10}"
                                BorderBrush="{StaticResource Amber}" BorderThickness="1"
                                CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="1" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BtnAccentSm" TargetType="Button" BasedOn="{StaticResource BtnAccent}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- .btn-danger -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Background" Value="{StaticResource DangerBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBg}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style x:Key="BtnDangerSm" TargetType="Button" BasedOn="{StaticResource BtnDanger}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- .btn-file：虚线框文件按钮 -->
    <Style x:Key="BtnFile" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="prs" />
                        </Grid.RenderTransform>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" />
                        <Border x:Name="hx" Background="{StaticResource Amber10}" CornerRadius="6"
                                Opacity="0" IsHitTestVisible="False" />
                        <Rectangle x:Name="dash" Stroke="{StaticResource Line2}" StrokeThickness="1"
                                   StrokeDashArray="2.4 1.8" RadiusX="6" RadiusY="6" Fill="Transparent"
                                   SnapsToDevicePixels="True" />
                        <!-- 虚线框的琥珀态：叠在虚线上淡入（虚线是描边，没法做叠加底，单独一份）
                             —— 琥珀不透明，淡到位时正好盖住 line2 那份 -->
                        <Rectangle x:Name="dashOn" Stroke="{StaticResource Amber}" StrokeThickness="1"
                                   StrokeDashArray="2.4 1.8" RadiusX="6" RadiusY="6" Fill="Transparent"
                                   Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="dashOn" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="dashOn" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="1" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右栏页签（五等分）：选中态 = 亮字 + 琥珀下划线（下划线是模板里的 ul 横条，见模板） -->
    <Style x:Key="TabHeader" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 下划线从不透明琥珀 Border 改成一枚独立横条：才能淡入淡出（边框色没法渐变，
                         共享画刷更不能动）。hover 白 5% 叠在底下，横条压在它上面。 -->
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" />
                        <Border x:Name="hx" Background="{StaticResource HoverWhite5}" Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="ul" Height="2" VerticalAlignment="Bottom"
                                Background="{StaticResource Amber}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <!-- Setter 兜底静态态，动画走显式 From/To：即便 EnterActions 在装载时机上有出入，
                                 选中态也不会丢下划线 -->
                            <Setter TargetName="ul" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ul" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ul" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         切分 chip（自定义控件 JzChip）：<b>前缀</b>值。
         注意顺序：隐式样式必须先于下面的描边变体（WPF 的 StaticResource 不做前向解析）
         ============================================================ -->
    <Style TargetType="{x:Type ctl:JzChip}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="19" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:JzChip}">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" />
                        <!-- hover 的琥珀描边：底边随分组配色变（ChipL/E/X/T/B/C/H 各自一份共享画刷），
                             所以不能改画刷 —— 叠一层琥珀描边淡入 -->
                        <Border x:Name="hx" BorderBrush="{StaticResource Amber}" BorderThickness="1"
                                CornerRadius="10" Opacity="0" IsHitTestVisible="False" />
                        <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Lead}" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource Mut}" Margin="0,0,4,0"
                                       Visibility="{Binding Lead, RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={x:Static ctl:JzChip.LeadVisibility}}" />
                            <TextBlock Text="{TemplateBinding Value}" FontSize="11"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- chip 描边变体（圆角胶囊，11px；分组配色见旧 main.css .chip-l/e/x/t/b/c/h） -->
    <Style x:Key="ChipL" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
