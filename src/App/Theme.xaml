    <Style x:Key="BadgeEx" TargetType="{x:Type ctl:JzBadge}" BasedOn="{StaticResource {x:Type ctl:JzBadge}}">
        <Setter Property="Foreground" Value="{StaticResource Cyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cyan}" />
    </Style>

    <!-- ============================================================
         输入：input / textarea / select / checkbox / switch / range
         ============================================================ -->
    <Style x:Key="TbBase" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Amber}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Amber}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" BorderThickness="3"
                                BorderBrush="{StaticResource Amber12}" Visibility="Collapsed" Margin="-3" />
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber55}" />
                            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                            <!-- 光环淡入（Visibility 上没法做动画，只能动画 Opacity）。
                                 失焦即时收起，退出淡出肉眼看不到，就不为它做延迟折叠了 -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource TbBase}" />
    <!-- 数字框（.mono） -->
    <Style x:Key="TbNum" TargetType="TextBox" BasedOn="{StaticResource TbBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <!-- 单行小框：h26 / 12px（行时刻输入） -->
    <Style x:Key="TbSm" TargetType="TextBox" BasedOn="{StaticResource TbNum}">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="3,0" />
    </Style>
    <!-- 单行微框：h22 / 10px（切分边界时刻） -->
    <Style x:Key="TbXs" TargetType="TextBox" BasedOn="{StaticResource TbNum}">
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="2,0" />
    </Style>
    <!-- textarea（歌词）：py6 / line-height 1.7 -->
    <Style x:Key="Ta" TargetType="TextBox" BasedOn="{StaticResource TbBase}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="TextBlock.LineHeight" Value="22" />
        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" BorderThickness="3"
                                BorderBrush="{StaticResource Amber12}" Visibility="Collapsed" Margin="-3" />
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber55}" />
                            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                            <!-- 光环淡入（Visibility 上没法做动画，只能动画 Opacity）。
                                 失焦即时收起，退出淡出肉眼看不到，就不为它做延迟折叠了 -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- select：暗色 + 右侧双斜线箭头 -->
    <Style x:Key="SelBase" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0,22,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Fg}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="9,5" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <!-- 高亮做成叠加层：IsSelected 与 IsHighlighted 会同时为真（选中项被悬停），
                                     两者若都动画 bd.Background，退出时钟会把选中态也淡掉 -->
                                <Grid>
                                    <Border x:Name="bd" Background="Transparent" />
                                    <Border x:Name="hv" Background="{StaticResource Raised2}" Opacity="0"
                                            IsHitTestVisible="False" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                                     EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                                     EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" BorderThickness="3"
                                BorderBrush="{StaticResource Amber12}" Visibility="Collapsed" Margin="-3" />
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 选中项文字：ContentPresenter 为字符串内容生成的 TextBlock 会吃到 Theme 的
                                     隐式 TextBlock 样式（13px），而 ComboBox 的 MeasureOverride 是按自身
                                     FontSize 量的 —— 量 10px 画 13px，框比字窄，末字被右侧箭头压住
                                     （行内手法下拉「电子跑马灯」只出前四字）。这里用局部资源样式顶掉隐式
                                     样式，字号/字体/前景改由控件继承（与量测同源），并压平行高、超长出省略号。 -->
                                <ContentPresenter x:Name="cp" Grid.Column="0" IsHitTestVisible="False"
                                                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="LineHeight" Value="NaN" />
                                            <Setter Property="LineStackingStrategy" Value="MaxHeight" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <!-- 可编辑模式的输入框：IsEditable=True 时显示（WPF 按 PART_EditableTextBox
                                     这个名字对接内部的文本/选区/输入法逻辑，缺了它 Text 就没有落点——
                                     PV 面板「源名」下拉当初就是因此一片空白）。Style 置空以避开隐式 TextBox 样式。 -->
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Style="{x:Null}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         FontSize="{TemplateBinding FontSize}"
                                         Padding="{TemplateBinding Padding}"
                                         VerticalContentAlignment="Center"
                                         Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}" />
                                <Path Grid.Column="1" Data="M 0 0 L 3.6 3.6 L 7.2 0" Stroke="{StaticResource Mut}"
                                      StrokeThickness="1.4" VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                            </Grid>
                        </Border>
                        <!-- 整块可点 = 开下拉；可编辑时缩到右侧箭头区，把文字区让给输入框 -->
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press" Background="Transparent"
                                      BorderThickness="0" HorizontalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="False" Focusable="False" PopupAnimation="Fade" VerticalOffset="3">
                            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line2}"
                                    BorderThickness="1" CornerRadius="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="300" Margin="0,0,10,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="3" Opacity="0.55" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 可编辑：显示输入框、收起整块热区（只留右侧箭头），未编辑项文字让位 -->
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="cp" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="toggle" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="toggle" Property="Width" Value="26" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber55}" />
                            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource SelBase}" />
    <!-- !h-7：歌词语言等 -->
    <Style x:Key="SelSm" TargetType="ComboBox" BasedOn="{StaticResource SelBase}">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="7,0,22,0" />
    </Style>
    <!-- 行内手法下拉：h22 / 10px -->
    <Style x:Key="SelXs" TargetType="ComboBox" BasedOn="{StaticResource SelBase}">
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="10" />
        <!-- 右内边距必须盖住右侧箭头区（箭头 7.2 宽 + 10 右边距 ≈ 17.2）：14 时箭头会压在
             末字上（「电子跑马灯」看着像被裁掉一个字）。Padding 也进量测，框会跟着变宽。 -->
        <Setter Property="Padding" Value="4,0,22,0" />
    </Style>

    <!-- checkbox：14×14，选中琥珀底深勾 -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!-- 14×14 盒子拆成三层：常态底 / 选中琥珀底 / hover 描边，各由一个条件单独驱动。
                             合成一个 Border 的话，IsChecked 与 IsMouseOver 会抢同一个 Background，
                             退出时钟会把选中态也淡掉。 -->
                        <Grid x:Name="box" Width="14" Height="14" VerticalAlignment="Center">
                            <Border x:Name="boxOff" CornerRadius="3" Background="{StaticResource Raised}"
                                    BorderBrush="{StaticResource Line2}" BorderThickness="1" SnapsToDevicePixels="True" />
                            <Border x:Name="boxOn" CornerRadius="3" Background="{StaticResource Amber}"
                                    BorderBrush="{StaticResource Amber}" BorderThickness="1" Opacity="0" />
                            <Border x:Name="boxHover" CornerRadius="3" BorderBrush="{StaticResource Amber60}"
                                    BorderThickness="1" Opacity="0" />
                            <Path x:Name="check" Data="M 2.5 7 L 5.5 10 L 11 3.5" Stroke="{StaticResource PrimaryInk}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="checkSc" CenterX="7" CenterY="7" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ContentPresenter x:Name="cp" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Setter 兜底静态态（装载时已勾选的框不能只靠 EnterActions），
                             动画走显式 From/To，所以兜底值不会把淡入吃掉 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="boxOn" Property="Opacity" Value="1" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="check" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="boxOn" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="check" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="checkSc" Storyboard.TargetProperty="ScaleX"
                                                         From="0.8" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="checkSc" Storyboard.TargetProperty="ScaleY"
                                                         From="0.8" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="boxOn" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="check" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="boxHover" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="boxHover" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .switch：30×17 胶囊开关（用法：<ToggleButton Style="{StaticResource Switch}" />） -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="tr" CornerRadius="9" Background="{StaticResource Line2}" />
                        <Border x:Name="trOn" CornerRadius="9" Background="{StaticResource Amber25}" Opacity="0" />
                        <!-- 滑块位置仍由 HorizontalAlignment 决定（静态态一定正确），动画只做「追赶」：
                             勾选时布局已瞬移到右侧，再把位移从 -13 推回 0，视觉上就是滑过去的；
                             取消时布局瞬移回左侧，位移从 +13 推回 0。位移 13 = 30 宽 − 13 滑块 − 2×2 边距 -->
                        <Grid x:Name="knobWrap" Width="13" Height="13" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Margin="2,0,2,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="knobShift" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="knobOff" Fill="#FF7A7680" />
                            <Ellipse x:Name="knobOn" Fill="{StaticResource Amber}" Opacity="0" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Setter 兜底静态态，动画显式 From/To（与页签下划线同一套路） -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="trOn" Property="Opacity" Value="1" />
                            <Setter TargetName="knobOn" Property="Opacity" Value="1" />
                            <Setter TargetName="knobWrap" Property="HorizontalAlignment" Value="Right" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="trOn" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="knobOn" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="knobShift" Storyboard.TargetProperty="X"
                                                         From="-13" To="0" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="trOn" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="knobOn" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="knobShift" Storyboard.TargetProperty="X"
                                                         From="13" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 进度：.progress（h6 圆角槽 + cyan→amber 渐变条） -->
    <Style x:Key="ProgTrack" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{StaticResource Raised2}" />
    </Style>

    <!-- ============================================================
         滚动条：宽 10，滑块 line 色，槽透明
         ============================================================ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Margin="2">
                        <Border x:Name="bd" Background="{StaticResource LineBrush}" CornerRadius="5" />
                        <Border x:Name="hv" Background="{StaticResource Line2}" CornerRadius="5" Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter Property="MinHeight" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTip：暗色气泡 -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line2}"
                            BorderThickness="1" CornerRadius="6" Padding="8,5" MaxWidth="420">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="2" Opacity="0.5" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 参数滑块（暗色轨道 + Amber 进度/拇指，对位旧版 range 观感）：
         界面里两处用（特效面板的 fx 参数行、音频效果弹窗的参数行/变速行），放主题级共用 -->
    <Style x:Key="FxSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="SmallChange" Value="0.01" />
        <Setter Property="LargeChange" Value="0.1" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2,0,0,2" Background="{StaticResource Amber}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="0,2,2,0" Background="{StaticResource Raised2}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="thumb" Width="12" Height="12" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="dot" Fill="{StaticResource Amber}" Stroke="{StaticResource Ink}" StrokeThickness="1">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="dotSc" CenterX="6" CenterY="6" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="dotSc" Storyboard.TargetProperty="ScaleX"
                                                                                 From="1" To="1.15" Duration="{x:Static app:JzAnim.Fast}"
                                                                                 EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                                                <DoubleAnimation Storyboard.TargetName="dotSc" Storyboard.TargetProperty="ScaleY"
                                                                                 From="1" To="1.15" Duration="{x:Static app:JzAnim.Fast}"
                                                                                 EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="dotSc" Storyboard.TargetProperty="ScaleX"
                                                                                 From="1.15" To="1" Duration="{x:Static app:JzAnim.Out}"
                                                                                 EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                                                <DoubleAnimation Storyboard.TargetName="dotSc" Storyboard.TargetProperty="ScaleY"
                                                                                 From="1.15" To="1" Duration="{x:Static app:JzAnim.Out}"
                                                                                 EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 歌单卡片歌单卡片/侧栏色块底（无封面时按歌单名稳定哈希取一档暗色渐变；云面板与播放器侧栏共用） -->
    <LinearGradientBrush x:Key="Tile1" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3B2E4E" Offset="0" />
        <GradientStop Color="#FF221C2C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile2" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF24405C" Offset="0" />
        <GradientStop Color="#FF181F2B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile3" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4A3620" Offset="0" />
        <GradientStop Color="#FF241C15" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile4" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1F4438" Offset="0" />
        <GradientStop Color="#FF15241F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile5" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4A2434" Offset="0" />
        <GradientStop Color="#FF25171E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile6" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2A3350" Offset="0" />
        <GradientStop Color="#FF1A1D29" Offset="1" />
    </LinearGradientBrush>

    <!-- 行内播放键（默认显示序号，悬停或正在试听时换成播放/暂停图标，见 SongRowTpl 的触发器） -->
        <Style x:Key="RowPlayBtn" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    <!-- 标题栏的「编辑器 / 播放器」分段按钮（Tag="on" 为选中态；照抄云面板 PaneBtn 的选中视觉） -->
    <Style x:Key="SegBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Mut}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverWhite5}" />
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Amber10}" />
                            <Setter Property="Foreground" Value="{StaticResource Amber}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 通用几何图标（16 视图框，stroke 1.4 currentColor） -->
    <Geometry x:Key="IconLockPath">M5 7V5a3 3 0 0 1 6 0v2</Geometry>
    <Geometry x:Key="IconLockBody">M3 7h10v7H3z</Geometry>
    <Geometry x:Key="IconEditPath">M3 13l1-3.5L11 2.5l2.5 2.5L6.5 12z</Geometry>
    <Geometry x:Key="IconEditLine">M9.5 4l2.5 2.5</Geometry>
    <Geometry x:Key="IconTapOuter">M8 2.5a5.5 5.5 0 1 0 0 11a5.5 5.5 0 0 0 0-11z</Geometry>
    <Geometry x:Key="IconTapInner">M8 5.8a2.2 2.2 0 1 0 0 4.4a2.2 2.2 0 0 0 0-4.4z</Geometry>
    <Geometry x:Key="IconRangeEdge">M3 3v10M13 3v10</Geometry>
    <Geometry x:Key="IconRangeArrow">M5.5 8h5M8.5 5.5L11 8l-2.5 2.5</Geometry>

    <!-- 云试听播放条的媒体图标（实心填充，16 视图框）。用几何不用字体图标：
         pack 字体 URI 在本项目实测解析不到，Segoe Fluent Icons 也不允许随包分发 -->
    <Geometry x:Key="IconPlay">M4.5 2.6v10.8L13 8z</Geometry>
    <Geometry x:Key="IconPause">M4.2 2.8h2.8v10.4H4.2zM9 2.8h2.8v10.4H9z</Geometry>
    <Geometry x:Key="IconPrev">M4 2.8h1.7v10.4H4zM12.6 2.8v10.4L5.9 8z</Geometry>
    <Geometry x:Key="IconNext">M10.3 2.8H12v10.4h-1.7zM3.4 2.8v10.4L10.1 8z</Geometry>
    <Geometry x:Key="IconVolume">M3 6h2.4L8.6 3.4v9.2L5.4 10H3zM10.6 6.2a2.6 2.6 0 0 1 0 3.6</Geometry>
    <Geometry x:Key="IconVolumeMute">M3 6h2.4L8.6 3.4v9.2L5.4 10H3zM10.6 6.4l2.6 3.2M13.2 6.4l-2.6 3.2</Geometry>
</ResourceDictionary>
