    </Style>
    <Style x:Key="ChipT" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource Purple60}" />
    </Style>
    <Style x:Key="ChipB" TargetType="{x:Type ctl:JzChip}" BasedOn="{StaticResource {x:Type ctl:JzChip}}">
        <Setter Property="BorderBrush" Value="{StaticResource Green55}" />
