<UserControl x:Class="JizuraLive.App.PvStage.Panels.LeftPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="4,3,4,6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="2" Margin="3,0" VerticalAlignment="Bottom"
                                    CornerRadius="1" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Underline" Property="Background"
                                        Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Rows="1" Margin="12,8,12,4">
                        <RadioButton x:Name="NavMedia" Content="{DynamicResource Loc.PanelXaml.001}" Style="{StaticResource NavTab}"
                                     GroupName="NavTabs" IsChecked="True" Checked="Nav_Click" />
                        <RadioButton x:Name="NavStyle" Content="{DynamicResource Loc.PanelXaml.002}" Style="{StaticResource NavTab}"
                                     GroupName="NavTabs" Checked="Nav_Click" />
                        <RadioButton x:Name="NavTech" Content="{DynamicResource Loc.PanelXaml.003}" Style="{StaticResource NavTab}"
                                     GroupName="NavTabs" Checked="Nav_Click" />
                        <RadioButton x:Name="NavDirector" Content="{DynamicResource Loc.PanelXaml.004}" Style="{StaticResource NavTab}"
                                     GroupName="NavTabs" Checked="Nav_Click" />
                        <RadioButton x:Name="NavOutput" Content="{DynamicResource Loc.PanelXaml.005}" Style="{StaticResource NavTab}"
                                     GroupName="NavTabs" Checked="Nav_Click" />
                        <RadioButton x:Name="NavSettings" Content="{DynamicResource Loc.PanelXaml.006}" Style="{StaticResource NavTab}"
                                     GroupName="NavTabs" Checked="Nav_Click" />
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="PanelMedia" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.007}" Style="{StaticResource PanelCardTitle}" />
                                        <ui:Button x:Name="BtnCloudMusic" Content="{DynamicResource Loc.PanelXaml.008}" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Click="BtnCloudMusic_Click"
                                                   ToolTip="{DynamicResource Loc.PanelXaml.009}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Cloud24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <TextBlock x:Name="TblAudioName" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{DynamicResource Loc.PanelXaml.010}" />
                                        <TextBlock x:Name="TblAudioMeta" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.011}" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.012}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.013}" />
                                        <TextBlock x:Name="TblLyricInfo" Margin="0,8,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.014}" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.015}" Style="{StaticResource PanelCardTitle}" Margin="0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TblLayerCount" Margin="0,0,6,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <ui:Button x:Name="BtnAddLayer" Content="{DynamicResource Loc.PanelXaml.016}" Click="BtnAddLayer_Click"
                                                           ToolTip="{DynamicResource Loc.PanelXaml.017}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.018}" />
                                        <StackPanel x:Name="LayersHost" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelStyle" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.019}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock x:Name="TblThemeName" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.020}" />
                                        <WrapPanel x:Name="ThemeGrid" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.021}" Style="{StaticResource PanelCardTitle}" />
                                        <StackPanel x:Name="FxSliderHost" />
                                        <StackPanel x:Name="FxToggleHost" Margin="0,6,0,0" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.022}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbKoma" Grid.Column="1" HorizontalAlignment="Right"
                                                      Width="110" SelectionChanged="CmbKoma_SelectionChanged">
                                                <ComboBoxItem Tag="0" Content="{DynamicResource Loc.PanelXaml.023}" />
                                                <ComboBoxItem Tag="-2" Content="{DynamicResource Loc.PanelXaml.024}" />
                                                <ComboBoxItem Tag="-3" Content="{DynamicResource Loc.PanelXaml.025}" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="HUD" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbHud" Grid.Column="1" HorizontalAlignment="Right"
                                                      Width="110" SelectionChanged="CmbHud_SelectionChanged">
                                                <ComboBoxItem Tag="auto" Content="{DynamicResource Loc.PanelXaml.026}" />
                                                <ComboBoxItem Tag="on" Content="{DynamicResource Loc.PanelXaml.027}" />
                                                <ComboBoxItem Tag="off" Content="{DynamicResource Loc.PanelXaml.028}" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.029}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbKeyBg" Grid.Column="1" HorizontalAlignment="Right"
                                                      Width="110" SelectionChanged="CmbKeyBg_SelectionChanged">
                                                <ComboBoxItem Tag="off" Content="{DynamicResource Loc.PanelXaml.030}" />
                                                <ComboBoxItem Tag="black" Content="{DynamicResource Loc.PanelXaml.031}" />
                                                <ComboBoxItem Tag="green" Content="{DynamicResource Loc.PanelXaml.032}" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="画面后期" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                                   Text="按列表顺序叠加；目标可选全局或单个图层。点效果名在右侧改参数。" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbFxAdd" FontSize="12" />
                                            <ui:Button x:Name="BtnFxAdd" Grid.Column="1" Content="添加"
                                                       Margin="6,0,0,0" Click="BtnFxAdd_Click" />
                                        </Grid>
                                        <StackPanel x:Name="FxStackHost" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.033}" Style="{StaticResource PanelCardTitle}" />
                                        <StackPanel x:Name="StyleExtraHost" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.034}" Style="{StaticResource PanelCardTitle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtPresetSeed" FontSize="12" />
                                            <ui:Button x:Name="BtnReseedPreset" Grid.Column="1" Content="{DynamicResource Loc.PanelXaml.035}"
                                                       Margin="6,0,0,0" Click="BtnReseedPreset_Click" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelTech" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.036}" Style="{StaticResource PanelCardTitle}" />
                                        <StackPanel x:Name="TechPackHost" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.037}" Style="{StaticResource PanelCardTitle}" Margin="0" />
                                            <TextBlock x:Name="TblTechCount" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                        <ui:TextBox x:Name="TxtTechFilter" Margin="0,6,0,4" FontSize="12"
                                                    PlaceholderText="{DynamicResource Loc.PanelXaml.038}"
                                                    TextChanged="TxtTechFilter_TextChanged" />
                                        <StackPanel x:Name="TechHost" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelDirector" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.039}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.040}" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.041}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbAutoStyle" Grid.Column="1" Width="130"
                                                      HorizontalAlignment="Right" SelectedIndex="1"
                                                      SelectionChanged="CmbAutoStyle_SelectionChanged">
                                                <ComboBoxItem Tag="soft" Content="{DynamicResource Loc.PanelXaml.042}" />
                                                <ComboBoxItem Tag="dynamic" Content="{DynamicResource Loc.PanelXaml.043}" />
                                                <ComboBoxItem Tag="epic" Content="{DynamicResource Loc.PanelXaml.044}" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.045}" />
                                        <Grid Margin="0,10,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.046}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglStageCamera" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="StageToggles_Changed"
                                                             Unchecked="StageToggles_Changed" />
                                        </Grid>
                                        <Grid Margin="0,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.047}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglStageTransitions" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="StageToggles_Changed"
                                                             Unchecked="StageToggles_Changed" />
                                        </Grid>
                                        <Grid Margin="0,10,2,0">
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.048}" HorizontalAlignment="Left"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblAutoIntensity" Text="0.60" HorizontalAlignment="Right"
                                                       Style="{StaticResource PanelValue}" />
                                        </Grid>
                                        <Slider x:Name="SldAutoIntensity" Margin="0,4,0,0" IsMoveToPointEnabled="True"
                                                Minimum="0" Maximum="1" Value="0.6" SmallChange="0.05" LargeChange="0.1"
                                                ValueChanged="SldAutoIntensity_ValueChanged" />
                                        <ui:Button x:Name="BtnGenerateAuto" Content="{DynamicResource Loc.PanelXaml.049}" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                                   Click="BtnGenerateAuto_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Wand24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button x:Name="BtnRegenerateAuto" Content="{DynamicResource Loc.PanelXaml.050}"
                                                   HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                   Click="BtnRegenerateAuto_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <TextBlock x:Name="TblAutoHint" Margin="0,8,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.051}" />
                                        <TextBlock x:Name="TblAutoReport" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource PanelHint}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelOutput" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.052}" Style="{StaticResource PanelCardTitle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.053}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglBroadcast" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglBroadcast_Changed"
                                                             Unchecked="TglBroadcast_Changed" />
                                        </Grid>
                                        <Grid Margin="0,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.054}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglSpoutTransparent" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglSpoutTransparent_Changed"
                                                             Unchecked="TglSpoutTransparent_Changed" />
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.055}" />
                                        <TextBlock x:Name="TblBroadcastState" Margin="0,6,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.056}" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.057}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.058}" />

                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.059}" Margin="0,10,0,4" Style="{StaticResource PanelRowLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtExportPath" TextChanged="ExportField_TextChanged"
                                                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            <ui:Button x:Name="BtnExportBrowse" Grid.Column="1" Margin="6,0,0,0"
                                                       Content="{DynamicResource Loc.PanelXaml.060}" Click="BtnExportBrowse_Click" />
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.061}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtExportFps" Grid.Column="1" Width="70" Margin="8,0,0,0"
                                                        Text="60" />
                                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.PanelXaml.062}" Margin="12,0,8,0"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtExportSeconds" Grid.Column="3" Width="90"
                                                        TextChanged="ExportField_TextChanged" />
                                        </Grid>

                                        <CheckBox x:Name="ChkBurnSubtitles" Margin="0,12,0,0"
                                                  Content="{DynamicResource Loc.PanelXaml.063}" />
                                        <CheckBox x:Name="ChkVtsDrive" Margin="0,8,0,0"
                                                  Content="导出时驱动 VTS（实时，较慢）" />
                                        <CheckBox x:Name="ChkIncludeAudio" Margin="0,8,0,0" IsEnabled="False"
                                                  Content="{DynamicResource Loc.PanelXaml.064}" Click="ChkIncludeAudio_Click" />

                                        <ui:Button x:Name="BtnExport" Content="{DynamicResource Loc.PanelXaml.065}" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                                   Click="BtnExport_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowExport24" />
                                            </ui:Button.Icon>
                                        </ui:Button>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:ProgressRing x:Name="PrgExport" Width="22" Height="22" Visibility="Collapsed" />
                                            <TextBlock x:Name="TblExportState" Grid.Column="1" Margin="8,0,0,0"
                                                       Style="{StaticResource PanelHint}" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelSettings" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,18,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.066}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.067}" />
                                        <ComboBox x:Name="CmbCanvasPreset" Margin="0,10,0,0"
                                                  SelectionChanged="CmbCanvasPreset_SelectionChanged">
                                            <ComboBoxItem Tag="1920x1080" Content="1920 × 1080（16:9）" />
                                            <ComboBoxItem Tag="2560x1440" Content="2560 × 1440（16:9）" />
                                            <ComboBoxItem Tag="3840x2160" Content="3840 × 2160（4K）" />
                                            <ComboBoxItem Tag="1080x1920" Content="{DynamicResource Loc.PanelXaml.068}" />
                                            <ComboBoxItem Tag="1080x1080" Content="{DynamicResource Loc.PanelXaml.069}" />
                                            <ComboBoxItem Tag="custom" Content="{DynamicResource Loc.PanelXaml.070}" />
                                        </ComboBox>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.071}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasW" Grid.Column="1" Margin="8,0,0,0"
                                                        TextChanged="CanvasField_TextChanged" />
                                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.PanelXaml.072}" Margin="10,0,8,0"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasH" Grid.Column="3"
                                                        TextChanged="CanvasField_TextChanged" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.073}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasFps" Grid.Column="1" Width="90"
                                                        HorizontalAlignment="Left" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock x:Name="TblCanvasState" Margin="0,8,0,0"
                                                   Style="{StaticResource PanelHint}" Text="" />
                                        <ui:Button x:Name="BtnApplyCanvas" Content="{DynamicResource Loc.PanelXaml.074}" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                                   Click="BtnApplyCanvas_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.075}" Style="{StaticResource PanelCardTitle}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GPU" Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblGpuName" Grid.Column="1" Margin="12,0,0,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.077}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbPvRender" Grid.Column="1" Width="170"
                                                      HorizontalAlignment="Right"
                                                      SelectionChanged="CmbPvRender_SelectionChanged">
                                                <ComboBoxItem Tag="1" Content="{DynamicResource Loc.PanelXaml.078}" />
                                                <ComboBoxItem Tag="0.75" Content="75%" />
                                                <ComboBoxItem Tag="0.6667" Content="{DynamicResource Loc.PanelXaml.079}" />
                                                <ComboBoxItem Tag="0.5" Content="50%" />
                                                <ComboBoxItem Tag="0.3333" Content="33.3%" />
                                                <ComboBoxItem Tag="0.25" Content="25%" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="{DynamicResource Loc.PanelXaml.080}" />
                                        <TextBlock x:Name="TblPvRender" Style="{StaticResource PanelHint}"
                                                   TextWrapping="Wrap" Text="" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.081}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglVSync" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglVSync_Changed"
                                                             Unchecked="TglVSync_Changed" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="合并原版图层" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglLegacyComposite" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglLegacyComposite_Changed"
                                                             Unchecked="TglLegacyComposite_Changed" />
                                        </Grid>
                                        <TextBlock x:Name="TblLegacyComposite" Style="{StaticResource PanelHint}"
                                                   TextWrapping="Wrap" Text="" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.082}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.083}" />
                                        <TextBlock x:Name="TblVtsState" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource PanelHint}" Text="{DynamicResource Loc.PanelXaml.084}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button x:Name="BtnVtsReconnect" Content="{DynamicResource Loc.PanelXaml.085}"
                                                       HorizontalAlignment="Stretch"
                                                       Click="BtnVtsReconnect_Click" />
                                            <ui:Button x:Name="BtnVtsAuth" Grid.Column="1" Content="{DynamicResource Loc.PanelXaml.086}"
                                                       Margin="6,0,0,0" Click="BtnVtsAuth_Click" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.PanelXaml.087}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.PanelXaml.088}" />
                                        <Grid Margin="0,10,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.089}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglCenterFree" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglCenterFree_Changed"
                                                             Unchecked="TglCenterFree_Changed" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.090}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbCenterZone" Grid.Column="1" Width="110"
                                                      HorizontalAlignment="Right" SelectedIndex="0"
                                                      SelectionChanged="CmbCenterZone_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource Loc.PanelXaml.091}" Tag="center" />
                                                <ComboBoxItem Content="{DynamicResource Loc.PanelXaml.092}" Tag="left" />
                                                <ComboBoxItem Content="{DynamicResource Loc.PanelXaml.093}" Tag="right" />
                                                <ComboBoxItem Content="{DynamicResource Loc.PanelXaml.094}" Tag="top" />
                                                <ComboBoxItem Content="{DynamicResource Loc.PanelXaml.095}" Tag="bottom" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource Loc.PanelXaml.096}" Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblCenterGap" HorizontalAlignment="Right"
                                                       Style="{StaticResource PanelValue}" Text="30%" />
                                        </Grid>
                                        <Slider x:Name="SldCenterGap" Margin="0,4,0,0" Minimum="10" Maximum="70"
                                                Value="30" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5"
                                                ValueChanged="SldCenterGap_ValueChanged" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="字幕" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                                   Text="多行歌词按第一行原文、后续行译文/罗马音筛选；单行时回退原文。" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="预览字幕" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglPreviewSubtitles" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglPreviewSubtitles_Changed"
                                                             Unchecked="TglPreviewSubtitles_Changed" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="字幕内容" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbSubContent" Grid.Column="1" Width="120"
                                                      HorizontalAlignment="Right"
                                                      SelectionChanged="CmbSubContent_SelectionChanged">
                                                <ComboBoxItem Content="关闭" Tag="off" />
                                                <ComboBoxItem Content="译文" Tag="trans" />
                                                <ComboBoxItem Content="罗马音" Tag="roma" />
                                                <ComboBoxItem Content="原文+译文" Tag="both" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="字幕位置" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbSubPos" Grid.Column="1" Width="120"
                                                      HorizontalAlignment="Right"
                                                      SelectionChanged="CmbSubPos_SelectionChanged">
                                                <ComboBoxItem Content="底部" Tag="bottom" />
                                                <ComboBoxItem Content="顶部" Tag="top" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
</UserControl>
