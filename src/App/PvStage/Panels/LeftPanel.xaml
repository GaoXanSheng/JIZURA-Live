<UserControl x:Class="JizuraLive.App.PvStage.Panels.LeftPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
             FontSize="12.5">
    <UserControl.Resources>
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" Background="Transparent" />
                            <ContentPresenter Margin="4,7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Line" Height="2" Margin="8,0" VerticalAlignment="Bottom"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter TargetName="Line" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <UniformGrid Rows="1" Margin="0">
                            <RadioButton x:Name="NavMedia" Content="{DynamicResource Loc.LeftPanel.NavMedia}" Style="{StaticResource NavTab}"
                                         GroupName="NavTabs" IsChecked="True" Checked="Nav_Click" />
                            <RadioButton x:Name="NavStyle" Content="{DynamicResource Loc.LeftPanel.NavStyle}" Style="{StaticResource NavTab}"
                                         GroupName="NavTabs" Checked="Nav_Click" />
                            <RadioButton x:Name="NavTech" Content="{DynamicResource Loc.LeftPanel.NavTech}" Style="{StaticResource NavTab}"
                                         GroupName="NavTabs" Checked="Nav_Click" />
                            <RadioButton x:Name="NavDirector" Content="{DynamicResource Loc.LeftPanel.NavDirector}" Style="{StaticResource NavTab}"
                                         GroupName="NavTabs" Checked="Nav_Click" />
                            <RadioButton x:Name="NavOutput" Content="{DynamicResource Loc.LeftPanel.NavOutput}" Style="{StaticResource NavTab}"
                                         GroupName="NavTabs" Checked="Nav_Click" />
                            <RadioButton x:Name="NavSettings" Content="{DynamicResource Loc.LeftPanel.NavSettings}" Style="{StaticResource NavTab}"
                                         GroupName="NavTabs" Checked="Nav_Click" />
                        </UniformGrid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="PanelMedia" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12">
                            <StackPanel>
                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.MusicTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <ui:Button x:Name="BtnCloudMusic" Content="{DynamicResource Loc.LeftPanel.CloudMusic}" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Click="BtnCloudMusic_Click"
                                                   ToolTip="{DynamicResource Loc.LeftPanel.CloudMusicTooltip}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Cloud24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button x:Name="BtnImportAudio" Content="导入本地音频…"
                                                   HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                                   Click="BtnImportAudio_Click"
                                                   ToolTip="选择 mp3 / wav / flac / ogg，或直接把文件拖进窗口" />
                                        <TextBlock x:Name="TblAudioName" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{DynamicResource Loc.LeftPanel.AudioEmpty}" />
                                        <TextBlock x:Name="TblAudioMeta" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.AudioEmptyHint}" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.LyricsTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.LyricsHint}" />
                                        <TextBlock x:Name="TblLyricInfo" Margin="0,8,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.LyricsEmpty}" />
                                        <ui:Button x:Name="BtnImportLyrics" Content="导入歌词文件…"
                                                   HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                   Click="BtnImportLyrics_Click"
                                                   ToolTip="选择 .lrc / .krc 文件" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.LayersTitle}" Style="{StaticResource PanelCardTitle}" Margin="0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TblLayerCount" Margin="0,0,6,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <ui:Button x:Name="BtnAddLayer" Content="{DynamicResource Loc.LeftPanel.AddLayer}" Click="BtnAddLayer_Click"
                                                           ToolTip="{DynamicResource Loc.LeftPanel.AddLayerTooltip}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.LayersHint}" />
                                        <StackPanel x:Name="LayersHost" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelStyle" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.ThemeTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock x:Name="TblThemeName" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.ThemeCurrent}" />
                                        <WrapPanel x:Name="ThemeGrid" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.ThemeFxTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <StackPanel x:Name="FxSliderHost" />
                                        <StackPanel x:Name="FxToggleHost" Margin="0,6,0,0" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="HUD" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbHud" Grid.Column="1" HorizontalAlignment="Right"
                                                      Width="110" SelectionChanged="CmbHud_SelectionChanged">
                                                <ComboBoxItem Tag="auto" Content="{DynamicResource Loc.LeftPanel.HudAuto}" />
                                                <ComboBoxItem Tag="on" Content="{DynamicResource Loc.LeftPanel.HudOn}" />
                                                <ComboBoxItem Tag="off" Content="{DynamicResource Loc.LeftPanel.HudOff}" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.KeyBackground}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbKeyBg" Grid.Column="1" HorizontalAlignment="Right"
                                                      Width="110" SelectionChanged="CmbKeyBg_SelectionChanged">
                                                <ComboBoxItem Tag="off" Content="{DynamicResource Loc.LeftPanel.KeyBackgroundNormal}" />
                                                <ComboBoxItem Tag="black" Content="{DynamicResource Loc.LeftPanel.KeyBackgroundBlack}" />
                                                <ComboBoxItem Tag="green" Content="{DynamicResource Loc.LeftPanel.KeyBackgroundGreen}" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.FontColorTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <StackPanel x:Name="StyleExtraHost" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.SeedTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                                   Text="同一种子得到同一套结果；换种子会得到另一套随机排版与装饰。" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtPresetSeed" FontSize="12" />
                                            <ui:Button x:Name="BtnReseedPreset" Grid.Column="1" Content="{DynamicResource Loc.LeftPanel.Reseed}"
                                                       Margin="6,0,0,0" Click="BtnReseedPreset_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelTech" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="已应用特效" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                                   Text="按列表顺序叠加；目标可选全局或单个图层。点名字在右侧改参数，▶ 定位到特效窗口预览。" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbFxAdd" FontSize="12" />
                                            <ui:Button x:Name="BtnFxAdd" Grid.Column="1" Content="添加"
                                                       Margin="6,0,0,0" Click="BtnFxAdd_Click" />
                                        </Grid>
                                        <StackPanel x:Name="FxStackHost" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.FxLibraryTitle}" Style="{StaticResource PanelCardTitle}" Margin="0" />
                                            <TextBlock x:Name="TblTechCount" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                        <ui:TextBox x:Name="TxtTechFilter" Margin="0,6,0,4" FontSize="12"
                                                    PlaceholderText="{DynamicResource Loc.LeftPanel.FxFilterPlaceholder}"
                                                    TextChanged="TxtTechFilter_TextChanged" />
                                        <StackPanel x:Name="TechHost" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.FxScopeTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                                   Text="勾选参与生成的效果包；关掉的效果在自动生成时不会被选中。" />
                                        <StackPanel x:Name="TechPackHost" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelDirector" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.AutoCameraTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.AutoCameraHint}" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.AutoStyleLabel}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbAutoStyle" Grid.Column="1" Width="130"
                                                      HorizontalAlignment="Right" SelectedIndex="1"
                                                      SelectionChanged="CmbAutoStyle_SelectionChanged">
                                                <ComboBoxItem Tag="soft" Content="{DynamicResource Loc.LeftPanel.StyleSoft}" />
                                                <ComboBoxItem Tag="dynamic" Content="{DynamicResource Loc.LeftPanel.StyleDynamic}" />
                                                <ComboBoxItem Tag="epic" Content="{DynamicResource Loc.LeftPanel.StyleEpic}" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,12,2,0">
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.AutoIntensity}" HorizontalAlignment="Left"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblAutoIntensity" Text="0.60" HorizontalAlignment="Right"
                                                       Style="{StaticResource PanelValue}" />
                                        </Grid>
                                        <Slider x:Name="SldAutoIntensity" Margin="0,4,0,0" IsMoveToPointEnabled="True"
                                                Minimum="0" Maximum="1" Value="0.6" SmallChange="0.05" LargeChange="0.1"
                                                ValueChanged="SldAutoIntensity_ValueChanged" />
                                        <ui:Button x:Name="BtnGenerateAuto" Content="{DynamicResource Loc.LeftPanel.Generate}" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Margin="0,16,0,0"
                                                   Click="BtnGenerateAuto_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Wand24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <TextBlock x:Name="TblAutoHint" Margin="0,10,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.GenerateLockedHint}" />
                                        <Expander Margin="0,10,0,0" IsExpanded="False"
                                                  Background="Transparent" BorderThickness="0"
                                                  Header="{DynamicResource Loc.LeftPanel.GenerationInfo}">
                                            <TextBlock x:Name="TblAutoReport" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Style="{StaticResource PanelHint}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="" />
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.StageOverlayTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.StageOverlayHint}" />
                                        <Grid Margin="0,12,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.StageCamera}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglStageCamera" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="StageToggles_Changed"
                                                             Unchecked="StageToggles_Changed" />
                                        </Grid>
                                        <Grid Margin="0,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.StageTransition}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglStageTransitions" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="StageToggles_Changed"
                                                             Unchecked="StageToggles_Changed" />
                                        </Grid>
                                        <Grid Margin="0,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="作用于角色图层" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglCameraAffectsCharacter" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="StageToggles_Changed"
                                                             Unchecked="StageToggles_Changed" />
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                                   Text="开启后 VTS 角色跟随整体运镜与摄像机切换，忽略角色自己的逐层运镜；默认角色固定在画面里。" />
                                        <Border Height="1" Margin="0,12,0,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.CameraSwitch}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbCamSwitch" Grid.Column="1" Width="130"
                                                      HorizontalAlignment="Right" SelectedIndex="0"
                                                      SelectionChanged="CmbCamSwitch_SelectionChanged">
                                                <ComboBoxItem Tag="cut" Content="{DynamicResource Loc.LeftPanel.CameraCut}" />
                                                <ComboBoxItem Tag="blend" Content="{DynamicResource Loc.LeftPanel.CameraBlendMode}" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,12,2,0">
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.CameraBlend}" HorizontalAlignment="Left"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblCamBlend" Text="0.22" HorizontalAlignment="Right"
                                                       Style="{StaticResource PanelValue}" />
                                        </Grid>
                                        <Slider x:Name="SldCamBlend" Margin="0,4,0,0" IsMoveToPointEnabled="True"
                                                Minimum="0.1" Maximum="0.8" Value="0.22" SmallChange="0.01" LargeChange="0.05"
                                                ValueChanged="SldCamBlend_ValueChanged" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource PanelHint}"
                                                   TextWrapping="Wrap"
                                                   Text="{DynamicResource Loc.LeftPanel.CameraBlendHint}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelOutput" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.SpoutTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.SpoutBroadcast}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglBroadcast" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglBroadcast_Changed"
                                                             Unchecked="TglBroadcast_Changed" />
                                        </Grid>
                                        <Grid Margin="0,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.SpoutTransparent}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglSpoutTransparent" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglSpoutTransparent_Changed"
                                                             Unchecked="TglSpoutTransparent_Changed" />
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.SpoutTransparentHint}" />
                                        <TextBlock x:Name="TblBroadcastState" Margin="0,6,0,0" Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.BroadcastOff}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelSettings" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.CanvasTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.CanvasHint}" />
                                        <ComboBox x:Name="CmbCanvasPreset" Margin="0,10,0,0"
                                                  SelectionChanged="CmbCanvasPreset_SelectionChanged">
                                            <ComboBoxItem Tag="1920x1080" Content="1920 × 1080（16:9）" />
                                            <ComboBoxItem Tag="2560x1440" Content="2560 × 1440（16:9）" />
                                            <ComboBoxItem Tag="3840x2160" Content="3840 × 2160（4K）" />
                                            <ComboBoxItem Tag="1080x1920" Content="{DynamicResource Loc.LeftPanel.CanvasPortrait}" />
                                            <ComboBoxItem Tag="1080x1080" Content="{DynamicResource Loc.LeftPanel.CanvasSquare}" />
                                            <ComboBoxItem Tag="custom" Content="{DynamicResource Loc.LeftPanel.CanvasCustom}" />
                                        </ComboBox>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.CanvasWidth}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasW" Grid.Column="1" Margin="8,0,0,0"
                                                        TextChanged="CanvasField_TextChanged" />
                                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.LeftPanel.CanvasHeight}" Margin="10,0,8,0"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasH" Grid.Column="3"
                                                        TextChanged="CanvasField_TextChanged" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.CanvasFps}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasFps" Grid.Column="1" Width="90"
                                                        HorizontalAlignment="Left" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock x:Name="TblCanvasState" Margin="0,8,0,0"
                                                   Style="{StaticResource PanelHint}" Text="" />
                                        <ui:Button x:Name="BtnApplyCanvas" Content="{DynamicResource Loc.LeftPanel.CanvasApply}" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                                   Click="BtnApplyCanvas_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.RenderTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GPU" Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblGpuName" Grid.Column="1" Margin="12,0,0,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.PvRenderResolution}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbPvRender" Grid.Column="1" Width="170"
                                                      HorizontalAlignment="Right"
                                                      SelectionChanged="CmbPvRender_SelectionChanged">
                                                <ComboBoxItem Tag="1" Content="{DynamicResource Loc.LeftPanel.PvRenderFull}" />
                                                <ComboBoxItem Tag="0.75" Content="75%" />
                                                <ComboBoxItem Tag="0.6667" Content="{DynamicResource Loc.LeftPanel.PvRenderDefault}" />
                                                <ComboBoxItem Tag="0.5" Content="50%" />
                                                <ComboBoxItem Tag="0.3333" Content="33.3%" />
                                                <ComboBoxItem Tag="0.25" Content="25%" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="{DynamicResource Loc.LeftPanel.PvRenderHint}" />
                                        <TextBlock x:Name="TblPvRender" Style="{StaticResource PanelHint}"
                                                   TextWrapping="Wrap" Text="" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.VSync}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglVSync" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglVSync_Changed"
                                                             Unchecked="TglVSync_Changed" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="合并原版图层" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglLegacyComposite" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglLegacyComposite_Changed"
                                                             Unchecked="TglLegacyComposite_Changed" />
                                        </Grid>
                                        <TextBlock x:Name="TblLegacyComposite" Style="{StaticResource PanelHint}"
                                                   TextWrapping="Wrap" Text="" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.VtsTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.VtsHint}" />
                                        <TextBlock x:Name="TblVtsState" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource PanelHint}" Text="{DynamicResource Loc.LeftPanel.VtsDisconnected}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button x:Name="BtnVtsReconnect" Content="{DynamicResource Loc.LeftPanel.VtsReconnect}"
                                                       HorizontalAlignment="Stretch"
                                                       Click="BtnVtsReconnect_Click" />
                                            <ui:Button x:Name="BtnVtsAuth" Grid.Column="1" Content="{DynamicResource Loc.LeftPanel.VtsAuthorize}"
                                                       Margin="6,0,0,0" Click="BtnVtsAuth_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.LeftPanel.SafeGapTitle}" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="{DynamicResource Loc.LeftPanel.SafeGapHint}" />
                                        <Grid Margin="0,10,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.SafeGapEnable}" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglCenterFree" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglCenterFree_Changed"
                                                             Unchecked="TglCenterFree_Changed" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.SafeGapPosition}" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbCenterZone" Grid.Column="1" Width="110"
                                                      HorizontalAlignment="Right" SelectedIndex="0"
                                                      SelectionChanged="CmbCenterZone_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource Loc.LeftPanel.SafeGapCenter}" Tag="center" />
                                                <ComboBoxItem Content="{DynamicResource Loc.LeftPanel.SafeGapLeft}" Tag="left" />
                                                <ComboBoxItem Content="{DynamicResource Loc.LeftPanel.SafeGapRight}" Tag="right" />
                                                <ComboBoxItem Content="{DynamicResource Loc.LeftPanel.SafeGapTop}" Tag="top" />
                                                <ComboBoxItem Content="{DynamicResource Loc.LeftPanel.SafeGapBottom}" Tag="bottom" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource Loc.LeftPanel.SafeGapRatio}" Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblCenterGap" HorizontalAlignment="Right"
                                                       Style="{StaticResource PanelValue}" Text="30%" />
                                        </Grid>
                                        <Slider x:Name="SldCenterGap" Margin="0,4,0,0" Minimum="10" Maximum="70"
                                                Value="30" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5"
                                                ValueChanged="SldCenterGap_ValueChanged" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="13,11" Margin="0,0,0,1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="字幕" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                                   Text="多行歌词按第一行原文、后续行译文/罗马音筛选；单行时回退原文。" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="预览字幕" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglPreviewSubtitles" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglPreviewSubtitles_Changed"
                                                             Unchecked="TglPreviewSubtitles_Changed" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="字幕内容" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbSubContent" Grid.Column="1" Width="120"
                                                      HorizontalAlignment="Right"
                                                      SelectionChanged="CmbSubContent_SelectionChanged">
                                                <ComboBoxItem Content="关闭" Tag="off" />
                                                <ComboBoxItem Content="译文" Tag="trans" />
                                                <ComboBoxItem Content="罗马音" Tag="roma" />
                                                <ComboBoxItem Content="原文+译文" Tag="both" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="字幕位置" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbSubPos" Grid.Column="1" Width="120"
                                                      HorizontalAlignment="Right"
                                                      SelectionChanged="CmbSubPos_SelectionChanged">
                                                <ComboBoxItem Content="底部" Tag="bottom" />
                                                <ComboBoxItem Content="顶部" Tag="top" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
</UserControl>
