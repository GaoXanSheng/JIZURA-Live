<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:app="clr-namespace:JizuraLive.App">

    <!-- ============================================================
         PV 工作台设计语言（P5）
         与旧编辑器主题（暗色 + 琥珀，自旧 Web 前端 Tailwind 逐值搬运）刻意区分：
         这里是**冷调近黑 + 靛蓝主色**——做视觉工作时长时间盯画面，冷调更不刺眼，
         且与 PV 画面里常见的暖色内容（人物肤色、暖光）形成中性衬底。
         令牌分四组：表面 / 线 / 文字 / 强调，外加排版尺度与圆角。

         本文件是唯一一份 token（Theme.xaml 的同名色值/字号/圆角只转发过来）。
         共用色值写成 *Color 再转成画刷：WPF 的资源项之间没法互相别名
         （<StaticResource> 不能作字典项，XAML 编译器直接报错），旧键名要复用同一个数
         只能转发 Color。
         ============================================================ -->

    <!-- 表面：从最深到最亮，层级靠明度差而不是描边堆叠 -->
    <SolidColorBrush x:Key="PvSunken" Color="#070709" />
    <Color x:Key="PvBgColor">#0A0A0D</Color>
    <SolidColorBrush x:Key="PvBg" Color="{StaticResource PvBgColor}" />
    <Color x:Key="PvPanelColor">#101015</Color>
    <SolidColorBrush x:Key="PvPanel" Color="{StaticResource PvPanelColor}" />
    <Color x:Key="PvRaisedColor">#17171E</Color>
    <SolidColorBrush x:Key="PvRaised" Color="{StaticResource PvRaisedColor}" />
    <Color x:Key="PvHoverColor">#1E1E27</Color>
    <SolidColorBrush x:Key="PvHover" Color="{StaticResource PvHoverColor}" />

    <!-- 线：默认几乎不可见，只在需要分层时才用 -->
    <SolidColorBrush x:Key="PvLineSoft" Color="#191920" />
    <Color x:Key="PvLineColor">#23232C</Color>
    <SolidColorBrush x:Key="PvLine" Color="{StaticResource PvLineColor}" />
    <Color x:Key="PvLineStrongColor">#31313C</Color>
    <SolidColorBrush x:Key="PvLineStrong" Color="{StaticResource PvLineStrongColor}" />

    <!-- 文字：三级明度，正文只用前两级 -->
    <Color x:Key="PvFgColor">#ECECF2</Color>
    <SolidColorBrush x:Key="PvFg" Color="{StaticResource PvFgColor}" />
    <Color x:Key="PvFgDimColor">#9A9AA8</Color>
    <SolidColorBrush x:Key="PvFgDim" Color="{StaticResource PvFgDimColor}" />
    <Color x:Key="PvFgFaintColor">#5E5E6C</Color>
    <SolidColorBrush x:Key="PvFgFaint" Color="{StaticResource PvFgFaintColor}" />

    <!-- 强调：靛蓝主色 + 青绿次色；仅用于交互态与关键数值 -->
    <Color x:Key="PvAccentColor">#5B8CFF</Color>
    <SolidColorBrush x:Key="PvAccent" Color="{StaticResource PvAccentColor}" />
    <SolidColorBrush x:Key="PvAccentSoft" Color="#2A3A66" />
    <Color x:Key="PvAccent2Color">#38E1C4</Color>
    <SolidColorBrush x:Key="PvAccent2" Color="{StaticResource PvAccent2Color}" />
    <Color x:Key="PvDangerColor">#FF5F6E</Color>
    <SolidColorBrush x:Key="PvDanger" Color="{StaticResource PvDangerColor}" />
    <SolidColorBrush x:Key="PvWarn" Color="#FFB347" />

    <!-- 舞台衬底：纯黑，让画面自己说话（不做任何渐变/纹理干扰判断） -->
    <SolidColorBrush x:Key="PvStageVoid" Color="#000000" />

    <!-- 排版尺度 -->
    <sys:Double x:Key="PvTextXs">11</sys:Double>
    <sys:Double x:Key="PvTextSm">12</sys:Double>
    <sys:Double x:Key="PvTextBase">13</sys:Double>
    <sys:Double x:Key="PvTextLg">15</sys:Double>
    <sys:Double x:Key="PvTextXl">19</sys:Double>

    <!-- 圆角 -->
    <CornerRadius x:Key="PvRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="PvRadius">6</CornerRadius>
    <CornerRadius x:Key="PvRadiusLg">10</CornerRadius>

    <FontFamily x:Key="PvFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="PvMono">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <!-- ================= 卡片 ================= -->
    <Style x:Key="PvCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PvRaised}" />
        <Setter Property="CornerRadius" Value="{StaticResource PvRadius}" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ================= 小标题 ================= -->
    <Style x:Key="PvSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PvFgFaint}" />
        <Setter Property="FontSize" Value="{StaticResource PvTextXs}" />
        <Setter Property="Margin" Value="2,10,0,6" />
    </Style>

    <Style x:Key="PvRowLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PvFgDim}" />
        <Setter Property="FontSize" Value="{StaticResource PvTextSm}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PvValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PvFg}" />
        <Setter Property="FontFamily" Value="{StaticResource PvMono}" />
        <Setter Property="FontSize" Value="{StaticResource PvTextXs}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ================= 幽灵按钮 =================
         共享画刷不能改色：hover 叠一层 PvHover 动 Opacity（110ms 进 / 130ms 出）。 -->
    <Style x:Key="PvBtnGhost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PvFgDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontSize" Value="{StaticResource PvTextSm}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="prs" />
                        </Grid.RenderTransform>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource PvRadiusSm}" />
                        <Border x:Name="hx" Background="{StaticResource PvHover}"
                                CornerRadius="{StaticResource PvRadiusSm}"
                                Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PvFg}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static app:JzAnim.Fast}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hx" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static app:JzAnim.Out}"
                                                         EasingFunction="{x:Static app:JzAnim.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="1" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="prs" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮：热区 28×28（图标本体给 Path，Data 取 Theme.xaml 里的 Icon* 几何资源） -->
    <Style x:Key="PvBtnIcon" TargetType="Button" BasedOn="{StaticResource PvBtnGhost}">
        <Setter Property="Foreground" Value="{StaticResource PvFg}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ================= 滑杆（效果参数的主力控件） =================
         已填充段用 Track 的 DecreaseRepeatButton 实现：它天然只占「滑块左侧」那块，
         所以不需要任何转换器去算宽度——这是 WPF 里做填充轨道最省事的办法。 -->
    <Style x:Key="PvSlider" TargetType="Slider">
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{StaticResource PvAccent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{StaticResource PvSunken}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="11" Height="11">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Width="11" Height="11" Fill="{StaticResource PvFg}" />
                                                <Ellipse Width="5" Height="5" Fill="{StaticResource PvPanel}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 分段按钮（工作区切换：Tag="on" 为选中态） =================
         旧主题的同名 SegBtn 用琥珀色，与 PvTokens 的靛蓝主色是两套色值，这里按 Pv* 重写一份。 -->
    <Style x:Key="PvSegBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PvFgDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="{StaticResource PvTextSm}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource PvRadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PvHover}" />
                            <Setter Property="Foreground" Value="{StaticResource PvFg}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PvAccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource PvFg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 开关 ================= -->
    <Style x:Key="PvSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Width="30" Height="16" CornerRadius="8"
                            Background="{StaticResource PvSunken}" BorderBrush="{StaticResource PvLine}"
                            BorderThickness="1">
                        <Ellipse x:Name="knob" Width="10" Height="10" Fill="{StaticResource PvFgFaint}"
                                 HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PvAccentSoft}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PvAccent}" />
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource PvAccent}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
