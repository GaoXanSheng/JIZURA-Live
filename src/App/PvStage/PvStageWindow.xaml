<ui:FluentWindow x:Class="JizuraLive.App.PvStage.PvStageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:gpu="clr-namespace:JizuraLive.Render.Gpu"
                 xmlns:panels="clr-namespace:JizuraLive.App.PvStage.Panels"
                 xmlns:tl="clr-namespace:JizuraLive.App.PvStage.Timeline"
                 Title="JIZURA Live PV"
                 Width="1600" Height="900" MinWidth="1280" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
                 TextOptions.TextFormattingMode="Ideal"
                 UseLayoutRounding="True"
                 AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <ui:FluentWindow.Resources>
        <ControlTemplate x:Key="CompactTopMenuHeader" TargetType="{x:Type MenuItem}">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="8,0" Margin="2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Control.Foreground}" />
                    <Popup x:Name="Popup" Grid.Row="1" AllowsTransparency="True" Focusable="False"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                           Placement="Bottom"
                           PopupAnimation="None" StaysOpen="False" VerticalOffset="1"
                           PlacementTarget="{Binding ElementName=Chrome}">
                        <Border Background="{DynamicResource FlyoutBackground}"
                                BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="0,4" Margin="0,4,0,0">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background"
                            Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Chrome" Property="Background"
                            Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Control.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="InspectorCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="InspectorSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InspectorSubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="240" />
            <RowDefinition Height="Auto" MinHeight="6" />
            <RowDefinition x:Name="TimelineRow" Height="300" MinHeight="80" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Title="JIZURA Live PV" Height="32" />

        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Menu x:Name="MainMenu" Padding="6,0" Height="26"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      FontSize="12.5" VerticalContentAlignment="Center">
                    <Menu.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Template" Value="{StaticResource CompactTopMenuHeader}" />
                        </Style>
                    </Menu.ItemContainerStyle>
            <MenuItem Header="文件">
                <MenuItem Header="新建项目" InputGestureText="Ctrl+N" Click="MenuNewProject_Click" />
                <MenuItem Header="打开项目…" InputGestureText="Ctrl+O" Click="MenuOpenProject_Click" />
                <MenuItem Header="保存" InputGestureText="Ctrl+S" Click="MenuSave_Click" />
                <MenuItem Header="另存为…" InputGestureText="Ctrl+Shift+S" Click="MenuSaveAs_Click" />
                <Separator />
                <MenuItem Header="导入音频…" InputGestureText="Ctrl+I" Click="MenuImportAudio_Click" />
                <MenuItem Header="导入歌词…" InputGestureText="Ctrl+L" Click="MenuImportLyrics_Click" />
                <MenuItem Header="导入图片…" Click="MenuImportImage_Click" />
                <MenuItem Header="云端音乐…" Click="MenuCloudMusic_Click" />
                <Separator />
                <MenuItem Header="退出" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="编辑">
                <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Click="MenuUndo_Click" />
                <MenuItem Header="重做" InputGestureText="Ctrl+Shift+Z" Click="MenuRedo_Click" />
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="显示 / 隐藏左栏" Click="MenuToggleLeftPanel_Click" />
                <MenuItem Header="显示 / 隐藏属性栏" Click="MenuToggleInspector_Click" />
                <MenuItem Header="显示 / 隐藏时间轴" Click="MenuToggleTimeline_Click" />
                <Separator />
                <MenuItem Header="时间轴：全部展开" Click="MenuExpandTimeline_Click" />
                <MenuItem Header="时间轴：全部折叠" Click="MenuCollapseTimeline_Click" />
                <MenuItem Header="时间轴：适配窗口" Click="MenuFitTimeline_Click" />
            </MenuItem>
            <MenuItem Header="窗口">
                <MenuItem Header="重置布局" Click="MenuResetLayout_Click" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="快捷键一览" Click="MenuShortcuts_Click" />
                <MenuItem Header="关于" Click="MenuAbout_Click" />
            </MenuItem>
                </Menu>
                <TextBlock x:Name="TblStatus" Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="{DynamicResource Loc.Stage.StatusInitializing}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="320" MinWidth="240" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="InspectorSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="InspectorColumn" Width="380" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <panels:LeftPanel x:Name="Left" Grid.Column="0" />

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <Border Margin="10,0,0,0" VerticalAlignment="Stretch"
                                BorderBrush="{DynamicResource AccentFillColorSecondaryBrush}" BorderThickness="0,0,0,2"
                                HorizontalAlignment="Left">
                            <TextBlock Text="预览" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock x:Name="TblCompInfo" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,12,0" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <Grid Background="Black">
                        <Grid x:Name="StageWorkspace">
                            <gpu:PresentHost x:Name="Stage" Margin="0" />
                        </Grid>
                    </Grid>
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnPrevFrame" Appearance="Transparent" Padding="5"
                                       Click="BtnPrevFrame_Click" ToolTip="上一帧（←）">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Previous24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button x:Name="BtnPlay" Appearance="Transparent" Click="BtnPlay_Click"
                                       ToolTip="{DynamicResource Loc.Stage.PlayPauseTooltip}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button x:Name="BtnNextFrame" Appearance="Transparent" Padding="5"
                                       Click="BtnNextFrame_Click" ToolTip="下一帧（→）">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Next24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock x:Name="TblTime" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="00:00.0 / 00:00.0" />
                        </StackPanel>

                        <Slider x:Name="SldTime" Grid.Column="1" Margin="16,0" IsMoveToPointEnabled="True"
                                Minimum="0" Maximum="1" ValueChanged="SldTime_ValueChanged" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <ui:Button x:Name="BtnMute" Appearance="Transparent" Padding="4"
                                       Click="BtnMute_Click" ToolTip="{DynamicResource Loc.Stage.MuteTooltip}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon x:Name="VolumeIcon" Symbol="Speaker224" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <Slider x:Name="SldVolume" Width="90" Margin="6,0,0,0"
                                    Minimum="0" Maximum="100" Value="80"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Loc.Stage.VolumeTooltip}" ValueChanged="SldVolume_ValueChanged" />
                            <TextBlock x:Name="TblVolume" Width="36" Margin="4,0,0,0" Text="80%"
                                       TextAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock x:Name="TblFps" Grid.Column="3" Margin="14,0,0,0" MinWidth="64"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="InspectorPane" Grid.Column="4" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Loc.Stage.PropertiesHeader}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                        <TextBlock x:Name="TblInspectorTitle" Grid.Column="1" Margin="12,0,0,0"
                                   HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ScrollViewer x:Name="InspectorScroll" Margin="10,0,8,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <StackPanel x:Name="InspectorStack" Margin="0,4,2,10" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Cursor="SizeWE" />
        </Grid>

        <GridSplitter x:Name="TimelineSplitter" Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS" />

        <Border Grid.Row="4" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="10,0,14,0" VerticalAlignment="Stretch"
                            BorderBrush="{DynamicResource AccentFillColorSecondaryBrush}" BorderThickness="0,0,0,2">
                        <TextBlock Text="时间轴" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>

                    <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="拖动片段改时间 · 拖动轨道底边改高度 · 右键更多操作 · Alt 临时关吸附" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <ui:Button x:Name="BtnTlSnap" Appearance="Primary" Content="吸附" Padding="7,3"
                                   Click="BtnTlSnap_Click" ToolTip="吸附开关（S）" />
                        <Border Width="1" Margin="6,7" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <ui:Button x:Name="BtnTlExpand" Appearance="Transparent" Padding="5"
                                   Click="BtnTlExpand_Click" ToolTip="展开全部属性">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ChevronDown24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="BtnTlCollapse" Appearance="Transparent" Padding="5"
                                   Click="BtnTlCollapse_Click" ToolTip="折叠全部属性">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ChevronUp24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <Border Width="1" Margin="6,7" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <ui:Button x:Name="BtnTlZoomOut" Appearance="Transparent" Padding="5"
                                   Click="BtnTlZoomOut_Click" ToolTip="缩小（-）">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Subtract24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <Slider x:Name="SldTlZoom" Width="110" Margin="4,0" Minimum="0" Maximum="100"
                                Value="0" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                ValueChanged="SldTlZoom_ValueChanged" />
                        <ui:Button x:Name="BtnTlZoomIn" Appearance="Transparent" Padding="5"
                                   Click="BtnTlZoomIn_Click" ToolTip="放大（+）">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="BtnTlFit" Appearance="Transparent" Content="适配" Padding="7,3"
                                   Click="BtnTlFit_Click" ToolTip="适配窗口（Shift+/）" />
                    </StackPanel>
                </Grid>

                <tl:TimelineView x:Name="TheTimeline" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
