<ui:FluentWindow x:Class="JizuraLive.App.PvStage.PvStageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:gpu="clr-namespace:JizuraLive.Render.Gpu"
                 xmlns:panels="clr-namespace:JizuraLive.App.PvStage.Panels"
                 xmlns:tl="clr-namespace:JizuraLive.App.PvStage.Timeline"
                 Title="JIZURA Live PV"
                 Width="1600" Height="900" MinWidth="1280" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
                 TextOptions.TextFormattingMode="Ideal"
                 UseLayoutRounding="True"
                 AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <ui:FluentWindow.Resources>
        <Style x:Key="InspectorTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ItemsPresenter Grid.Row="0" />
                            <ContentPresenter Grid.Row="1" Margin="0,6,0,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InspectorTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" Margin="0,0,0,2" CornerRadius="4" Background="Transparent" />
                            <ContentPresenter ContentSource="Header" Margin="9,5"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Line" Height="2" Margin="4,0" VerticalAlignment="Bottom"
                                    CornerRadius="1" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Line" Property="Background"
                                        Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="240" />
            <RowDefinition Height="Auto" MinHeight="6" />
            <RowDefinition x:Name="TimelineRow" Height="300" MinHeight="80" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="JIZURA Live PV" VerticalAlignment="Center" Height="48">
            <ui:TitleBar.TrailingContent>
                <TextBlock x:Name="TblProjectName" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="{DynamicResource Loc.StageXaml.001}" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button x:Name="BtnProjectMenu" Appearance="Transparent" Click="BtnProjectMenu_Click" Content="{DynamicResource Loc.StageXaml.002}"
                               ToolTip="{DynamicResource Loc.StageXaml.003}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Folder24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="BtnImportMenu" Appearance="Transparent" Click="BtnImportMenu_Click" Content="{DynamicResource Loc.StageXaml.004}"
                               ToolTip="{DynamicResource Loc.StageXaml.005}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowImport24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <ui:Button x:Name="BtnUndo" Appearance="Transparent" Click="BtnUndo_Click" Content="{DynamicResource Loc.StageXaml.006}"
                               ToolTip="{DynamicResource Loc.StageXaml.007}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="BtnRedo" Appearance="Transparent" Click="BtnRedo_Click" Content="{DynamicResource Loc.StageXaml.008}"
                               ToolTip="{DynamicResource Loc.StageXaml.009}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRedo24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <TextBlock x:Name="TblStatus" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                           FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="{DynamicResource Loc.StageXaml.010}" />

                <ui:Button x:Name="BtnInspector" Grid.Column="2" Appearance="Transparent" Content="{DynamicResource Loc.StageXaml.011}"
                           Click="BtnInspector_Click" ToolTip="{DynamicResource Loc.StageXaml.012}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Options24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <panels:LeftPanel x:Name="Left" Grid.Column="0" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Black">
                    <Grid x:Name="StageWorkspace">
                        <gpu:PresentHost x:Name="Stage" Margin="0" />
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnPlay" Appearance="Transparent" Click="BtnPlay_Click"
                                       ToolTip="{DynamicResource Loc.StageXaml.013}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock x:Name="TblTime" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="00:00.0 / 00:00.0" />
                        </StackPanel>

                        <Slider x:Name="SldTime" Grid.Column="1" Margin="16,0" IsMoveToPointEnabled="True"
                                Minimum="0" Maximum="1" ValueChanged="SldTime_ValueChanged" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <ui:Button x:Name="BtnMute" Appearance="Transparent" Padding="4"
                                       Click="BtnMute_Click" ToolTip="{DynamicResource Loc.StageXaml.014}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon x:Name="VolumeIcon" Symbol="Speaker224" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <Slider x:Name="SldVolume" Width="90" Margin="6,0,0,0"
                                    Minimum="0" Maximum="100" Value="80"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Loc.StageXaml.015}" ValueChanged="SldVolume_ValueChanged" />
                            <TextBlock x:Name="TblVolume" Width="36" Margin="4,0,0,0" Text="80%"
                                       TextAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock x:Name="TblFps" Grid.Column="3" Margin="14,0,0,0" MinWidth="64"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="InspectorPane" Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,4">
                        <TextBlock Text="{DynamicResource Loc.StageXaml.016}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                        <TextBlock x:Name="TblInspectorTitle" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid x:Name="InspectorHost" Margin="10,0,8,0" />
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS" />

        <tl:TimelineView x:Name="TheTimeline" Grid.Row="4" />
    </Grid>
</ui:FluentWindow>
