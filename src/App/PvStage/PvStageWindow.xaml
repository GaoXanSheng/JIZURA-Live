<Window x:Class="JizuraLive.App.PvStage.PvStageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gpu="clr-namespace:JizuraLive.Render.Gpu"
        Title="JIZURA PV 舞台"
        Width="1440" Height="880" MinWidth="1080" MinHeight="660"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PvBg}"
        FontFamily="{StaticResource PvFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PvTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 ============ -->
        <Border Grid.Row="0" Background="{StaticResource PvPanel}" MouseLeftButtonDown="TitleBar_Drag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <!-- 品牌块：一个小方块 + 名字，不用图标字体（与旧界面一致的做法） -->
                    <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource PvAccent}" />
                    <TextBlock Text="JIZURA" Margin="8,0,0,0" FontSize="{StaticResource PvTextBase}"
                               Foreground="{StaticResource PvFg}" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Text="PV 舞台" Margin="6,0,0,0" FontSize="{StaticResource PvTextBase}"
                               Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TblStatus" Grid.Column="1" Margin="18,0"
                           FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextXs}"
                           Foreground="{StaticResource PvFgFaint}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="初始化…" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnMin" Style="{StaticResource PvBtnGhost}" Click="BtnMin_Click" Padding="12,6">
                        <Path Data="M0,0 H10" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource PvBtnGhost}" Click="BtnMax_Click" Padding="12,6">
                        <Path Data="M0,0 H10 V10 H0 Z" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource PvBtnGhost}" Click="BtnClose_Click" Padding="12,6">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主体三栏 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" MinWidth="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="344" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 左：图层栈 -->
            <Border Grid.Column="0" Background="{StaticResource PvPanel}"
                    BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,10,0">
                        <TextBlock Text="图层" FontSize="{StaticResource PvTextXs}"
                                   Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock x:Name="TblLayerCount"
                                       FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextXs}"
                                       Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Button x:Name="BtnAddLayer" Style="{StaticResource PvBtnGhost}" Padding="7,1"
                                    Content="+ 源" ToolTip="添加一路 Spout 源图层"
                                    Click="BtnAddLayer_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Margin="14,4,12,8" TextWrapping="Wrap"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgFaint}"
                               Text="从上到下 = 从前往后，拖拽可改顺序。深度决定该层吃多少镜头位移。" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,8,10">
                        <StackPanel x:Name="LayersHost" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 中：舞台 -->
            <Grid Grid.Column="1" Background="{StaticResource PvStageVoid}">
                <gpu:PresentHost x:Name="Stage" Margin="0" />
                <TextBlock x:Name="TblStageHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{StaticResource PvTextSm}" Foreground="{StaticResource PvFgFaint}"
                           IsHitTestVisible="False" Text="舞台初始化中…" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                        Background="#99000000" CornerRadius="{StaticResource PvRadiusSm}" Padding="8,4"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="TblStageInfo" FontFamily="{StaticResource PvMono}"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgDim}" />
                </Border>
            </Grid>

            <!-- 右：效果架 -->
            <Border Grid.Column="2" Background="{StaticResource PvPanel}"
                    BorderBrush="{StaticResource PvLineSoft}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,6">
                        <TextBlock Text="效果" FontSize="{StaticResource PvTextXs}"
                                   Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbAddFx" Width="150" HorizontalAlignment="Right"
                                  SelectionChanged="CmbAddFx_SelectionChanged" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Margin="14,0,12,8" TextWrapping="Wrap"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgFaint}"
                               Text="按顺序自上而下叠加。控件由效果参数 schema 自动生成。" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,8,10">
                        <StackPanel x:Name="EffectsHost" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 取色弹窗：共享一个实例，点色块时定位过去（每个色块各建一个太浪费） -->
        <Popup x:Name="ColorPop" StaysOpen="False" AllowsTransparency="True" Placement="Mouse"
               HorizontalOffset="6" VerticalOffset="6">
            <Border Background="{StaticResource PvRaised}" BorderBrush="{StaticResource PvLineStrong}"
                    BorderThickness="1" CornerRadius="{StaticResource PvRadius}" Padding="10">
                <StackPanel Width="196">
                    <TextBlock x:Name="TblColorTarget" FontSize="{StaticResource PvTextXs}"
                               Foreground="{StaticResource PvFgFaint}" />
                    <TextBox x:Name="TxtHex" Margin="0,7,0,0" FontFamily="{StaticResource PvMono}"
                             FontSize="{StaticResource PvTextSm}" TextChanged="TxtHex_TextChanged" />
                    <ItemsControl x:Name="SwatchGrid" Margin="0,9,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============ 传输条 ============ -->
        <Border Grid.Row="2" Background="{StaticResource PvPanel}"
                BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenProject" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Content="打开工程" Click="BtnOpenProject_Click" />
                    <Button x:Name="BtnOpenAudio" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Content="打开音频" Click="BtnOpenAudio_Click" />
                    <Border Width="1" Height="16" Margin="8,0" Background="{StaticResource PvLine}" />
                    <Button x:Name="BtnPlay" Style="{StaticResource PvBtnGhost}" Click="BtnPlay_Click" Padding="10,6">
                        <Path x:Name="PlayIcon" Data="M0,0 L11,6 L0,12 Z" Fill="{StaticResource PvFg}" />
                    </Button>
                    <TextBlock x:Name="TblTime" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextSm}"
                               Foreground="{StaticResource PvFgDim}" Text="00:00.0 / 00:00.0" />
                </StackPanel>

                <Slider x:Name="SldTime" Grid.Column="1" Style="{StaticResource PvSlider}" Margin="16,0"
                        Minimum="0" Maximum="1" ValueChanged="SldTime_ValueChanged" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="预设" Style="{StaticResource PvRowLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbPreset" Width="140" SelectionChanged="CmbPreset_SelectionChanged" />
                    <TextBlock x:Name="TblFps" Margin="14,0,0,0" Style="{StaticResource PvValue}" MinWidth="64" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
