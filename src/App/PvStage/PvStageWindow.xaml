<ui:FluentWindow x:Class="JizuraLive.App.PvStage.PvStageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:gpu="clr-namespace:JizuraLive.Render.Gpu"
                 xmlns:panels="clr-namespace:JizuraLive.App.PvStage.Panels"
                 xmlns:tl="clr-namespace:JizuraLive.App.PvStage.Timeline"
                 Title="JIZURA Live PV"
                 Width="1600" Height="900" MinWidth="1280" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
                 TextOptions.TextFormattingMode="Ideal"
                 UseLayoutRounding="True"
                 AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <ui:FluentWindow.Resources>
        <Style x:Key="PanelCardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PanelHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PanelRowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="240" />
            <RowDefinition Height="Auto" MinHeight="6" />
            <RowDefinition x:Name="TimelineRow" Height="300" MinHeight="80" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="JIZURA Live PV" VerticalAlignment="Center" Height="48">
            <ui:TitleBar.TrailingContent>
                <TextBlock x:Name="TblProjectName" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="默认工程" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button x:Name="BtnNew" Appearance="Transparent" Click="BtnNewProject_Click" Content="新建"
                               ToolTip="新建工程：重置为默认工程（当前工程先备份为 .bak）">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DocumentAdd24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="BtnOpen" Appearance="Transparent" Click="BtnOpenProject_Click" Content="打开"
                               ToolTip="打开工程：装入一份 .jzpv（整份替换当前工作台）">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="BtnSave" Appearance="Transparent" Click="BtnSave_Click" Content="保存"
                               ToolTip="保存工程 (Ctrl+S)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <ui:Button x:Name="BtnUndo" Appearance="Transparent" Click="BtnUndo_Click" Content="撤销"
                               ToolTip="撤销 (Ctrl+Z)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="BtnRedo" Appearance="Transparent" Click="BtnRedo_Click" Content="重做"
                               ToolTip="重做 (Ctrl+Y)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRedo24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <TextBlock x:Name="TblStatus" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                           FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="初始化…" />

                <ui:Button x:Name="BtnInspector" Grid.Column="2" Appearance="Transparent" Content="属性栏"
                           Click="BtnInspector_Click" ToolTip="显示 / 隐藏右侧属性检查器">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Options24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <panels:LeftPanel x:Name="Left" Grid.Column="0" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Black">
                    <Grid x:Name="StageWorkspace">
                        <gpu:PresentHost x:Name="Stage" Margin="0" />
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnPlay" Appearance="Transparent" Click="BtnPlay_Click"
                                       ToolTip="播放 / 暂停 (Space)">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock x:Name="TblTime" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="00:00.0 / 00:00.0" />
                        </StackPanel>

                        <Slider x:Name="SldTime" Grid.Column="1" Margin="16,0" IsMoveToPointEnabled="True"
                                Minimum="0" Maximum="1" ValueChanged="SldTime_ValueChanged" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <ui:Button x:Name="BtnMute" Appearance="Transparent" Padding="4"
                                       Click="BtnMute_Click" ToolTip="静音 / 取消静音">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon x:Name="VolumeIcon" Symbol="Speaker224" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <Slider x:Name="SldVolume" Width="90" Margin="6,0,0,0"
                                    Minimum="0" Maximum="100" Value="80"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    ToolTip="预览音量" ValueChanged="SldVolume_ValueChanged" />
                            <TextBlock x:Name="TblVolume" Width="36" Margin="4,0,0,0" Text="80%"
                                       TextAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock x:Name="TblFps" Grid.Column="3" Margin="14,0,0,0" MinWidth="64"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="InspectorPane" Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,4">
                        <TextBlock Text="属性" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                        <TextBlock x:Name="TblInspectorTitle" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,10">
                        <StackPanel x:Name="InspectorHost" Margin="14,0,12,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS" />

        <tl:TimelineView x:Name="TheTimeline" Grid.Row="4" />
        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="5" />
    </Grid>
</ui:FluentWindow>
