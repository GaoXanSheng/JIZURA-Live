<ui:FluentWindow x:Class="JizuraLive.App.PvStage.PvStageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:gpu="clr-namespace:JizuraLive.Render.Gpu"
                 xmlns:tl="clr-namespace:JizuraLive.App.PvStage.Timeline"
                 Title="JIZURA Live PV"
                 Width="1440" Height="880" MinWidth="1200" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
                 TextOptions.TextFormattingMode="Ideal"
                 UseLayoutRounding="True"
                 AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <ui:FluentWindow.Resources>
        <Style x:Key="PanelCardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PanelHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PanelRowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TimelineRow" Height="200" MinHeight="80" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="JIZURA Live PV">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Filmstrip24" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <TextBlock x:Name="TblProjectName" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="默认工程" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button x:Name="BtnNew" Appearance="Transparent" Click="BtnNewProject_Click" Content="新建"
                               ToolTip="新建工程：重置为默认工程（当前工程先备份为 .bak）">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DocumentAdd24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="BtnOpen" Appearance="Transparent" Click="BtnOpenProject_Click" Content="打开"
                               ToolTip="打开工程：装入一份 .jzpv（整份替换当前工作台）">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="BtnSave" Appearance="Transparent" Click="BtnSave_Click" Content="保存"
                               ToolTip="保存工程 (Ctrl+S)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <ui:Button x:Name="BtnUndo" Appearance="Transparent" Click="BtnUndo_Click" Content="撤销"
                               ToolTip="撤销 (Ctrl+Z)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="BtnRedo" Appearance="Transparent" Click="BtnRedo_Click" Content="重做"
                               ToolTip="重做 (Ctrl+Y)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRedo24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <TextBlock x:Name="TblStatus" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                           FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="初始化…" />

                <ui:Button x:Name="BtnInspector" Grid.Column="2" Appearance="Transparent" Content="属性栏"
                           Click="BtnInspector_Click" ToolTip="显示 / 隐藏右侧属性检查器">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Options24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,8">
                        <ui:Button x:Name="NavMedia" Content="素材" Appearance="Primary" Margin="0,0,6,0" Click="Nav_Click" />
                        <ui:Button x:Name="NavDirector" Content="导演" Appearance="Transparent" Margin="0,0,6,0" Click="Nav_Click" />
                        <ui:Button x:Name="NavOutput" Content="输出" Appearance="Transparent" Margin="0,0,6,0" Click="Nav_Click" />
                        <ui:Button x:Name="NavSettings" Content="设置" Appearance="Transparent" Click="Nav_Click" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="PanelMedia" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="音乐" Style="{StaticResource PanelCardTitle}" />
                                        <ui:Button x:Name="BtnOpenAudio" Content="导入音乐" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Click="BtnOpenAudio_Click"
                                                   ToolTip="同名 .lrc 会自动一起装载；也可以把 .lrc/.krc 文件直接拖进窗口">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="MusicNote224" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <TextBlock x:Name="TblAudioName" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="未导入音乐" />
                                        <TextBlock x:Name="TblAudioMeta" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource PanelHint}"
                                                   Text="拖入音频文件即可开始" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="歌词" Style="{StaticResource PanelCardTitle}" />
                                        <ui:Button x:Name="BtnOpenLyrics" Content="导入歌词 (.lrc/.krc)"
                                                   HorizontalAlignment="Stretch" Click="BtnOpenLyrics_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="TextFont24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <TextBlock x:Name="TblLyricInfo" Margin="0,8,0,0" Style="{StaticResource PanelHint}"
                                                   Text="未装载歌词" />
                                        <TextBlock Text="歌词样式" Margin="0,10,0,4" Style="{StaticResource PanelRowLabel}" />
                                        <ComboBox x:Name="CmbLyricStyle" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="图层" Style="{StaticResource PanelCardTitle}" Margin="0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TblLayerCount" Margin="0,0,6,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <ui:Button x:Name="BtnAddLayer" Content="+ 源" Click="BtnAddLayer_Click"
                                                           ToolTip="添加一路 Spout 源图层，或一层磁盘图片/视频（图片与视频不需要发送端）" />
                                                <ui:Button x:Name="BtnAddDecor" Content="+ 装饰" Margin="6,0,0,0"
                                                           Click="BtnAddDecor_Click"
                                                           ToolTip="添加一层氛围装饰：花瓣 / 紙吹雪 / 烟火 / 萤火 / 星空等，参数在右侧属性栏调" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource PanelHint}"
                                                   Text="从上到下 = 从前往后，拖拽可改顺序；点卡片在右侧编辑它。" />
                                        <StackPanel x:Name="LayersHost" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelDirector" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="一键成片" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="按原版引擎 Plan 的切点生成角色运动、整体运镜与整体转场；布局、文字处理仍由原版引擎负责。" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="风格" Style="{StaticResource PanelRowLabel}" />
                                            <ComboBox x:Name="CmbAutoStyle" Grid.Column="1" Width="130"
                                                      HorizontalAlignment="Right" SelectedIndex="1">
                                                <ComboBoxItem Tag="soft" Content="柔和" />
                                                <ComboBoxItem Tag="dynamic" Content="动感" />
                                                <ComboBoxItem Tag="epic" Content="史诗" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource PanelHint}"
                                                   Text="原版引擎负责布局、入退场、文字处理；整体运镜自动生成多机位切换，角色随画面整体移动，不再单独位移。" />
                                        <Grid Margin="0,10,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="整体运镜" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglStageCamera" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="StageToggles_Changed"
                                                             Unchecked="StageToggles_Changed" />
                                        </Grid>
                                        <Grid Margin="0,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="整体转场" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglStageTransitions" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="StageToggles_Changed"
                                                             Unchecked="StageToggles_Changed" />
                                        </Grid>
                                        <Grid Margin="0,10,2,0">
                                            <TextBlock Text="强度" HorizontalAlignment="Left"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblAutoIntensity" Text="0.60" HorizontalAlignment="Right"
                                                       Style="{StaticResource PanelValue}" />
                                        </Grid>
                                        <Slider x:Name="SldAutoIntensity" Margin="0,4,0,0" IsMoveToPointEnabled="True"
                                                Minimum="0" Maximum="1" Value="0.6" SmallChange="0.05" LargeChange="0.1"
                                                ValueChanged="SldAutoIntensity_ValueChanged" />
                                        <ui:Button x:Name="BtnGenerateAuto" Content="一键生成" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                                   Click="BtnGenerateAuto_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Wand24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button x:Name="BtnRegenerateAuto" Content="换一版"
                                                   HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                   Click="BtnRegenerateAuto_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <TextBlock x:Name="TblAutoHint" Margin="0,8,0,0" Style="{StaticResource PanelHint}"
                                                   Text="先导入音乐，生成才会解锁。" />
                                        <TextBlock x:Name="TblAutoReport" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource PanelHint}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelOutput" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="推流（Spout）" Style="{StaticResource PanelCardTitle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="广播到 Spout 发送端" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglBroadcast" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglBroadcast_Changed"
                                                             Unchecked="TglBroadcast_Changed" />
                                        </Grid>
                                        <TextBlock x:Name="TblBroadcastState" Margin="0,6,0,0" Style="{StaticResource PanelHint}"
                                                   Text="广播 关" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="导出视频" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="逐帧离屏渲染成片，导出期间界面照常用；含图层与效果、分镜与曲线驱动的镜头动画、动效歌词。" />

                                        <TextBlock Text="输出路径" Margin="0,10,0,4" Style="{StaticResource PanelRowLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtExportPath" TextChanged="ExportField_TextChanged" />
                                            <ui:Button x:Name="BtnExportBrowse" Grid.Column="1" Margin="6,0,0,0"
                                                       Content="浏览…" Click="BtnExportBrowse_Click" />
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="帧率" Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtExportFps" Grid.Column="1" Width="70" Margin="8,0,0,0"
                                                        Text="60" />
                                            <TextBlock Grid.Column="2" Text="时长(秒)" Margin="12,0,8,0"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtExportSeconds" Grid.Column="3" Width="90"
                                                        TextChanged="ExportField_TextChanged" />
                                        </Grid>

                                        <CheckBox x:Name="ChkBurnSubtitles" Margin="0,12,0,0"
                                                  Content="烧入清晰字幕（预览不显示字幕层）" />
                                        <CheckBox x:Name="ChkIncludeAudio" Margin="0,8,0,0" IsEnabled="False"
                                                  Content="包含音轨" Click="ChkIncludeAudio_Click" />

                                        <ui:Button x:Name="BtnExport" Content="开始导出" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                                   Click="BtnExport_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowExport24" />
                                            </ui:Button.Icon>
                                        </ui:Button>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:ProgressRing x:Name="PrgExport" Width="22" Height="22" Visibility="Collapsed" />
                                            <TextBlock x:Name="TblExportState" Grid.Column="1" Margin="8,0,0,0"
                                                       Style="{StaticResource PanelHint}" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PanelSettings" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,10,12"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="画布" Style="{StaticResource PanelCardTitle}" />
                                        <TextBlock Style="{StaticResource PanelHint}"
                                                   Text="画布决定预览、Spout 广播与导出的设计分辨率。宽高必须是 2 的倍数。" />
                                        <ComboBox x:Name="CmbCanvasPreset" Margin="0,10,0,0"
                                                  SelectionChanged="CmbCanvasPreset_SelectionChanged">
                                            <ComboBoxItem Tag="1920x1080" Content="1920 × 1080（16:9）" />
                                            <ComboBoxItem Tag="2560x1440" Content="2560 × 1440（16:9）" />
                                            <ComboBoxItem Tag="3840x2160" Content="3840 × 2160（4K）" />
                                            <ComboBoxItem Tag="1080x1920" Content="1080 × 1920（竖屏 9:16）" />
                                            <ComboBoxItem Tag="1080x1080" Content="1080 × 1080（方形 1:1）" />
                                            <ComboBoxItem Tag="custom" Content="自定义" />
                                        </ComboBox>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="宽" Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasW" Grid.Column="1" Margin="8,0,0,0"
                                                        TextChanged="CanvasField_TextChanged" />
                                            <TextBlock Grid.Column="2" Text="高" Margin="10,0,8,0"
                                                       Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasH" Grid.Column="3"
                                                        TextChanged="CanvasField_TextChanged" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="帧率" Style="{StaticResource PanelRowLabel}" />
                                            <ui:TextBox x:Name="TxtCanvasFps" Grid.Column="1" Width="90"
                                                        HorizontalAlignment="Left" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock x:Name="TblCanvasState" Margin="0,8,0,0"
                                                   Style="{StaticResource PanelHint}" Text="" />
                                        <ui:Button x:Name="BtnApplyCanvas" Content="应用画布" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                                   Click="BtnApplyCanvas_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="渲染" Style="{StaticResource PanelCardTitle}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GPU" Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblGpuName" Grid.Column="1" Margin="12,0,0,0"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="视频解码" Style="{StaticResource PanelRowLabel}" />
                                            <TextBlock x:Name="TblVideoDecode" Grid.Column="1" Margin="12,0,0,0"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="垂直同步" Style="{StaticResource PanelRowLabel}" />
                                            <ui:ToggleSwitch x:Name="TglVSync" Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             Checked="TglVSync_Changed"
                                                             Unchecked="TglVSync_Changed" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Black">
                    <Grid x:Name="StageWorkspace">
                        <gpu:PresentHost x:Name="Stage" Margin="0" />
                        <TextBlock x:Name="TblStageHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   IsHitTestVisible="False" Text="舞台初始化中…" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                                Background="#99000000" CornerRadius="4" Padding="8,4" IsHitTestVisible="False">
                            <TextBlock x:Name="TblStageInfo"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnPlay" Appearance="Transparent" Click="BtnPlay_Click"
                                       ToolTip="播放 / 暂停 (Space)">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock x:Name="TblTime" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="00:00.0 / 00:00.0" />
                        </StackPanel>

                        <Slider x:Name="SldTime" Grid.Column="1" Margin="16,0" IsMoveToPointEnabled="True"
                                Minimum="0" Maximum="1" ValueChanged="SldTime_ValueChanged" />

                        <TextBlock x:Name="TblFps" Grid.Column="2" Margin="14,0,0,0" MinWidth="64"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="InspectorPane" Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,4">
                        <TextBlock Text="属性" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                        <TextBlock x:Name="TblInspectorTitle" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,10">
                        <StackPanel x:Name="InspectorHost" Margin="14,0,12,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS" />

        <tl:TimelineView x:Name="TheTimeline" Grid.Row="4" />
    </Grid>
</ui:FluentWindow>
