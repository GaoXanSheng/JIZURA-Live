<Window x:Class="JizuraLive.App.PvStage.PvStageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gpu="clr-namespace:JizuraLive.Render.Gpu"
        xmlns:tl="clr-namespace:JizuraLive.App.PvStage.Timeline"
        xmlns:bp="clr-namespace:JizuraLive.App.PvStage.Blueprint"
        Title="JIZURA PV 舞台"
        Width="1440" Height="880" MinWidth="1200" MinHeight="720"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PvBg}"
        FontFamily="{StaticResource PvFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PvTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <!-- 时间轴：展开 220 / 折叠 40（折叠时只剩传输条） -->
            <RowDefinition x:Name="TimelineRow" Height="220" />
        </Grid.RowDefinitions>

        <!-- ============ 标题 / 工具栏 ============ -->
        <Border Grid.Row="0" Background="{StaticResource PvPanel}"
                BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_Drag">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌块：一个小方块 + 名字，不用图标字体（与旧界面一致的做法） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="{StaticResource PvRadiusSm}"
                            Background="{StaticResource PvAccent}" />
                    <TextBlock Text="JIZURA" Margin="8,0,0,0" FontSize="{StaticResource PvTextBase}"
                               Foreground="{StaticResource PvFg}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="PV 舞台" Margin="6,0,0,0" FontSize="{StaticResource PvTextBase}"
                               Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <!-- 工程组 -->
                    <Button x:Name="BtnNew" Style="{StaticResource PvBtnIcon}" Click="BtnNewProject_Click"
                            ToolTip="新建工程：重置为默认工程（当前工程先备份为 .bak）">
                        <Path Data="M3.8 2 H8.8 L11.6 4.8 V14 H3.8 Z M8.8 2 V4.8 H11.6"
                              Stroke="{StaticResource PvFgDim}" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="BtnOpen" Style="{StaticResource PvBtnIcon}" Click="BtnOpenProject_Click"
                            ToolTip="打开工程：装入一份 .jzpv（整份替换当前工作台）">
                        <Path Data="M2 5.6 H6 L7.4 7.4 H14 V12.8 H2 Z M2 5.6 V3.6 H5.4 L6.6 5.2"
                              Stroke="{StaticResource PvFgDim}" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="BtnSave" Style="{StaticResource PvBtnIcon}" Click="BtnSave_Click"
                            ToolTip="保存工程 (Ctrl+S)">
                        <Path Data="M3.2 2.8 H10.6 L13.2 5.4 V13.2 H3.2 Z M5.6 2.8 V6.4 H10 V2.8 M5.6 13.2 V9.6 H10.8 V13.2"
                              Stroke="{StaticResource PvFgDim}" StrokeThickness="1.4" />
                    </Button>
                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource PvLine}" />
                    <Button x:Name="BtnOpenLyrics" Style="{StaticResource PvBtnIcon}" Click="BtnOpenLyrics_Click"
                            ToolTip="打开歌词 (.lrc)">
                        <Path Data="M3 3.6 H13 V12.4 H3 Z M5.4 6.4 H10.6 M5.4 8.6 H9"
                              Stroke="{StaticResource PvFgDim}" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="BtnOpenAudio" Style="{StaticResource PvBtnIcon}" Click="BtnOpenAudio_Click"
                            ToolTip="打开音频（同名 .lrc 会自动一起装载）">
                        <Path Data="{StaticResource IconVolume}" Fill="{StaticResource PvFgDim}" />
                    </Button>
                    <Button x:Name="BtnExport" Style="{StaticResource PvBtnIcon}" Click="BtnExport_Click"
                            ToolTip="导出 MP4：逐帧离屏渲染成片（另建一条管线，不动舞台）">
                        <Path Data="M8 2.6 V10 M5.2 7.2 L8 10 L10.8 7.2 M3.2 12.8 H12.8"
                              Stroke="{StaticResource PvFgDim}" StrokeThickness="1.4" />
                    </Button>

                    <!-- 编辑组 -->
                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource PvLine}" />
                    <Button x:Name="BtnUndo" Style="{StaticResource PvBtnIcon}" Click="BtnUndo_Click"
                            ToolTip="撤销 (Ctrl+Z)">
                        <Path Data="M5.4 5 H9.2 A3.2 3.2 0 0 1 9.2 11.4 H4.4 M7.6 2.8 L5.4 5 L7.6 7.2"
                              Stroke="{StaticResource PvFgDim}" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource PvBtnIcon}" Click="BtnRedo_Click"
                            ToolTip="重做 (Ctrl+Y)">
                        <Path Data="M10.6 5 H6.8 A3.2 3.2 0 0 0 6.8 11.4 H11.6 M8.4 2.8 L10.6 5 L8.4 7.2"
                              Stroke="{StaticResource PvFgDim}" StrokeThickness="1.4" />
                    </Button>

                    <!-- 视图组：舞台 / 蓝图 切换 -->
                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource PvLine}" />
                    <Border Background="{StaticResource PvSunken}" CornerRadius="{StaticResource PvRadiusSm}"
                            Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnViewStage" Style="{StaticResource PvSegBtn}" Tag="on"
                                    Content="舞台" ToolTip="中央工作区：GPU 预览" Click="BtnViewStage_Click" />
                            <Button x:Name="BtnViewBlueprint" Style="{StaticResource PvSegBtn}"
                                    Content="蓝图" ToolTip="中央工作区：信号图节点画布"
                                    Click="BtnViewBlueprint_Click" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnFold" Style="{StaticResource PvBtnIcon}" Click="BtnFold_Click"
                            ToolTip="折叠时间轴">
                        <Path x:Name="FoldIcon" Data="M3.6 6.4 L8 10.8 L12.4 6.4"
                              Stroke="{StaticResource PvFgDim}" StrokeThickness="1.4" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TblStatus" Grid.Column="2" Margin="16,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextXs}"
                           Foreground="{StaticResource PvFgFaint}" TextTrimming="CharacterEllipsis"
                           Text="初始化…" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="BtnMin" Style="{StaticResource PvBtnIcon}" Click="BtnMin_Click"
                            ToolTip="最小化">
                        <Path Data="M0,0 H10" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource PvBtnIcon}" Click="BtnMax_Click"
                            ToolTip="最大化 / 还原">
                        <Path Data="M0,0 H10 V10 H0 Z" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource PvBtnIcon}" Click="BtnClose_Click"
                            ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主体三栏 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" MinWidth="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 左：图层栈 + 效果架 -->
            <Border Grid.Column="0" Background="{StaticResource PvPanel}"
                    BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,10,0">
                        <TextBlock Text="图层" FontSize="{StaticResource PvTextXs}"
                                   Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock x:Name="TblLayerCount"
                                       FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextXs}"
                                       Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Button x:Name="BtnAddLayer" Style="{StaticResource PvBtnGhost}" Padding="7,1"
                                    Content="+ 源" ToolTip="添加一路 Spout 源图层，或一层磁盘图片/视频（图片与视频不需要发送端）"
                                    Click="BtnAddLayer_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="14,4,12,8" TextWrapping="Wrap"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgFaint}"
                               Text="从上到下 = 从前往后，拖拽可改顺序。点卡片在右侧编辑它。" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,0,8,10">
                        <StackPanel x:Name="LayersHost" />
                    </ScrollViewer>

                    <Border Grid.Row="3" BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,1,0,0" />

                    <Grid Grid.Row="4" Margin="14,10,10,6">
                        <TextBlock Text="效果" FontSize="{StaticResource PvTextXs}"
                                   Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbAddFx" Width="150" HorizontalAlignment="Right"
                                  SelectionChanged="CmbAddFx_SelectionChanged" />
                    </Grid>

                    <TextBlock Grid.Row="5" Margin="14,0,12,8" TextWrapping="Wrap"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgFaint}"
                               Text="按顺序自上而下叠加。控件由效果参数 schema 自动生成。" />

                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Padding="10,0,8,10">
                        <StackPanel x:Name="EffectsHost" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 中：舞台 / 蓝图两个工作区。两块都留在树上，只切可见性——切回来时交换链、画布的缩放与选中都还在。
                 舞台必须先收起：它是 HwndHost 子窗口，WPF 元素盖不住它（airspace）。 -->
            <Grid Grid.Column="1" Background="{StaticResource PvStageVoid}">
                <Grid x:Name="StageWorkspace">
                    <gpu:PresentHost x:Name="Stage" Margin="0" />
                    <TextBlock x:Name="TblStageHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="{StaticResource PvTextSm}" Foreground="{StaticResource PvFgFaint}"
                               IsHitTestVisible="False" Text="舞台初始化中…" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                            Background="#99000000" CornerRadius="{StaticResource PvRadiusSm}" Padding="8,4"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="TblStageInfo" FontFamily="{StaticResource PvMono}"
                                   FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgDim}" />
                    </Border>
                </Grid>

                <bp:BlueprintView x:Name="BlueprintCanvas" Visibility="Collapsed" />
            </Grid>

            <!-- 右：属性检查器 -->
            <Border Grid.Column="2" Background="{StaticResource PvPanel}"
                    BorderBrush="{StaticResource PvLineSoft}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,4">
                        <TextBlock Text="属性" FontSize="{StaticResource PvTextXs}"
                                   Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TblInspectorTitle" HorizontalAlignment="Right"
                                   FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgDim}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,10">
                        <StackPanel x:Name="InspectorHost" Margin="14,0,12,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 底部：传输条 + 时间轴 ============ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PvPanel}"
                    BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPlay" Style="{StaticResource PvBtnIcon}" Click="BtnPlay_Click"
                                ToolTip="播放 / 暂停 (Space)">
                            <Path x:Name="PlayIcon" Data="{StaticResource IconPlay}"
                                  Fill="{StaticResource PvFg}" />
                        </Button>
                        <TextBlock x:Name="TblTime" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextSm}"
                                   Foreground="{StaticResource PvFgDim}" Text="00:00.0 / 00:00.0" />
                    </StackPanel>

                    <Slider x:Name="SldTime" Grid.Column="1" Style="{StaticResource PvSlider}" Margin="16,0"
                            Minimum="0" Maximum="1" ValueChanged="SldTime_ValueChanged" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnBroadcast" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                                Margin="0,0,8,0" Content="广播 关" Click="BtnBroadcast_Click" />
                        <Button x:Name="BtnVts" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                                Margin="0,0,14,0" Content="VTS 关" Click="BtnVts_Click" />
                        <TextBlock Text="预设" Style="{StaticResource PvRowLabel}" Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbPreset" Width="140" SelectionChanged="CmbPreset_SelectionChanged" />
                        <TextBlock x:Name="TblFps" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource PvValue}" MinWidth="64" />
                    </StackPanel>
                </Grid>
            </Border>

            <tl:TimelineView x:Name="TheTimeline" Grid.Row="1" />
        </Grid>

        <!-- 取色弹窗：共享一个实例，点色块时定位过去（每个色块各建一个太浪费） -->
        <Popup x:Name="ColorPop" StaysOpen="False" AllowsTransparency="True" Placement="Mouse"
               HorizontalOffset="6" VerticalOffset="6">
            <Border Background="{StaticResource PvRaised}" BorderBrush="{StaticResource PvLineStrong}"
                    BorderThickness="1" CornerRadius="{StaticResource PvRadius}" Padding="10">
                <StackPanel Width="196">
                    <TextBlock x:Name="TblColorTarget" FontSize="{StaticResource PvTextXs}"
                               Foreground="{StaticResource PvFgFaint}" />
                    <TextBox x:Name="TxtHex" Margin="0,7,0,0" FontFamily="{StaticResource PvMono}"
                             FontSize="{StaticResource PvTextSm}" TextChanged="TxtHex_TextChanged" />
                    <ItemsControl x:Name="SwatchGrid" Margin="0,9,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
