<Window x:Class="JizuraLive.App.PvStage.PvStageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gpu="clr-namespace:JizuraLive.Render.Gpu"
        Title="JIZURA PV 舞台"
        Width="1440" Height="880" MinWidth="1080" MinHeight="660"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PvBg}"
        FontFamily="{StaticResource PvFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PvTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <!-- 关键帧条：夹在舞台与传输条之间，给曲线一个不抢舞台高度、又始终在视野里的位置 -->
            <RowDefinition Height="34" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 ============ -->
        <Border Grid.Row="0" Background="{StaticResource PvPanel}" MouseLeftButtonDown="TitleBar_Drag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <!-- 品牌块：一个小方块 + 名字，不用图标字体（与旧界面一致的做法） -->
                    <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource PvAccent}" />
                    <TextBlock Text="JIZURA" Margin="8,0,0,0" FontSize="{StaticResource PvTextBase}"
                               Foreground="{StaticResource PvFg}" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Text="PV 舞台" Margin="6,0,0,0" FontSize="{StaticResource PvTextBase}"
                               Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TblStatus" Grid.Column="1" Margin="18,0"
                           FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextXs}"
                           Foreground="{StaticResource PvFgFaint}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="初始化…" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnMin" Style="{StaticResource PvBtnGhost}" Click="BtnMin_Click" Padding="12,6">
                        <Path Data="M0,0 H10" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource PvBtnGhost}" Click="BtnMax_Click" Padding="12,6">
                        <Path Data="M0,0 H10 V10 H0 Z" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource PvBtnGhost}" Click="BtnClose_Click" Padding="12,6">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource PvFgDim}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主体三栏 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" MinWidth="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="344" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 左：图层栈 -->
            <Border Grid.Column="0" Background="{StaticResource PvPanel}"
                    BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,10,0">
                        <TextBlock Text="图层" FontSize="{StaticResource PvTextXs}"
                                   Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock x:Name="TblLayerCount"
                                       FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextXs}"
                                       Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Button x:Name="BtnAddLayer" Style="{StaticResource PvBtnGhost}" Padding="7,1"
                                    Content="+ 源" ToolTip="添加一路 Spout 源图层，或一层磁盘图片（图片入口不需要发送端）"
                                    Click="BtnAddLayer_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Margin="14,4,12,8" TextWrapping="Wrap"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgFaint}"
                               Text="从上到下 = 从前往后，拖拽可改顺序。深度决定该层吃多少镜头位移。" />

                    <!-- 歌词轨放左栏底部而不是舞台下方：舞台高度是判断画面的依据，不该被一份常开的
                         文字列表长期挤占；歌词行也不必与时间轴同宽。声明在图层 ScrollViewer 之前，
                         否则它会顶掉后者 LastChildFill 的填充位。 -->
                    <Border DockPanel.Dock="Bottom" Height="208"
                            BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,10,10,6">
                                <TextBlock Text="歌词" FontSize="{StaticResource PvTextXs}"
                                           Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TblLyricCount" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextXs}"
                                           Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer x:Name="LyricScroll" VerticalScrollBarVisibility="Auto"
                                          Padding="10,0,8,10">
                                <StackPanel x:Name="LyricsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,8,10">
                        <StackPanel x:Name="LayersHost" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 中：舞台 -->
            <Grid Grid.Column="1" Background="{StaticResource PvStageVoid}">
                <gpu:PresentHost x:Name="Stage" Margin="0" />
                <TextBlock x:Name="TblStageHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{StaticResource PvTextSm}" Foreground="{StaticResource PvFgFaint}"
                           IsHitTestVisible="False" Text="舞台初始化中…" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                        Background="#99000000" CornerRadius="{StaticResource PvRadiusSm}" Padding="8,4"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="TblStageInfo" FontFamily="{StaticResource PvMono}"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgDim}" />
                </Border>
            </Grid>

            <!-- 右：效果架 -->
            <Border Grid.Column="2" Background="{StaticResource PvPanel}"
                    BorderBrush="{StaticResource PvLineSoft}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,6">
                        <TextBlock Text="效果" FontSize="{StaticResource PvTextXs}"
                                   Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbAddFx" Width="150" HorizontalAlignment="Right"
                                  SelectionChanged="CmbAddFx_SelectionChanged" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Margin="14,0,12,8" TextWrapping="Wrap"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgFaint}"
                               Text="按顺序自上而下叠加。控件由效果参数 schema 自动生成。" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,8,10">
                        <StackPanel x:Name="EffectsHost" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 关键帧条 ============ -->
        <!-- 曲线自己画在 Canvas 上而不引图表控件：一条曲线最多也就几百个 key，
             折线加圆点足够读，为它拖进一整套"坐标轴 / 光标 / 缩放"概念不划算。 -->
        <Border Grid.Row="2" Background="{StaticResource PvPanel}"
                BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="镜头缩放" Style="{StaticResource PvRowLabel}"
                           Margin="0,0,10,0" />

                <!-- Background 必须是实色笔刷（透明也算）：Canvas 没有笔刷就整块不参与命中测试，
                     点空白处 seek 会静默失效。 -->
                <Canvas x:Name="CurveStrip" Grid.Column="1" Height="30" ClipToBounds="True"
                        Background="Transparent"
                        SizeChanged="CurveStrip_SizeChanged"
                        MouseLeftButtonDown="CurveStrip_MouseLeftButtonDown" />
            </Grid>
        </Border>

        <!-- 取色弹窗：共享一个实例，点色块时定位过去（每个色块各建一个太浪费） -->
        <Popup x:Name="ColorPop" StaysOpen="False" AllowsTransparency="True" Placement="Mouse"
               HorizontalOffset="6" VerticalOffset="6">
            <Border Background="{StaticResource PvRaised}" BorderBrush="{StaticResource PvLineStrong}"
                    BorderThickness="1" CornerRadius="{StaticResource PvRadius}" Padding="10">
                <StackPanel Width="196">
                    <TextBlock x:Name="TblColorTarget" FontSize="{StaticResource PvTextXs}"
                               Foreground="{StaticResource PvFgFaint}" />
                    <TextBox x:Name="TxtHex" Margin="0,7,0,0" FontFamily="{StaticResource PvMono}"
                             FontSize="{StaticResource PvTextSm}" TextChanged="TxtHex_TextChanged" />
                    <ItemsControl x:Name="SwatchGrid" Margin="0,9,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============ 传输条 ============ -->
        <Border Grid.Row="3" Background="{StaticResource PvPanel}"
                BorderBrush="{StaticResource PvLineSoft}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 工程级动作放最前：它们换的是整份文档，与后面"打开歌词/音频"不是同一层级的事 -->
                    <Button x:Name="BtnNewProject" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Margin="0,0,6,0" Content="新建工程"
                            ToolTip="重置为默认工程（当前工程先备份为 .bak）"
                            Click="BtnNewProject_Click" />
                    <Button x:Name="BtnOpenProject" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Content="打开工程" ToolTip="打开一份 .jzpv（整份替换当前工作台）"
                            Click="BtnOpenProject_Click" />
                    <Border Width="1" Height="16" Margin="8,0" Background="{StaticResource PvLine}" />
                    <Button x:Name="BtnOpenLyrics" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Content="打开歌词" Click="BtnOpenLyrics_Click" />
                    <Button x:Name="BtnOpenAudio" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Content="打开音频" Click="BtnOpenAudio_Click" />
                    <Border Width="1" Height="16" Margin="8,0" Background="{StaticResource PvLine}" />
                    <Button x:Name="BtnPlay" Style="{StaticResource PvBtnGhost}" Click="BtnPlay_Click" Padding="10,6">
                        <Path x:Name="PlayIcon" Data="M0,0 L11,6 L0,12 Z" Fill="{StaticResource PvFg}" />
                    </Button>
                    <TextBlock x:Name="TblTime" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextSm}"
                               Foreground="{StaticResource PvFgDim}" Text="00:00.0 / 00:00.0" />
                </StackPanel>

                <Slider x:Name="SldTime" Grid.Column="1" Style="{StaticResource PvSlider}" Margin="16,0"
                        Minimum="0" Maximum="1" ValueChanged="SldTime_ValueChanged" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 缩放：没有曲线时它就是取景基础值（工程里存的那一个数）；有曲线时显示曲线在当前时刻的值。
                         装载期间设 Minimum 会把 Value 从 0 夹上来，那次回调（若事件已接上）由处理器里的守卫挡掉。 -->
                    <TextBlock Text="缩放" Style="{StaticResource PvRowLabel}" Margin="0,0,6,0" />
                    <Slider x:Name="SldCamScale" Style="{StaticResource PvSlider}" Width="90"
                            Minimum="0.5" Maximum="2" SmallChange="0.01" Value="1"
                            ValueChanged="SldCamScale_ValueChanged" />
                    <Button x:Name="BtnKeyCamera" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Margin="6,0,10,0" Content="◆K"
                            ToolTip="在当前时刻打一个镜头缩放关键帧（已存在则替换）"
                            Click="BtnKeyCamera_Click" />
                    <Button x:Name="BtnBroadcast" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Margin="0,0,8,0" Content="广播 关" Click="BtnBroadcast_Click" />
                    <Button x:Name="BtnVts" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Margin="0,0,14,0" Content="VTS 关" Click="BtnVts_Click" />
                    <Button x:Name="BtnSignal" Style="{StaticResource PvBtnGhost}" Padding="9,5"
                            Margin="0,0,14,0" Content="信号"
                            ToolTip="数值信号图：把时间/能量这类信号接到效果参数上（改动确认后才生效）"
                            Click="BtnSignal_Click" />
                    <TextBlock Text="预设" Style="{StaticResource PvRowLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbPreset" Width="140" SelectionChanged="CmbPreset_SelectionChanged" />
                    <TextBlock x:Name="TblFps" Margin="14,0,0,0" Style="{StaticResource PvValue}" MinWidth="64" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 信号面板（M6）：改的是一份草稿，确认才发布并落盘——直接改工程文档，会让"关掉弹窗"
             变成一次不可撤销的编辑（5 秒一次的自动存盘随后就把它写进磁盘）。
             声明位置在传输条之后：PlacementTarget 指向的按钮必须先存在于名字域里。 -->
        <Popup x:Name="SignalPop" StaysOpen="False" AllowsTransparency="True"
               Placement="Top" PlacementTarget="{Binding ElementName=BtnSignal}"
               HorizontalOffset="-90" VerticalOffset="-6">
            <Border Background="{StaticResource PvRaised}" BorderBrush="{StaticResource PvLineStrong}"
                    BorderThickness="1" CornerRadius="{StaticResource PvRadius}" Padding="10">
                <DockPanel Width="440">
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="信号图" FontSize="{StaticResource PvTextBase}"
                                   Foreground="{StaticResource PvFg}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TblSignalCount" HorizontalAlignment="Right"
                                   FontFamily="{StaticResource PvMono}" FontSize="{StaticResource PvTextXs}"
                                   Foreground="{StaticResource PvFgFaint}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,6" TextWrapping="Wrap"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgFaint}"
                               Text="按「输出 → 输入」连线，一个输入至多一条连线，一个参数至多一个输出绑定。关闭弹窗 = 放弃未确认的改动。" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BtnSignalTime" Style="{StaticResource PvBtnGhost}" Padding="7,3"
                                Content="+ 时间" Click="BtnSignalTime_Click" />
                        <Button x:Name="BtnSignalEnergy" Style="{StaticResource PvBtnGhost}" Padding="7,3"
                                Content="+ 能量" Click="BtnSignalEnergy_Click"
                                ToolTip="音频 / VTS 口型能量：本线只有这一个能量数（Stage.Energy）" />
                        <Button x:Name="BtnSignalRemap" Style="{StaticResource PvBtnGhost}" Padding="7,3"
                                Content="+ Remap" Click="BtnSignalRemap_Click" />
                        <Button x:Name="BtnSignalOutput" Style="{StaticResource PvBtnGhost}" Padding="7,3"
                                Content="+ 输出" Click="BtnSignalOutput_Click" />
                        <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource PvLine}" />
                        <Button x:Name="BtnSignalCommit" Style="{StaticResource PvBtnGhost}" Padding="9,3"
                                Content="确认并保存" Foreground="{StaticResource PvAccent}"
                                Click="BtnSignalCommit_Click" />
                    </StackPanel>

                    <TextBlock x:Name="TblSignalIssue" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxHeight="60"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvWarn}" />

                    <!-- 编译结论单独一行：编辑错误（我这次填的数不合法）与全图结论（环/悬空/重复写入）
                         是两条不同寿命的信息，挤在一行里后写的会抹掉先写的 -->
                    <TextBlock x:Name="TblSignalCompile" DockPanel.Dock="Bottom" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxHeight="60"
                               FontSize="{StaticResource PvTextXs}" Foreground="{StaticResource PvFgFaint}" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <ComboBox x:Name="CmbSignalFrom" Width="164" FontSize="{StaticResource PvTextXs}" />
                        <TextBlock Text="→" Style="{StaticResource PvRowLabel}" Margin="6,0" />
                        <ComboBox x:Name="CmbSignalTo" Width="164" FontSize="{StaticResource PvTextXs}" />
                        <Button x:Name="BtnSignalLink" Style="{StaticResource PvBtnGhost}" Padding="7,3"
                                Margin="6,0,0,0" Content="连边" Click="BtnSignalLink_Click" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360" Padding="0,2,2,2">
                        <StackPanel x:Name="SignalHost" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
