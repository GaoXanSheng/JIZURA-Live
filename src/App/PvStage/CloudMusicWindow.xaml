<Window x:Class="JizuraLive.App.PvStage.CloudMusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="云端音乐"
        Width="960" Height="620"
        MinWidth="840" MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="12" Background="#F21B1B20" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="20,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="云端音乐" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="搜索歌曲并导入音频与歌词" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="8" Background="#22FFFFFF" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnKugou" Content="酷狗音乐" Appearance="Primary" FontSize="12"
                                   Padding="14,5" Click="BtnSource_Click" Tag="kugou" />
                        <ui:Button x:Name="BtnNetease" Content="网易云音乐" Appearance="Transparent" FontSize="12"
                                   Padding="14,5" Click="BtnSource_Click" Tag="netease" />
                    </StackPanel>
                </Border>

                <ui:Button Grid.Column="3" Content="✕" Appearance="Transparent" FontSize="14"
                           Margin="0,0,12,0" VerticalAlignment="Center" Click="BtnClose_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,4,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" MinWidth="420" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" MinWidth="260" MaxWidth="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtKeyword" Height="34" VerticalContentAlignment="Center"
                                    PlaceholderText="输入歌名或歌手，回车搜索" KeyDown="TxtKeyword_KeyDown" />
                        <ui:Button x:Name="BtnSearch" Grid.Column="1" Content="搜索" Appearance="Primary"
                                   Margin="8,0,0,0" Height="34" Click="BtnSearch_Click" />
                        <ui:Button x:Name="BtnMore" Grid.Column="2" Content="更多" Margin="6,0,0,0"
                                   Height="34" Click="BtnMore_Click" />
                    </Grid>

                    <TextBlock x:Name="TblStatus" Grid.Row="1" Margin="2,10,0,8" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="输入歌名或歌手后搜索" />

                    <Border Grid.Row="2" CornerRadius="8" BorderThickness="1" Background="#14000000"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <ListBox x:Name="LstSongs" Background="Transparent" BorderThickness="0" Padding="4,4,18,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LstSongs_SelectionChanged"
                                 MouseDoubleClick="LstSongs_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="58" Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="5" Background="#22FFFFFF"
                                                ClipToBounds="True" VerticalAlignment="Center">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Length}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Border Grid.Column="2" CornerRadius="10" BorderThickness="1" Background="#14000000"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Width="180" Height="180" CornerRadius="8" Background="#22FFFFFF"
                                HorizontalAlignment="Center" ClipToBounds="True">
                            <Image x:Name="ImgCover" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock x:Name="TblName" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="选择一首歌" />
                            <TextBlock x:Name="TblSinger" FontSize="12" Margin="0,5,0,0" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="" />
                            <TextBlock x:Name="TblAlbum" FontSize="11" Margin="0,3,0,0" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="" />
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音质" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="CmbQuality" Grid.Column="1" Margin="10,0,0,0" Height="30"
                                      Width="120" HorizontalAlignment="Right">
                                <ComboBoxItem Content="128k" Tag="128" />
                                <ComboBoxItem Content="320k" Tag="320" IsSelected="True" />
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="TblDetailStatus" Grid.Row="4" Margin="0,10,0,0" FontSize="11"
                                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="双击列表中的歌曲也可以直接导入" />

                        <ui:Button x:Name="BtnImport" Grid.Row="5" Content="导入到工程" Appearance="Primary"
                                   Height="38" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                   Click="BtnImport_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
