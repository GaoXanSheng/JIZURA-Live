<UserControl x:Class="JizuraLive.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="450" Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="Background" Value="#FF2B2B33"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="#FF3C3C46" BorderThickness="1"/>
                            <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#FF2B2B33" BorderBrush="#FF3C3C46" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2B2B33"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="CaretBrush" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF3C3C46"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource PanelBg}"
            BorderBrush="#FF3C3C46" BorderThickness="1"
            CornerRadius="10" Padding="18,14,18,14">
        <StackPanel>
            <TextBlock Text="&#x2699; 设置" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource FgMain}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="输出分辨率" VerticalAlignment="Center"
                           Foreground="{StaticResource FgDim}" Width="110"/>
                <ComboBox x:Name="CmbRes" Width="230"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                <TextBlock Text="输出帧率" VerticalAlignment="Center"
                           Foreground="{StaticResource FgDim}" Width="110"/>
                <ComboBox x:Name="CmbFps" Width="120"/>
            </StackPanel>
            <CheckBox x:Name="ChkSpout" Content="Spout2 输出"/>
            <StackPanel Orientation="Horizontal" Margin="24,2,0,0">
                <TextBlock Text="通道：" VerticalAlignment="Center" Foreground="{StaticResource FgDim}"/>
                <TextBox x:Name="TxtSpoutName" Width="200"/>
            </StackPanel>
            <CheckBox x:Name="ChkSpoutTransparent" Content="透明背景（输出透明图层，重启镜像后生效）"/>
            <CheckBox x:Name="ChkCdp" Content="CDP 调试端口（重启后生效）"/>
            <StackPanel Orientation="Horizontal" Margin="24,2,0,0">
                <TextBlock Text="端口：" VerticalAlignment="Center" Foreground="{StaticResource FgDim}"/>
                <TextBox x:Name="TxtCdpPort" Width="100"/>
            </StackPanel>
            <Button x:Name="BtnRestartRender" Content="重启渲染引擎" Height="28"
                    Margin="0,10,0,0" Cursor="Hand"/>
        </StackPanel>
    </Border>
</UserControl>
