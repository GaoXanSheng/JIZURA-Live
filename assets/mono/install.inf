; Studio Cursor Mono cursor scheme, from Studio Cursor (https://studiocursor.com/cursors/mono/)
; License: CC0 1.0 Universal (public domain), https://creativecommons.org/publicdomain/zero/1.0/
;
; To install: right-click this file and choose Install
; (on Windows 11, choose "Show more options" first).
; Then open Settings > Bluetooth & devices > Mouse > Additional mouse settings,
; go to the Pointers tab, pick "Studio Cursor Mono" under Scheme, and press Apply.

[Version]
Signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",0x00020000,"%10%\%CUR_DIR%\%Arrow%,%10%\%CUR_DIR%\%Help%,%10%\%CUR_DIR%\%AppStarting%,%10%\%CUR_DIR%\%Wait%,%10%\%CUR_DIR%\%Crosshair%,%10%\%CUR_DIR%\%IBeam%,%10%\%CUR_DIR%\%NWPen%,%10%\%CUR_DIR%\%No%,%10%\%CUR_DIR%\%SizeNS%,%10%\%CUR_DIR%\%SizeWE%,%10%\%CUR_DIR%\%SizeNWSE%,%10%\%CUR_DIR%\%SizeNESW%,%10%\%CUR_DIR%\%SizeAll%,%10%\%CUR_DIR%\%UpArrow%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%Pin%,%10%\%CUR_DIR%\%Person%"

[Scheme.Cur]
arrow.cur
help.cur
appstarting.ani
wait.ani
crosshair.cur
ibeam.cur
nwpen.cur
no.cur
sizens.cur
sizewe.cur
sizenwse.cur
sizenesw.cur
sizeall.cur
uparrow.cur
hand.cur
pin.cur
person.cur

[Strings]
CUR_DIR     = "Cursors\Studio Cursor Mono"
SCHEME_NAME = "Studio Cursor Mono"
Arrow       = "arrow.cur"
Help        = "help.cur"
AppStarting = "appstarting.ani"
Wait        = "wait.ani"
Crosshair   = "crosshair.cur"
IBeam       = "ibeam.cur"
NWPen       = "nwpen.cur"
No          = "no.cur"
SizeNS      = "sizens.cur"
SizeWE      = "sizewe.cur"
SizeNWSE    = "sizenwse.cur"
SizeNESW    = "sizenesw.cur"
SizeAll     = "sizeall.cur"
UpArrow     = "uparrow.cur"
Hand        = "hand.cur"
Pin         = "pin.cur"
Person      = "person.cur"
